# Cloud connection is optional. Without all three values the node runs in local-only mode.
YANZI_CLOUD_BASE_URL=https://sync.example.com
YANZI_ACCOUNT_ID=replace-with-account-id
YANZI_DEVICE_TOKEN=replace-with-scoped-device-credential

YANZI_SERVER_DISPLAY_NAME=燕子云服务器
YANZI_SERVER_STATE_DIR=/var/lib/yanzi-server-node
YANZI_SERVER_WORKSPACE=/srv/yanzi-workspace
YANZI_SERVER_LOCAL_PORT=8789
YANZI_SERVER_HEARTBEAT_MS=60000
YANZI_SERVER_SYNC_MS=30000
