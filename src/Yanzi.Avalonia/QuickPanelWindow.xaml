<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yanzi.Avalonia"
        xmlns:shared="clr-namespace:Yanzi.Shared"
        x:Class="Yanzi.Avalonia.QuickPanelWindow"
        Title="鼠标面板"
        Width="1400"
        Height="1400"
        Opacity="0"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Focusable="True"
        Deactivated="Window_Deactivated"
        PointerPressed="Window_PointerPressed"
        PointerMoved="Window_PointerMoved"
        PointerReleased="Window_PointerReleased">

    <Canvas Width="{Binding OverlayWidth}"
            Height="{Binding OverlayHeight}"
            Background="Transparent"
            IsVisible="{Binding IsContentVisible}">
        
        <!-- Floating Card Panel (Matching reference screenshot exactly!) -->
        <Border Width="366" Height="580"
                Canvas.Left="{Binding PanelLeft}"
                Canvas.Top="{Binding PanelTop}"
                Background="#FF161616"
                CornerRadius="18"
                BorderBrush="#2CFFFFFF"
                BorderThickness="1.5"
                ClipToBounds="True">
            
            <Border.BoxShadow>
                <BoxShadows>0 12 40 0 #D0000000</BoxShadows>
            </Border.BoxShadow>

            <Grid ColumnDefinitions="46,*">
                <!-- Left Sidebar (Background #FF111111) -->
                <Border Grid.Column="0" Background="#FF111111" BorderBrush="#1CFFFFFF" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="*,Auto" Margin="0,14,0,12">
                        <!-- Upper Navigation Icons -->
                        <StackPanel Grid.Row="0" Spacing="16" HorizontalAlignment="Center">
                            <!-- Star 1 Category -->
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="⭐" Foreground="#FFFBBF24" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="默认" Foreground="#FF3B82F6" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center">
                                    <TextBlock Text="＋" Foreground="#44FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <Separator Height="1" Background="#18FFFFFF" Width="26" HorizontalAlignment="Center"/>

                            <!-- Star 2 Category -->
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="⭐" Foreground="#FFFBBF24" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="默认" Foreground="#FF10B981" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center">
                                    <TextBlock Text="＋" Foreground="#44FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Bottom Settings Gear -->
                        <Button Grid.Row="1" Width="28" Height="28" Background="Transparent" BorderThickness="0" CornerRadius="6" HorizontalAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                </Style>
                            </Button.Styles>
                            <Path Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.48,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.72,14.78 21.54,14.63L19.43,12.98Z M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5Z"
                                  Fill="#A0FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right Main Area -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,*,Auto">
                    <!-- Top Header Bar -->
                    <Grid Grid.Row="0" Height="46" ColumnDefinitions="*,Auto" Margin="14,4,14,0">
                        <!-- Category Name & Pin Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="默认" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Width="18" Height="18" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                <Path Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" Fill="#A0FFFFFF" Width="9" Height="9" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- Search pill shape box -->
                        <Border Grid.Column="1" Width="130" Height="24" CornerRadius="12" Background="#1DFFFFFF" Padding="10,0" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*">
                                <Path Grid.Column="0" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.3,20.41L13.03,15.14C11.9,16.1 10.42,16.7 8.5,16.7C3.8,16.7 0,12.9 0,8.2C0,3.5 3.8,0.2 8.5,0.2Z"
                                      Fill="#60FFFFFF" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="搜索..." Foreground="#60FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Global Slots Grid (3 rows x 4 cols = 12 slots) -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding GlobalSlots}" Margin="10,0,10,2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" Rows="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Name="SlotCard" Width="72" Height="72" Margin="3"
                                        Background="#0AFFFFFF" CornerRadius="12"
                                        BorderBrush="#10FFFFFF" BorderThickness="1.2"
                                        PointerPressed="Slot_PointerPressed"
                                        PointerEntered="Slot_PointerEntered"
                                        PointerExited="Slot_PointerExited"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.hovered="{Binding IsHovered}">
                                    <Border.Styles>
                                        <Style Selector="Border.selected">
                                            <Setter Property="Background" Value="#303B82F6"/>
                                            <Setter Property="BorderBrush" Value="#FF60A5FA"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </Style>
                                        <Style Selector="Border.hovered">
                                            <Setter Property="Background" Value="#18FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                            <Setter Property="BorderThickness" Value="1.2"/>
                                        </Style>
                                    </Border.Styles>
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                                    </Border.RenderTransform>

                                    <Grid>
                                        <!-- Empty Slot Icon -->
                                        <TextBlock Text="＋" Foreground="#28FFFFFF" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsEmpty}"/>

                                        <!-- Occupied Slot Content -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsNotEmpty}">
                                            <Border Width="38" Height="38" CornerRadius="9"
                                                    Background="#FF10B981" Margin="0,0,0,2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid>
                                                    <Path Data="{Binding VectorIcon}" Fill="White" Width="18" Height="18"
                                                          Stretch="Uniform" IsVisible="{Binding HasVectorIcon}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding IconSource}" Width="20" Height="20"
                                                           Stretch="Uniform" IsVisible="{Binding HasImageIcon}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayGlyph}" Foreground="White"
                                                               FontSize="12" FontWeight="SemiBold" IsVisible="{Binding UseGlyphIcon}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="9.5"
                                                       TextAlignment="Center" Width="68" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Section Separator Title -->
                    <TextBlock Grid.Row="2" Text="应用专属 • Yanzi"
                               Foreground="#88FFFFFF" FontSize="11" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,8,0,8"/>

                    <!-- Context Slots Grid (3 rows x 4 cols = 12 slots) -->
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding ContextSlots}" Margin="10,0,10,2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" Rows="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Name="SlotCard" Width="72" Height="72" Margin="3"
                                        Background="#0AFFFFFF" CornerRadius="12"
                                        BorderBrush="#10FFFFFF" BorderThickness="1.2"
                                        PointerPressed="Slot_PointerPressed"
                                        PointerEntered="Slot_PointerEntered"
                                        PointerExited="Slot_PointerExited"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.hovered="{Binding IsHovered}">
                                    <Border.Styles>
                                        <Style Selector="Border.selected">
                                            <Setter Property="Background" Value="#303B82F6"/>
                                            <Setter Property="BorderBrush" Value="#FF60A5FA"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </Style>
                                        <Style Selector="Border.hovered">
                                            <Setter Property="Background" Value="#18FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                            <Setter Property="BorderThickness" Value="1.2"/>
                                        </Style>
                                    </Border.Styles>
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                                    </Border.RenderTransform>

                                    <Grid>
                                        <!-- Empty Slot Icon -->
                                        <TextBlock Text="＋" Foreground="#28FFFFFF" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsEmpty}"/>

                                        <!-- Occupied Slot Content -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsNotEmpty}">
                                            <Border Width="38" Height="38" CornerRadius="9"
                                                    Background="#FF10B981" Margin="0,0,0,2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid>
                                                    <Path Data="{Binding VectorIcon}" Fill="White" Width="18" Height="18"
                                                          Stretch="Uniform" IsVisible="{Binding HasVectorIcon}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding IconSource}" Width="20" Height="20"
                                                           Stretch="Uniform" IsVisible="{Binding HasImageIcon}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayGlyph}" Foreground="White"
                                                               FontSize="12" FontWeight="SemiBold" IsVisible="{Binding UseGlyphIcon}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="9.5"
                                                       TextAlignment="Center" Width="68" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Footer prompt bar -->
                    <TextBlock Grid.Row="4" Text="{Binding ActiveTitle}"
                               Foreground="#FFAAAAAA" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Margin="14,4,14,8"/>
                </Grid>
            </Grid>
        </Border>
    </Canvas>
</Window>
