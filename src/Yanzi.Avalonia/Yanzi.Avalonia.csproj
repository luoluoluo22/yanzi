<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="**\*.xaml" />
    <AvaloniaResource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yanzi.Platform.Mac\Yanzi.Platform.Mac.csproj" />
    <ProjectReference Include="..\Yanzi.Shared\Yanzi.Shared.csproj" />
  </ItemGroup>

  <!-- macOS app icon and Info.plist -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="Info.plist" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\yanzi.icns" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
