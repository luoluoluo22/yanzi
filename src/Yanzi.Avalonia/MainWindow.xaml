<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yanzi.Avalonia"
        xmlns:shared="clr-namespace:Yanzi.Shared"
        x:Class="Yanzi.Avalonia.MainWindow"
        Title="Yanzi"
        Icon="avares://Yanzi.Avalonia/Assets/logo.png"
        Width="1400"
        Height="1400"
        Opacity="0"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsVisible="False"
        Topmost="True"
        Focusable="False"
        PointerPressed="Window_PointerPressed"
        PointerMoved="Window_PointerMoved"
        PointerReleased="Window_PointerReleased">
    
    <Canvas Width="{Binding OverlayWidth}"
            Height="{Binding OverlayHeight}"
            Background="Transparent"
            IsVisible="{Binding IsContentVisible}">
        <!-- Main Outer Ring -->
        <Ellipse Width="352" Height="352"
                 Canvas.Left="{Binding MainOuterEllipseX}"
                 Canvas.Top="{Binding MainOuterEllipseY}"
                 Fill="{DynamicResource BrushRadialOuterBG}"
                 Stroke="{DynamicResource BrushRadialBorder}"
                 StrokeThickness="1"/>

        <ItemsControl ItemsSource="{Binding OuterItems}"
                      Width="{Binding OverlayWidth}"
                      Height="{Binding OverlayHeight}"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path Data="{Binding SectorGeometry}"
                          Fill="{Binding SectorBrush}"
                          Opacity="{Binding SectorOpacity}"
                          IsVisible="{Binding IsSectorVisible}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Outer Separators -->
        <ItemsControl ItemsSource="{Binding OuterSeparators}"
                      Width="{Binding OverlayWidth}"
                      Height="{Binding OverlayHeight}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path Data="{Binding GeometryData}" 
                          Stroke="{DynamicResource BrushRadialBorderSec}" StrokeThickness="1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Inner Ring -->
        <Ellipse Width="220" Height="220"
                 Canvas.Left="{Binding MainInnerEllipseX}"
                 Canvas.Top="{Binding MainInnerEllipseY}"
                 Fill="{DynamicResource BrushRadialInnerBG}"
                 Stroke="{DynamicResource BrushRadialBorder}"
                 StrokeThickness="1"/>

        <ItemsControl ItemsSource="{Binding Items}"
                      Width="{Binding OverlayWidth}"
                      Height="{Binding OverlayHeight}"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path Data="{Binding SectorGeometry}"
                          Fill="{Binding SectorBrush}"
                          Opacity="{Binding SectorOpacity}"
                          IsVisible="{Binding IsSectorVisible}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Main Separators -->
        <ItemsControl ItemsSource="{Binding MainSeparators}"
                      Width="{Binding OverlayWidth}"
                      Height="{Binding OverlayHeight}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path Data="{Binding GeometryData}" 
                          Stroke="{DynamicResource BrushRadialBorderSec}" StrokeThickness="1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Center Circle -->
        <Ellipse Width="52" Height="52"
                 Canvas.Left="{Binding CenterCircleX}"
                 Canvas.Top="{Binding CenterCircleY}"
                 Fill="{DynamicResource BrushRadialCenterBG}"
                 Stroke="{DynamicResource BrushRadialBorderActive}"
                 StrokeThickness="1"/>

        <!-- Center Text -->
        <StackPanel Canvas.Left="{Binding CenterTextX}"
                    Canvas.Top="{Binding CenterTextY}"
                    Width="160">
            <TextBlock Text="{Binding CenterPrimaryText}"
                       Foreground="{DynamicResource BrushRadialText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Active Title -->
        <TextBlock Text="{Binding ActiveTitle}"
                   Foreground="{DynamicResource BrushRadialTextMuted}"
                   FontSize="11"
                   Width="220"
                   Canvas.Left="{Binding ActiveTitleX}"
                   Canvas.Top="{Binding ActiveTitleY}"
                   TextAlignment="Center"/>

        <!-- Outer Items -->
        <ItemsControl ItemsSource="{Binding OuterItems}"
                      Width="{Binding OverlayWidth}"
                      Height="{Binding OverlayHeight}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="50" Height="40"
                             Background="Transparent"
                             PointerPressed="RadialSlot_PointerPressed"
                             PointerEntered="RadialSlot_PointerEntered"
                             PointerExited="RadialSlot_PointerExited">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                        </Border.RenderTransform>
                        <Grid>
                            <!-- Empty Slot Hover Background -->
                            <Ellipse Width="32" Height="32" Fill="{DynamicResource BrushRadialSlotHover}"
                                     IsVisible="{Binding ShouldShowEmptyPlaceholder}"/>
                            
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Add Icon for Empty Slots -->
                                <TextBlock Text="➕" Foreground="{DynamicResource BrushRadialTextMuted}" FontSize="16"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding ShouldShowEmptyPlaceholder}"/>
                                
                                <!-- Normal Content -->
                                <Grid Width="22" Height="22" HorizontalAlignment="Center"
                                      IsVisible="{Binding IsNotEmpty}">
                                    <TextBlock Text="{Binding DisplayGlyph}" 
                                               Foreground="{DynamicResource BrushRadialText}" FontSize="11"
                                               IsVisible="{Binding !HasRealIcon}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding RealIcon}"
                                           IsVisible="{Binding HasRealIcon}"
                                           Width="20" Height="20"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}" 
                                           Foreground="{DynamicResource BrushRadialText}"
                                           FontSize="8" Width="44" TextAlignment="Center"
                                           Margin="0,4,0,0"
                                           IsVisible="{Binding IsNotEmpty}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Inner Items -->
        <ItemsControl ItemsSource="{Binding Items}"
                      Width="{Binding OverlayWidth}"
                      Height="{Binding OverlayHeight}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="64" Height="50"
                             Background="Transparent"
                             PointerPressed="RadialSlot_PointerPressed"
                             PointerEntered="RadialSlot_PointerEntered"
                             PointerExited="RadialSlot_PointerExited">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Ellipse Width="40" Height="40" Fill="{DynamicResource BrushRadialSlotHover}"
                                     IsVisible="{Binding ShouldShowEmptyPlaceholder}"/>
                            
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="➕" Foreground="{DynamicResource BrushRadialTextMuted}" FontSize="20"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding ShouldShowEmptyPlaceholder}"/>
                                
                                <Grid Width="28" Height="28" HorizontalAlignment="Center"
                                      IsVisible="{Binding IsNotEmpty}">
                                    <TextBlock Text="{Binding DisplayGlyph}" 
                                               Foreground="{DynamicResource BrushRadialText}" FontSize="14"
                                               IsVisible="{Binding !HasRealIcon}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding RealIcon}"
                                           IsVisible="{Binding HasRealIcon}"
                                           Width="26" Height="26"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}" 
                                           Foreground="{DynamicResource BrushRadialText}"
                                           FontSize="9" Width="50" TextAlignment="Center"
                                           Margin="0,4,0,0"
                                           IsVisible="{Binding IsNotEmpty}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Child Ring -->
        <Canvas IsVisible="{Binding HasChildRing}"
                Width="{Binding OverlayWidth}"
                Height="{Binding OverlayHeight}">
            <Ellipse Width="200" Height="200"
                     Canvas.Left="{Binding ChildRingEllipseX}"
                     Canvas.Top="{Binding ChildRingEllipseY}"
                     Fill="{DynamicResource BrushRadialOuterBG}"
                     Stroke="{DynamicResource BrushRadialBorderActive}"
                     StrokeThickness="1"/>
            <ItemsControl ItemsSource="{Binding ChildItems}"
                          Width="{Binding OverlayWidth}"
                          Height="{Binding OverlayHeight}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Data="{Binding SectorGeometry}"
                              Fill="{Binding SectorBrush}"
                              Opacity="{Binding SectorOpacity}"
                              IsVisible="{Binding IsSectorVisible}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Ellipse Width="52" Height="52"
                     Canvas.Left="{Binding ChildRingCenterEllipseX}"
                     Canvas.Top="{Binding ChildRingCenterEllipseY}"
                     Fill="{DynamicResource BrushRadialCenterBG}"
                     Stroke="{DynamicResource BrushRadialBorderActive}"
                     StrokeThickness="1"/>
            <TextBlock Text="{Binding ChildRingTitle}"
                       Canvas.Left="{Binding ChildRingTitleX}"
                       Canvas.Top="{Binding ChildRingTitleY}"
                       Width="150" TextAlignment="Center"
                       Foreground="{DynamicResource BrushRadialText}" FontSize="15" FontWeight="SemiBold"/>
            
            <ItemsControl ItemsSource="{Binding ChildItems}"
                          Width="{Binding OverlayWidth}"
                          Height="{Binding OverlayHeight}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="56" Height="44"
                                Background="Transparent"
                                PointerPressed="RadialSlot_PointerPressed"
                                PointerEntered="RadialSlot_PointerEntered"
                                PointerExited="RadialSlot_PointerExited">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Ellipse Width="36" Height="36" Fill="{DynamicResource BrushRadialSlotHover}"
                                         IsVisible="{Binding ShouldShowEmptyPlaceholder}"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="➕" Foreground="{DynamicResource BrushRadialTextMuted}" FontSize="18"
                                               HorizontalAlignment="Center"
                                               IsVisible="{Binding ShouldShowEmptyPlaceholder}"/>
                                    <Grid Width="24" Height="24" HorizontalAlignment="Center"
                                          IsVisible="{Binding IsNotEmpty}">
                                        <TextBlock Text="{Binding DisplayGlyph}" 
                                                   Foreground="{DynamicResource BrushRadialText}" FontSize="11"
                                                   IsVisible="{Binding !HasRealIcon}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding RealIcon}"
                                               IsVisible="{Binding HasRealIcon}"
                                               Width="22" Height="22"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" 
                                               Foreground="{DynamicResource BrushRadialText}"
                                               FontSize="8" Width="46" TextAlignment="Center"
                                               Margin="0,4,0,0"
                                               IsVisible="{Binding IsNotEmpty}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <Canvas IsVisible="{Binding HasGrandChildRing}"
                Width="{Binding OverlayWidth}"
                Height="{Binding OverlayHeight}">
            <Ellipse Width="160" Height="160"
                      Canvas.Left="{Binding GrandChildRingEllipseX}"
                      Canvas.Top="{Binding GrandChildRingEllipseY}"
                      Fill="{DynamicResource BrushRadialOuterBG}"
                      Stroke="{DynamicResource BrushRadialBorderActive}"
                      StrokeThickness="1"/>
            <ItemsControl ItemsSource="{Binding GrandChildItems}"
                          Width="{Binding OverlayWidth}"
                          Height="{Binding OverlayHeight}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Data="{Binding SectorGeometry}"
                              Fill="{Binding SectorBrush}"
                              Opacity="{Binding SectorOpacity}"
                              IsVisible="{Binding IsSectorVisible}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Ellipse Width="44" Height="44"
                      Canvas.Left="{Binding GrandChildRingCenterEllipseX}"
                      Canvas.Top="{Binding GrandChildRingCenterEllipseY}"
                      Fill="{DynamicResource BrushRadialCenterBG}"
                      Stroke="{DynamicResource BrushRadialBorderActive}"
                      StrokeThickness="1"/>
            <TextBlock Text="{Binding GrandChildRingTitle}"
                       Canvas.Left="{Binding GrandChildRingTitleX}"
                       Canvas.Top="{Binding GrandChildRingTitleY}"
                       Width="128" TextAlignment="Center"
                       Foreground="{DynamicResource BrushRadialText}" FontSize="13" FontWeight="SemiBold"/>

            <ItemsControl ItemsSource="{Binding GrandChildItems}"
                          Width="{Binding OverlayWidth}"
                          Height="{Binding OverlayHeight}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="50" Height="40"
                                Background="Transparent"
                                PointerPressed="RadialSlot_PointerPressed"
                                PointerEntered="RadialSlot_PointerEntered"
                                PointerExited="RadialSlot_PointerExited">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Ellipse Width="32" Height="32" Fill="{DynamicResource BrushRadialSlotHover}"
                                         IsVisible="{Binding ShouldShowEmptyPlaceholder}"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="➕" Foreground="{DynamicResource BrushRadialTextMuted}" FontSize="16"
                                               HorizontalAlignment="Center"
                                               IsVisible="{Binding ShouldShowEmptyPlaceholder}"/>
                                    <Grid Width="20" Height="20" HorizontalAlignment="Center"
                                          IsVisible="{Binding IsNotEmpty}">
                                        <TextBlock Text="{Binding DisplayGlyph}" 
                                                   Foreground="{DynamicResource BrushRadialText}" FontSize="9"
                                                   IsVisible="{Binding !HasRealIcon}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding RealIcon}"
                                               IsVisible="{Binding HasRealIcon}"
                                               Width="18" Height="18"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource BrushRadialText}"
                                               FontSize="8" Width="44" TextAlignment="Center"
                                               Margin="0,4,0,0"
                                               IsVisible="{Binding IsNotEmpty}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Canvas>
</Window>
