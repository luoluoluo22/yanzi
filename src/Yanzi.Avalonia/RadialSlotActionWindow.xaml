<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yanzi.Avalonia"
        x:Class="Yanzi.Avalonia.RadialSlotActionWindow"
        Width="680"
        Height="680"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Focusable="True">

    <Window.Styles>
        <Style Selector="RadioButton.tabChip">
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryBtnBG}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSec}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushSecondaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tabChip:checked">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="18"
            BorderThickness="1.2"
            BorderBrush="{DynamicResource BrushBorder}"
            Background="{DynamicResource BrushWindowBG}"
            Padding="22"
            PointerPressed="Window_PointerPressed">
        <DockPanel LastChildFill="True">
            <!-- Top Header & Search & Tabs -->
            <StackPanel DockPanel.Dock="Top" Spacing="14">
                <!-- Header Title Bar -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding TitleText}"
                                   Foreground="{DynamicResource BrushTextMain}"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="选择要绑定到此插槽的 macOS 应用程序、系统动作或自定义小程序"
                                   Foreground="{DynamicResource BrushTextSec}"
                                   FontSize="12"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="8" Cursor="Hand"
                            Click="Close_Click" ToolTip.Tip="关闭">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z"
                              Fill="{DynamicResource BrushTextSec}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Search Input Bar -->
                <Border Height="40" Background="{DynamicResource BrushInputBG}" CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushTextSec}"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0"
                                 Watermark="搜索应用名称、系统动作、快捷短语或关键词..."
                                 Foreground="{DynamicResource BrushTextMain}" FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Padding="0"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"/>
                    </Grid>
                </Border>

                <!-- Category Tabs (All / Apps / Shortcuts / Custom) -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton x:Name="TabAll" Content="🌟 全部" IsChecked="True"
                                 Classes="tabChip" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabApps" Content="📱 本地应用"
                                 Classes="tabChip" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabShortcuts" Content="⌨️ 系统动作"
                                 Classes="tabChip" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabCustom" Content="🧩 自定义小程序"
                                 Classes="tabChip" Checked="Tab_Checked"/>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Action Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="📁 浏览本地应用/文件..." Click="AddLocalFile_Click"
                        Background="{DynamicResource BrushSecondaryBtnBG}" Foreground="{DynamicResource BrushTextMain}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12.5"/>
                <Button x:Name="CopyPromptButton" Content="📋 复制小程序提示词" Click="CopyPrompt_Click"
                        Background="{DynamicResource BrushSecondaryBtnBG}" Foreground="{DynamicResource BrushTextSec}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12.5"/>
                <Button x:Name="DeleteCommandButton" Content="🗑️ 清空此插槽" Click="DeleteCommand_Click"
                        Background="{DynamicResource BrushSecondaryBtnBG}" Foreground="#FFF87171" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12.5"/>
                <Button Content="确定添加到插槽" Click="Confirm_Click"
                        Background="{DynamicResource BrushAccent}" Foreground="White" FontWeight="SemiBold" CornerRadius="8" Padding="18,7" FontSize="12.5"/>
            </StackPanel>

            <!-- Main Items List -->
            <Border Margin="0,12,0,0"
                    Background="{DynamicResource BrushCardBG}"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BrushBorder}">
                <ListBox x:Name="ResultList"
                         ItemsSource="{Binding FilteredResults}"
                         SelectionMode="Single"
                         Background="Transparent"
                         DoubleTapped="ResultList_DoubleTapped"
                         KeyDown="ResultList_KeyDown">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Margin" Value="4,2"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BrushListViewItemSelectedBG}"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <!-- Icon / Glyph -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="{DynamicResource BrushSecondaryBtnBG}" Margin="0,0,12,0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform"
                                               IsVisible="{Binding HasIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Glyph}" FontSize="16"
                                                   IsVisible="{Binding !HasIcon}"
                                                   Foreground="{DynamicResource BrushTextMain}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Title & Description -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource BrushTextSec}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="420"/>
                                </StackPanel>

                                <!-- Category Badge -->
                                <Border Grid.Column="2" CornerRadius="6" Background="{Binding TagBackground}"
                                        Padding="7,3" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding CategoryTag}" Foreground="#E4E4E7" FontSize="10.5" FontWeight="Medium"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Border>
</Window>
