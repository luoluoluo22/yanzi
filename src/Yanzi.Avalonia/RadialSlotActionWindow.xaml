<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yanzi.Avalonia.RadialSlotActionWindow"
        Width="520"
        Height="640"
        SystemDecorations="None"
        Background="#F0181818"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Focusable="True">
    <Border CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#2DFFFFFF"
            Background="#F0181818"
            Padding="18">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="10">
                <TextBlock Text="{Binding TitleText}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="SearchBox"
                         Watermark="搜索扩展 / 输入关键词"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="新建子环" Click="AddChildPage_Click"/>
                    <Button x:Name="DeleteCommandButton" Content="删除扩展" Click="DeleteCommand_Click"/>
                    <Button x:Name="DeleteChildPageButton" Content="删除子环" Click="DeleteChildPage_Click"/>
                    <Button Content="关闭" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>

            <Border Margin="0,16,0,0"
                    Background="#14161616"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#22FFFFFF">
                <ListBox x:Name="ResultList"
                         ItemsSource="{Binding Results}"
                         SelectionMode="Single"
                         DoubleTapped="ResultList_DoubleTapped"
                         KeyDown="ResultList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,8">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="White"
                                           FontSize="14"/>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="#99FFFFFF"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Border>
</Window>
