<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yanzi.Avalonia.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrushBG" Color="#FF161616"/>
                    <SolidColorBrush x:Key="BrushWindowBG" Color="#F2141414"/>
                    <SolidColorBrush x:Key="BrushSidebarBG" Color="#E61A1A1A"/>
                    <SolidColorBrush x:Key="BrushCardBG" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="BrushBorder" Color="#28FFFFFF"/>
                    <SolidColorBrush x:Key="BrushAccent" Color="#FF3B82F6"/>
                    <SolidColorBrush x:Key="BrushAccentHover" Color="#FF2563EB"/>
                    <SolidColorBrush x:Key="BrushAccentText" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="BrushTextMain" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="BrushTextSec" Color="#FF9CA3AF"/>
                    <SolidColorBrush x:Key="BrushTextMuted" Color="#FF6B7280"/>
                    <SolidColorBrush x:Key="BrushInputBG" Color="#20000000"/>
                    <SolidColorBrush x:Key="BrushListViewItemSelectedBG" Color="#1E3B82F6"/>
                    <SolidColorBrush x:Key="BrushListViewItemMouseOver" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="BrushSecondaryBtnBG" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="BrushSecondaryBtnBorder" Color="#28FFFFFF"/>
                    <SolidColorBrush x:Key="BrushSeparator" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="BrushRadialOuterBG" Color="#AA101010"/>
                    <SolidColorBrush x:Key="BrushRadialInnerBG" Color="#CC101010"/>
                    <SolidColorBrush x:Key="BrushRadialCenterBG" Color="#F2161616"/>
                    <SolidColorBrush x:Key="BrushRadialBorder" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="BrushRadialBorderActive" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="BrushRadialBorderSec" Color="#2DFFFFFF"/>
                    <SolidColorBrush x:Key="BrushRadialText" Color="White"/>
                    <SolidColorBrush x:Key="BrushRadialTextMuted" Color="#80FFFFFF"/>
                    <SolidColorBrush x:Key="BrushRadialSlotHover" Color="#1AFFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrushBG" Color="#FFF9FAFB"/>
                    <SolidColorBrush x:Key="BrushWindowBG" Color="#F5F9FAFB"/>
                    <SolidColorBrush x:Key="BrushSidebarBG" Color="#E6F3F4F6"/>
                    <SolidColorBrush x:Key="BrushCardBG" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="BrushBorder" Color="#FFE5E7EB"/>
                    <SolidColorBrush x:Key="BrushAccent" Color="#FF2563EB"/>
                    <SolidColorBrush x:Key="BrushAccentHover" Color="#FF1D4ED8"/>
                    <SolidColorBrush x:Key="BrushAccentText" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="BrushTextMain" Color="#FF111827"/>
                    <SolidColorBrush x:Key="BrushTextSec" Color="#FF4B5563"/>
                    <SolidColorBrush x:Key="BrushTextMuted" Color="#FF9CA3AF"/>
                    <SolidColorBrush x:Key="BrushInputBG" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="BrushListViewItemSelectedBG" Color="#202563EB"/>
                    <SolidColorBrush x:Key="BrushListViewItemMouseOver" Color="#0D000000"/>
                    <SolidColorBrush x:Key="BrushSecondaryBtnBG" Color="#FFF3F4F6"/>
                    <SolidColorBrush x:Key="BrushSecondaryBtnBorder" Color="#FFE5E7EB"/>
                    <SolidColorBrush x:Key="BrushSeparator" Color="#15000000"/>
                    <SolidColorBrush x:Key="BrushRadialOuterBG" Color="#AAF3F4F6"/>
                    <SolidColorBrush x:Key="BrushRadialInnerBG" Color="#CCF3F4F6"/>
                    <SolidColorBrush x:Key="BrushRadialCenterBG" Color="#F2FFFFFF"/>
                    <SolidColorBrush x:Key="BrushRadialBorder" Color="#FFB9B9B9"/>
                    <SolidColorBrush x:Key="BrushRadialBorderActive" Color="#FF8E8E8E"/>
                    <SolidColorBrush x:Key="BrushRadialBorderSec" Color="#FFD6D6D6"/>
                    <SolidColorBrush x:Key="BrushRadialText" Color="#FF111827"/>
                    <SolidColorBrush x:Key="BrushRadialTextMuted" Color="#FF6B7280"/>
                    <SolidColorBrush x:Key="BrushRadialSlotHover" Color="#1F000000"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme/>

        <!-- Standard Button Style matching Windows -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrushSecondaryBtnBG}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushSecondaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushAccentHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
        </Style>

        <!-- Standard TextBox Style matching Windows -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputBG}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <!-- Standard ComboBox Style matching Windows -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputBG}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </Application.Styles>
</Application>
