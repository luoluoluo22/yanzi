<Window x:Class="OpenQuickHost.MobileMessageToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机消息"
        Width="390"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border Background="#F20B1220"
            BorderBrush="#334BD4FF"
            BorderThickness="1"
            CornerRadius="18"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="TitleText"
                               Text="手机发来消息"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaText"
                               Margin="0,4,0,0"
                               Foreground="#FF94A3B8"
                               Text="手机与电脑对话"
                               FontSize="{DynamicResource FontSizeSmallPlus}" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Width="30"
                        Height="30"
                        Margin="12,0,0,0"
                        Content="×"
                        Background="#1AFFFFFF"
                        BorderBrush="#22FFFFFF"
                        Foreground="White"
                        Click="CloseButton_Click" />
            </DockPanel>

            <ScrollViewer x:Name="MessageScrollViewer"
                          Grid.Row="1"
                          Margin="0,14,0,0"
                          MinHeight="96"
                          MaxHeight="260"
                          VerticalScrollBarVisibility="Auto"
                          Background="#66111827">
                <StackPanel x:Name="MessageStack"
                            Margin="8" />
            </ScrollViewer>

            <TextBlock x:Name="UrlHintText"
                       Grid.Row="2"
                       Margin="2,8,0,0"
                       Foreground="#FF67E8F9"
                       FontSize="{DynamicResource FontSizeSmallPlus}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />

            <DockPanel Grid.Row="3"
                       Margin="0,14,0,0"
                       LastChildFill="False">
                <Button Width="72"
                        Height="34"
                        DockPanel.Dock="Left"
                        Content="清理"
                        Background="#FF1F2937"
                        BorderBrush="#55EF4444"
                        Foreground="#FFFFA3A3"
                        Click="ClearHistoryButton_Click" />
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button x:Name="OpenLinkButton"
                            Width="86"
                            Height="34"
                            Margin="0,0,8,0"
                            Content="打开链接"
                            Background="#FF0891B2"
                            BorderBrush="#FF22D3EE"
                            Foreground="White"
                            Click="OpenLinkButton_Click"
                            Visibility="Collapsed" />
                    <CheckBox x:Name="AutoCloseCheckBox"
                              Content="5s 自动关闭"
                              Foreground="#FF94A3B8"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Checked="AutoCloseCheckBox_Checked"
                              Unchecked="AutoCloseCheckBox_Unchecked" />
                    <Button Width="72"
                            Height="34"
                            Margin="0,0,8,0"
                            Content="复制全部"
                            Background="#FF1F2937"
                            BorderBrush="#334BD4FF"
                            Foreground="White"
                            Click="CopyButton_Click" />
                    <Button Width="72"
                            Height="34"
                            Content="关闭"
                            Background="#FF111827"
                            BorderBrush="#334BD4FF"
                            Foreground="White"
                            Click="CloseButton_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
