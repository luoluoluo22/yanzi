<Window x:Class="OpenQuickHost.MobileMessageToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机消息"
        Width="390"
        Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border Background="{DynamicResource BrushDialogBG}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                        LastChildFill="False">
                <Button DockPanel.Dock="Left" MaxWidth="210" Height="32"
                        Style="{StaticResource SecondaryBtn}" Padding="6,0" Click="DeviceSwitcher_Click"
                        ToolTip="切换目标设备，查看上线记录或删除设备">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" Text="所有设备" MaxWidth="170"
                                   FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text=" ▾" />
                    </StackPanel>
                </Button>
                <ComboBox x:Name="TargetDevicePicker" Visibility="Collapsed" />
                
                <Button DockPanel.Dock="Right"
                        Width="30"
                        Height="30"
                        Margin="8,0,0,0"
                        Content="×"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="0"
                        FontSize="{DynamicResource FontSizeLargePlus}"
                        Click="CloseButton_Click" />
                
                <Button DockPanel.Dock="Right"
                        Width="46"
                        Height="30"
                        Content="清理"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="0"
                        FontSize="{DynamicResource FontSizeSmallPlus}"
                        Click="ClearHistoryButton_Click" />
            </DockPanel>

            <ScrollViewer x:Name="MessageScrollViewer"
                          Grid.Row="1"
                          Margin="0,14,0,0"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource BrushInputBG}">
                <StackPanel x:Name="MessageStack"
                            Margin="8" />
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <Button x:Name="AttachButton" DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,8,0" Content="＋" Click="AttachButton_Click" Style="{StaticResource SecondaryBtn}" FontSize="{DynamicResource FontSizeLargePlus}" Padding="0" />
                <Button x:Name="VoiceButton" DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,8,0" Content="🎙" Click="VoiceButton_Click" Style="{StaticResource SecondaryBtn}" FontSize="{DynamicResource FontSizeNormalPlus}" Padding="0" />
                <Button x:Name="SendButton" DockPanel.Dock="Right" Width="60" Height="30" Margin="8,0,0,0" Content="发送" Click="SendButton_Click" Style="{StaticResource PrimaryBtn}" />
                <TextBox x:Name="InputTextBox" Height="30" Background="{DynamicResource BrushInputBG}" Foreground="{DynamicResource BrushTextMain}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="6,2,6,2" KeyDown="InputTextBox_KeyDown" VerticalContentAlignment="Center"/>
            </DockPanel>

            <StackPanel Grid.Row="3">
            <TextBlock x:Name="SendStatusText" Margin="2,8,0,0" Foreground="{DynamicResource BrushTextMain}" TextWrapping="Wrap" />
            <TextBlock x:Name="UrlHintText"
                       Margin="2,8,0,0"
                       Foreground="{DynamicResource BrushAccent}"
                       FontSize="{DynamicResource FontSizeSmallPlus}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
            </StackPanel>

            <DockPanel Grid.Row="4"
                        Margin="0,10,0,0"
                        LastChildFill="False">
                <Button x:Name="OpenLinkButton"
                        Width="86"
                        Height="34"
                        DockPanel.Dock="Right"
                        Content="打开链接"
                        Style="{StaticResource PrimaryBtn}"
                        Click="OpenLinkButton_Click"
                        Visibility="Collapsed" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
