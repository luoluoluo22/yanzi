<Window x:Class="OpenQuickHost.MobileMessageToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机消息"
        Width="398" Height="468" MinWidth="360" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual">
    <!-- Theme tokens and controls are installed per-window by YanziUi.ApplyTo. -->
    <Border x:Name="ChatFrame"
            Background="{DynamicResource Yanzi.Color.Popover}"
            BorderBrush="{DynamicResource Yanzi.Color.Border}"
            BorderThickness="1" CornerRadius="{DynamicResource Yanzi.Radius.Xl}"
            Padding="12" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DeviceSwitcherButton" Grid.Column="0"
                        Style="{DynamicResource Yanzi.Button.Outline}"
                        Height="34" Padding="10,0" HorizontalAlignment="Left"
                        MaxWidth="240" Click="DeviceSwitcher_Click"
                        ToolTip="切换目标设备、查看在线信息与管理设备">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" Text="所有设备"
                                   FontSize="13" FontWeight="SemiBold"
                                   MaxWidth="190" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <ContentControl x:Name="DeviceChevron" Margin="7,0,0,0"
                                        VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Hidden model for the selected target, retained by message routing logic. -->
                <ComboBox x:Name="TargetDevicePicker" Visibility="Collapsed"/>
                <Button x:Name="ClearHistoryButton" Grid.Column="1" Content="清理" MinWidth="48" Height="34"
                        Style="{DynamicResource Yanzi.Button.Outline}"
                        Margin="6,0,0,0" Click="ClearHistoryButton_Click"
                        ToolTip="清空本机显示的手机消息历史"/>
                <Button x:Name="CloseButton" Grid.Column="2" Width="34" Height="34"
                        Margin="4,0,0,0"
                        Style="{DynamicResource Yanzi.Button.Ghost}"
                        Click="CloseButton_Click" ToolTip="关闭手机消息窗口"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource Yanzi.Color.Background}"
                    BorderBrush="{DynamicResource Yanzi.Color.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Yanzi.Radius.Md}"
                    ClipToBounds="True">
                <ScrollViewer x:Name="MessageScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,4,0,4">
                    <StackPanel x:Name="MessageStack" Margin="10,6"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AttachButton" Grid.Column="0" Width="34" Height="34"
                        Style="{DynamicResource Yanzi.Button.Outline}"
                        Click="AttachButton_Click"
                        ToolTip="选择图片或文件发送"/>
                <Button x:Name="VoiceButton" Grid.Column="1" Width="34" Height="34"
                        Margin="6,0,0,0"
                        Style="{DynamicResource Yanzi.Button.Outline}"
                        Click="VoiceButton_Click"
                        ToolTip="语音输入"/>
                <TextBox x:Name="InputTextBox" Grid.Column="2"
                         Margin="12,0,8,0" MinHeight="34" MaxHeight="122"
                         MinLines="1" MaxLines="5" AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Center"
                         Style="{DynamicResource Yanzi.Textarea.Soft}"
                         KeyDown="InputTextBox_KeyDown"
                         PreviewKeyDown="InputTextBox_PreviewKeyDown"
                         DataObject.Pasting="InputTextBox_Pasting"
                         ToolTip="Enter 发送；Shift+Enter 换行；Ctrl+V 粘贴文本、图片或文件"/>
                <Button x:Name="SendButton" Grid.Column="3"
                        MinWidth="58" Height="34" Padding="12,0"
                        Style="{DynamicResource Yanzi.Button.Default}"
                        Content="发送" Click="SendButton_Click"/>
            </Grid>
            <StackPanel Grid.Row="3" Margin="2,3,2,0">
                <TextBlock x:Name="SendStatusText"
                           Foreground="{DynamicResource Yanzi.Color.MutedForeground}"
                           FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="UrlHintText"
                           Foreground="{DynamicResource Yanzi.Color.MutedForeground}"
                           FontSize="12" TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <Button x:Name="OpenLinkButton" Grid.Row="4"
                    Content="打开链接" Height="32" Margin="0,8,0,0"
                    HorizontalAlignment="Right" Padding="12,0"
                    Style="{DynamicResource Yanzi.Button.Outline}"
                    Click="OpenLinkButton_Click" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
