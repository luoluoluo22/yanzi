<Window x:Class="OpenQuickHost.PastedTextEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenQuickHost"
        Title="便签编辑"
        Width="680"
        Height="540"
        MinWidth="460"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource DialogWindow}">
    <Border Margin="1"
            CornerRadius="0"
            Background="#F2161616"
            BorderBrush="#22FFFFFF"
            BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题与快速操作 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Path Data="{local:IconGeometry note-text}" Fill="#10B981" Stretch="Uniform" Width="20" Height="20" Margin="0,0,8,0" />
                    <TextBlock Text="便签标题:" Style="{StaticResource TitleText}" FontSize="15" VerticalAlignment="Center" Foreground="#A0FFFFFF" />
                </StackPanel>

                <TextBox x:Name="TitleTextBox"
                         Grid.Column="1"
                         Height="34"
                         Padding="10,6"
                         VerticalAlignment="Center"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Background="#252528"
                         Foreground="#FFFFFF"
                         BorderBrush="#33FFFFFF"
                         BorderThickness="1" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="CopyAllButton"
                            Content="复制全文"
                            Style="{StaticResource SecondaryBtn}"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,6,0"
                            Click="CopyAllButton_Click" />
                    <Button x:Name="OpenFolderButton"
                            Content="打开位置"
                            Style="{StaticResource SecondaryBtn}"
                            Height="32"
                            Padding="10,0"
                            Click="OpenFolderButton_Click" />
                </StackPanel>
            </Grid>

            <!-- 状态与统计栏 -->
            <Grid Grid.Row="1" Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PathInfoText"
                           Grid.Column="0"
                           Foreground="#60FFFFFF"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CharCountText"
                           Grid.Column="1"
                           Foreground="#80FFFFFF"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 多行文本编辑框 -->
            <TextBox x:Name="ContentTextBox"
                     Grid.Row="2"
                     Margin="0,0,0,0"
                     Padding="12"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     FontSize="14"
                     FontFamily="Consolas, 'Microsoft YaHei', sans-serif"
                     Background="#1A1A1C"
                     Foreground="#F3F4F6"
                     BorderBrush="#25FFFFFF"
                     BorderThickness="1"
                     TextChanged="ContentTextBox_TextChanged"
                     PreviewKeyDown="ContentTextBox_PreviewKeyDown" />

            <!-- 底部保存/取消栏 -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusMessageText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#10B981"
                           FontSize="13" />

                <Button Grid.Column="1"
                        Content="取消"
                        Style="{StaticResource SecondaryBtn}"
                        Width="90"
                        Height="32"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click" />

                <Button Grid.Column="2"
                        Content="保存 (Ctrl+S)"
                        Style="{StaticResource PrimaryBtn}"
                        Width="120"
                        Height="32"
                        Click="SaveButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
