<Window x:Class="OpenQuickHost.InstalledAppPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="选择已安装程序" Width="680" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <!-- 滚动条样式 -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Cursor="Arrow" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" ViewportSize="{TemplateBinding ViewportWidth}" Width="6" Margin="2,0,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource BrushBorder}" BorderThickness="0" Width="6">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF16161B" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5" CornerRadius="16" SnapsToDevicePixels="True">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <!-- 顶部标题栏 -->
                <RowDefinition Height="Auto" />
                <!-- 搜索框 -->
                <RowDefinition Height="Auto" />
                <!-- 程序列表 -->
                <RowDefinition Height="*" />
                <!-- 底部操作栏 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" Margin="2,2,2,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="选择已安装程序" Foreground="{DynamicResource BrushTextMain}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatsText" Text="正在扫描系统程序..." Foreground="{DynamicResource BrushTextSec}" FontSize="12" Margin="10,2,0,0" VerticalAlignment="Center" Opacity="0.75" />
                </StackPanel>
                
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Click="CancelButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="14">
                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="{DynamicResource BrushTextSec}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                    <Setter Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 搜索框 -->
            <Border Grid.Row="1" Background="{DynamicResource BrushSecondaryBtnBG}" CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="2,0,2,12">
                <Grid Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="{DynamicResource BrushTextSec}" Width="14" Height="14" Margin="12,0,8,0" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="0,0,12,0"
                             Foreground="{DynamicResource BrushTextMain}" FontSize="13.5" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource BrushAccent}" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                    <TextBlock Grid.Column="1" Text="搜索应用名称、拼音或路径（如 微信、chrome、计算器）..." Foreground="{DynamicResource BrushTextSec}" FontSize="13.5"
                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Opacity="0.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 程序列表 -->
            <ListBox x:Name="AppsListBox" Grid.Row="2" Margin="2,0,2,12" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionMode="Single"
                     SelectionChanged="AppsListBox_SelectionChanged"
                     MouseDoubleClick="AppsListBox_MouseDoubleClick"
                     KeyDown="AppsListBox_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="itemBorder" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="10,8" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 程序图标 -->
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#14FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Image Source="{Binding IconSource}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- 程序信息 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushTextMain}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LaunchTarget}" Foreground="{DynamicResource BrushTextSec}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BrushSecondaryBtnBG}" />
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 底部操作栏 -->
            <Grid Grid.Row="3" Margin="2,0,2,2">
                <TextBlock x:Name="SelectedHintText" Text="提示：双击任意程序即可直接选定并填充。" Foreground="{DynamicResource BrushTextSec}" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{DynamicResource GhostButtonStyle}" Height="32" Padding="16,0" Click="CancelButton_Click" Cursor="Hand" />
                    <Button x:Name="ConfirmButton" Content="确认选择" Style="{DynamicResource GhostButtonStyle}" BorderBrush="{DynamicResource BrushAccent}" Height="32" Padding="16,0" Margin="10,0,0,0" Click="ConfirmButton_Click" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
