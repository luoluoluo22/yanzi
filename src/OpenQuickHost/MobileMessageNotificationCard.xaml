<Window x:Class="OpenQuickHost.MobileMessageNotificationCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="消息通知"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border Background="{DynamicResource BrushDialogBG}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock x:Name="TitleText"
                           Text="手机发来消息"
                           Foreground="{DynamicResource BrushTextMain}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           DockPanel.Dock="Left"/>
                <Button DockPanel.Dock="Right"
                        Width="22"
                        Height="22"
                        Content="×"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="0"
                        FontSize="12"
                        Click="CloseButton_Click" />
            </DockPanel>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource BrushTextMain}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       MaxHeight="80"/>

            <TextBlock x:Name="TimeText"
                       Grid.Row="2"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource BrushTextSec}"
                       FontSize="11"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
