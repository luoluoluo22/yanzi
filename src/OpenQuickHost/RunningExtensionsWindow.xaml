<Window x:Class="OpenQuickHost.RunningExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在运行的小程序"
        Width="980"
        Height="560"
        MinWidth="840"
        MinHeight="400"
        Background="#FF161616"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="正在运行的小程序" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryTextBlock" Margin="0,6,0,0" Foreground="#FF9CA3AF" />
            </StackPanel>
            <Button Grid.Column="1"
                    Width="90"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryBtn}"
                    Click="RefreshButton_Click"
                    Content="刷新" />
        </Grid>

        <Border Grid.Row="1"
                Background="#FF1E1E1E"
                BorderBrush="#FF2A2A2A"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <ListView x:Name="ExtensionListView"
                          Margin="10"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="210">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Icon Area -->
                                            <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Border Width="20"
                                                        Height="20"
                                                        CornerRadius="5"
                                                        ClipToBounds="True">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{Binding AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasImageIcon}" Value="True">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Image Source="{Binding IconSource}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               SnapsToDevicePixels="True"
                                                               Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <Viewbox Margin="3"
                                                                 Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Path Width="24"
                                                                  Height="24"
                                                                  Data="{Binding VectorIcon}"
                                                                  Fill="White"
                                                                  Stretch="Uniform" />
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding DisplayGlyph}"
                                                                   FontSize="10"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="Bold"
                                                                   Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                                <!-- Running indicator (Green Dot) -->
                                                <Border Width="6"
                                                        Height="6"
                                                        CornerRadius="3"
                                                        Background="#FF10B981"
                                                        BorderBrush="#CCFFFFFF"
                                                        BorderThickness="0.8"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,-1.5,-1.5"
                                                        IsHitTestVisible="False" />
                                            </Grid>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="White" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="扩展 ID" Width="180" DisplayMemberBinding="{Binding ExtensionId}" />
                            <GridViewColumn Header="PID" Width="75" DisplayMemberBinding="{Binding ProcessId}" />
                            <GridViewColumn Header="运行时" Width="85" DisplayMemberBinding="{Binding Runtime}" />
                            <GridViewColumn Header="来源" Width="95" DisplayMemberBinding="{Binding LaunchSource}" />
                            <GridViewColumn Header="启动时间" Width="160" DisplayMemberBinding="{Binding StartedAtText}" />
                            <GridViewColumn Header="操作" Width="105">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="强制结束"
                                                Width="84"
                                                Height="28"
                                                Foreground="#FFFCA5A5"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Tag="{Binding InstanceId}"
                                                Click="TerminateButton_Click"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="#33EF4444"
                                                            BorderBrush="#55EF4444"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FFDC2626" />
                                                            <Setter TargetName="border" Property="BorderBrush" Value="#FFEF4444" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FFB91C1C" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock x:Name="EmptyStateTextBlock"
                           Text="当前没有正在运行的小程序。"
                           FontSize="{DynamicResource FontSizeLargePlus}"
                           Foreground="#FF6B7280"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="4,12,0,0"
                   Foreground="#FF6B7280"
                   Text="展示当前在后台持续运行的小程序与独立进程，可随时强制结束。" />
    </Grid>
</Window>
