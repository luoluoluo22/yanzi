<Window x:Class="OpenQuickHost.RunningExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在运行的扩展"
        Width="880"
        Height="520"
        MinWidth="720"
        MinHeight="360"
        Background="#FF161616"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="正在运行的扩展" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryTextBlock" Margin="0,6,0,0" Foreground="#FF9CA3AF" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Width="90"
                    Height="34"
                    Margin="12,0,0,0"
                    Style="{StaticResource SecondaryBtn}"
                    Click="RefreshButton_Click"
                    Content="刷新" />
        </DockPanel>

        <Border Grid.Row="1"
                Background="#FF1E1E1E"
                BorderBrush="#FF2A2A2A"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <ListView x:Name="ExtensionListView"
                          Margin="10"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="180" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="扩展 ID" Width="170" DisplayMemberBinding="{Binding ExtensionId}" />
                            <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding ProcessId}" />
                            <GridViewColumn Header="运行时" Width="80" DisplayMemberBinding="{Binding Runtime}" />
                            <GridViewColumn Header="来源" Width="100" DisplayMemberBinding="{Binding LaunchSource}" />
                            <GridViewColumn Header="启动时间" Width="160" DisplayMemberBinding="{Binding StartedAtText}" />
                            <GridViewColumn Header="操作" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="强制结束"
                                                Width="84"
                                                Height="30"
                                                Background="#FF7F1D1D"
                                                BorderBrush="#FFB91C1C"
                                                BorderThickness="1"
                                                Foreground="White"
                                                Tag="{Binding InstanceId}"
                                                Click="TerminateButton_Click" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock x:Name="EmptyStateTextBlock"
                           Text="当前没有正在运行的独立窗口扩展。"
                           FontSize="{DynamicResource FontSizeLargePlus}"
                           Foreground="#FF6B7280"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="4,12,0,0"
                   Foreground="#FF6B7280"
                   Text="这里只展示独立进程运行的窗口型扩展，可直接强制结束。" />
    </Grid>
</Window>
