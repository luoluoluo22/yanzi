<Window x:Class="OpenQuickHost.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录燕子云同步"
        Width="420"
        SizeToContent="Height"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{x:Null}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Style="{StaticResource DialogWindow}">
    <Border Margin="0"
            CornerRadius="0"
            Background="{DynamicResource BrushDialogBG}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="HeaderText"
                               Text="登录燕子云同步"
                               Style="{StaticResource TitleText}" />
                    <TextBlock x:Name="DescriptionText"
                               Margin="0,8,0,0"
                               Text="登录后可在多设备之间同步扩展和设置。"
                               Style="{StaticResource DescriptionText}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SignInModeButton"
                            Grid.Column="0"
                            Content="登录"
                            Style="{StaticResource SecondaryBtn}"
                            Margin="0,0,6,0"
                            Click="SignInModeButton_Click" />
                    <Button x:Name="RegisterModeButton"
                            Grid.Column="1"
                            Content="注册"
                            Style="{StaticResource SecondaryBtn}"
                            Margin="6,0,0,0"
                            Click="RegisterModeButton_Click" />
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock x:Name="PrimaryFieldLabel"
                               Text="邮箱"
                               Foreground="{DynamicResource BrushTextSec}"
                               FontSize="{DynamicResource FontSizeSmallPlus}"
                               Margin="2,0,0,6"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="PrimaryInputBox"
                             Height="40"
                             Padding="12,10" />
                </StackPanel>

                <StackPanel x:Name="EmailPanel" Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="邮箱"
                               Foreground="{DynamicResource BrushTextSec}"
                               FontSize="{DynamicResource FontSizeSmallPlus}"
                               Margin="2,0,0,6"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="EmailBox"
                             Height="40"
                             Padding="12,10" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock Text="密码"
                               Foreground="{DynamicResource BrushTextSec}"
                               FontSize="{DynamicResource FontSizeSmallPlus}"
                               Margin="2,0,0,6"
                               FontWeight="SemiBold" />
                    <Grid>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="40"
                                     Padding="12,10,36,10"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBox x:Name="PasswordTextBox"
                                 Height="40"
                                 Padding="12,10,36,10"
                                 Visibility="Collapsed"
                                 TextChanged="PasswordTextBox_TextChanged"/>
                        <ToggleButton x:Name="ShowPasswordToggle"
                                      Width="30"
                                      Height="30"
                                      Margin="0,0,5,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Cursor="Hand"
                                      Focusable="False"
                                      Checked="ShowPasswordToggle_Checked"
                                      Unchecked="ShowPasswordToggle_Unchecked">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <Path x:Name="EyeIconPath"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource BrushTextSec}"
                                  Data="M12 6c3.79 0 7.17 2.13 8.82 5.5-.59 1.22-1.42 2.27-2.41 3.12l1.41 1.41c1.39-1.23 2.49-2.77 3.18-4.53C21.27 6.61 17 3.5 12 3.5c-1.25 0-2.45.2-3.57.57L9.9 5.54c.68-.35 1.42-.54 2.1-.54zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-3.11l1.9 1.9c.35.46.59 1 .69 1.59l-2.59-2.59c.59-.1 1.13-.34 1.59-.69z"/>
                        </ToggleButton>
                    </Grid>
                </StackPanel>

                <Grid x:Name="CodePanel" Grid.Row="5" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="邮箱验证码"
                                   Foreground="{DynamicResource BrushTextSec}"
                                   FontSize="{DynamicResource FontSizeSmallPlus}"
                                   Margin="2,0,0,6"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="CodeBox"
                                 Height="40"
                                 Padding="12,10" />
                    </StackPanel>
                    <Button x:Name="SendCodeButton"
                            Grid.Column="1"
                            Margin="10,26,0,0"
                            MinWidth="98"
                            Content="发送验证码"
                            Style="{StaticResource SecondaryBtn}"
                            Click="SendCodeButton_Click" />
                </Grid>

                <StackPanel Grid.Row="6" Margin="0,16,0,0">
                    <CheckBox x:Name="RememberCheckBox"
                              IsChecked="True"
                              Foreground="{DynamicResource BrushTextSec}"
                              Content="记住登录信息（本机加密保存）"
                              FontSize="{DynamicResource FontSizeSmallPlus}" />
                    <Button x:Name="ForgotPasswordButton"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Content="找回密码"
                            Style="{StaticResource SecondaryBtn}"
                            Click="ForgotPasswordButton_Click" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,10,0,0"
                               Foreground="#FFEF4444"
                               FontSize="{DynamicResource FontSizeSmallPlus}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <Grid Grid.Row="7" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="取消"
                            Style="{StaticResource SecondaryBtn}"
                            Margin="0,0,6,0"
                            Click="CancelButton_Click" />
                    <Button x:Name="ConfirmButton"
                            Grid.Column="1"
                            Content="登录"
                            Style="{StaticResource PrimaryBtn}"
                            Margin="6,0,0,0"
                            Click="ConfirmButton_Click" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
