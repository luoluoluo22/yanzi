<UserControl x:Class="OpenQuickHost.SecretValueEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenQuickHost"
             Focusable="False">
    <Grid>
        <!-- The normal state is a native PasswordBox, not a plaintext TextBox covered by dots. -->
        <PasswordBox x:Name="MaskedInput"
                     Style="{DynamicResource Yanzi.Password}"
                     Padding="10,4,40,4"
                     VerticalContentAlignment="Center"
                     PasswordChanged="MaskedInput_PasswordChanged"/>
        <TextBox x:Name="RevealedInput"
                 Style="{DynamicResource Yanzi.Input}"
                 Padding="10,4,40,4"
                 VerticalContentAlignment="Center"
                 Visibility="Collapsed"
                 TextChanged="RevealedInput_TextChanged"/>
        <Button x:Name="EyeButton"
                Tag="KeepNativeStyle"
                Width="32" Height="30" Padding="0" Margin="0,0,4,0"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0"
                Cursor="Hand" Focusable="False"
                ToolTip="显示内容"
                AutomationProperties.Name="显示内容"
                Click="EyeButton_Click">
            <Grid Width="16" Height="16">
                <Path x:Name="ShowEyeIcon"
                      Data="{local:IconGeometry eye-outline}"
                      Stretch="Uniform" Fill="{DynamicResource BrushTextSec}"/>
                <Path x:Name="HideEyeIcon"
                      Data="{local:IconGeometry eye-off-outline}"
                      Stretch="Uniform" Fill="{DynamicResource BrushTextSec}"
                      Visibility="Collapsed"/>
            </Grid>
        </Button>
    </Grid>
</UserControl>