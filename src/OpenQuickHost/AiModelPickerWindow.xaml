<Window x:Class="OpenQuickHost.AiModelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择模型"
        Width="520"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">
    <Border Margin="1"
            CornerRadius="0"
            Background="{DynamicResource BrushDialogBG}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock" Text="选择模型" Style="{StaticResource TitleText}" />

            <TextBlock x:Name="DescriptionTextBlock"
                       Grid.Row="1"
                       Margin="0,8,0,0"
                       Style="{StaticResource DescriptionText}"
                       TextWrapping="Wrap" />

            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Background="{DynamicResource BrushInputBG}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  Style="{DynamicResource Yanzi.CheckBox}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   Text="{Binding Name}"
                                                   Foreground="{DynamicResource BrushTextMain}"
                                                   FontSize="{DynamicResource FontSizeSmallPlus}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2"
                                                Margin="10,0,0,0"
                                                Padding="8,2"
                                                CornerRadius="4"
                                                Background="{DynamicResource BrushInputBG}"
                                                Visibility="{Binding AlreadyAddedVisibility}">
                                            <TextBlock Text="已添加"
                                                       Foreground="{DynamicResource BrushAccent}"
                                                       FontSize="{DynamicResource FontSizeTiny}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryTextBlock"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextSec}"
                           FontSize="{DynamicResource FontSizeSmallPlus}" />
                <Button Grid.Column="1"
                        Content="取消"
                        Style="{DynamicResource Yanzi.Button.Outline}"
                        Width="96"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click" />
                <Button Grid.Column="2"
                        Content="添加所选"
                        Style="{DynamicResource Yanzi.Button.Default}"
                        Width="110"
                        Click="ConfirmButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
