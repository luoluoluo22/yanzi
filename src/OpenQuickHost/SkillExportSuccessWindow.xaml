<Window x:Class="OpenQuickHost.SkillExportSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skill 导出成功"
        Width="860"
        Height="760"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource DialogWindow}">
    <Border Margin="1"
            CornerRadius="0"
            Background="{DynamicResource BrushDialogBG}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="导出成功" Style="{StaticResource TitleText}" />
                <TextBlock x:Name="VerificationSummaryText"
                           Margin="0,8,0,0"
                           Style="{StaticResource DescriptionText}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="导出路径"
                           Foreground="{DynamicResource BrushTextSec}"
                           FontSize="{DynamicResource FontSizeSmallPlus}"
                           FontWeight="SemiBold"
                           Margin="2,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExportPathBox"
                             Grid.Column="0"
                             Style="{DynamicResource Yanzi.Input}"
                             Height="36"
                             Padding="10,7"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="导出目录路径" />
                    <Button x:Name="CopyPathButton"
                            Grid.Column="1"
                            Content="复制路径"
                            Style="{DynamicResource Yanzi.Button.Outline}"
                            Width="88"
                            Margin="8,0,0,0"
                            Click="CopyPathButton_Click" />
                    <Button x:Name="OpenFolderButton"
                            Grid.Column="2"
                            Content="打开目录"
                            Style="{DynamicResource Yanzi.Button.Default}"
                            Width="88"
                            Margin="8,0,0,0"
                            Click="OpenFolderButton_Click" />
                </Grid>
            </StackPanel>

            <Expander Grid.Row="2"
                      Header="SHA-256 文件校验明细"
                      Margin="0,12,0,0"
                      IsExpanded="False">
                <TextBox x:Name="FileVerificationBox"
                         Height="112"
                         Margin="0,8,0,0"
                         Padding="10"
                         Style="{DynamicResource Yanzi.Input}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11" />
            </Expander>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="AI 可识别的 Skill 内容"
                           Foreground="{DynamicResource BrushTextSec}"
                           FontSize="{DynamicResource FontSizeSmallPlus}"
                           FontWeight="SemiBold"
                           Margin="2,0,0,0" />
                <TextBlock Grid.Row="1"
                           Margin="2,6,0,10"
                           Style="{StaticResource DescriptionText}"
                           Text="包含 Skill 的 YAML name / description 元数据和 SKILL.md 完整指令正文。AI 会先根据名称和描述判断是否适用，再按需读取 references、scripts 等配套文件。"
                           TextWrapping="Wrap" />
                <TextBox x:Name="SkillContentBox"
                         Grid.Row="2"
                         Style="{DynamicResource Yanzi.Input}"
                         Padding="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11.5"
                         AutomationProperties.Name="AI 可识别的 Skill 完整内容" />
            </Grid>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CopyStatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextSec}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           TextWrapping="Wrap" />
                <Button x:Name="CopySkillContentButton"
                        Grid.Column="1"
                        Content="复制 Skill 内容"
                        Style="{DynamicResource Yanzi.Button.Outline}"
                        Width="120"
                        Margin="8,0,0,0"
                        Click="CopySkillContentButton_Click" />
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Content="完成"
                        IsDefault="True"
                        Style="{DynamicResource Yanzi.Button.Default}"
                        Width="90"
                        Margin="8,0,0,0"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
