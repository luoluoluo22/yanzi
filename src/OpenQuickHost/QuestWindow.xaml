<Window x:Class="OpenQuickHost.QuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务与成就"
        Width="340"
        Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border x:Name="CardBorder"
            Background="#EE14141B"
            BorderBrush="#40FFFFFF"
            BorderThickness="1.2"
            CornerRadius="16"
            Padding="16,10">
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow"
                              BlurRadius="20"
                              Direction="270"
                              ShadowDepth="4"
                              Opacity="0.65"
                              Color="#000000" />
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 任务核心文本展示区 (带动画切换) -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Margin="4,0,8,0">
                <TextBlock x:Name="TxtStatusIcon"
                           Text="🎒"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <TextBlock x:Name="TxtQuestPrompt"
                           Text="长按鼠标右键 召唤背包"
                           Foreground="#FFF0F0F5"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- 右侧关闭按钮 -->
            <Button Grid.Column="1"
                    Width="20"
                    Height="20"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="#66FFFFFF"
                    FontSize="12"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Setter TargetName="Brd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="✕" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
            </Button>
        </Grid>
    </Border>
</Window>
