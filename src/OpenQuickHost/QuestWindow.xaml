<Window x:Class="OpenQuickHost.QuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenQuickHost"
        Title="燕子工坊 · 任务成就系统"
        Width="580"
        Height="640"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Background="#FF16161B"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              ShadowDepth="8"
                              Opacity="0.65"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header: 标题与个人成就信息 -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#263B82F6"
                            BorderBrush="#4D3B82F6"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4"
                            Margin="0,0,10,0">
                        <TextBlock Text="🎒 探险指南"
                                   Foreground="#FF60A5FA"
                                   FontSize="13"
                                   FontWeight="Bold" />
                    </Border>

                    <TextBlock Text="燕子工坊 · 成就之路"
                               Foreground="#FFF0F0F5"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <!-- 等级称号标签 -->
                    <Border Background="#1A34D399"
                            BorderBrush="#4034D399"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,2"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtLevelName"
                                       Text="Lv.1 效率学徒"
                                       Foreground="#FF34D399"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text=" · "
                                       Foreground="#8034D399"
                                       FontSize="12" />
                            <TextBlock x:Name="TxtPoints"
                                       Text="0 分"
                                       Foreground="#FF34D399"
                                       FontSize="12"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 关闭按钮 -->
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#80A1A1AA"
                        FontSize="15"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#26FFFFFF" />
                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="✕" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. 中部核心区域：单任务聚焦卡片 + 徽章墙 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,-6,0"
                          Padding="0,0,6,0">
                <StackPanel>

                    <!-- 当前唯一焦点任务卡片 -->
                    <Border Background="#FF1E1E26"
                            BorderBrush="#FF2E303D"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <!-- 任务标签与通关状态 -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="QuestCategoryBadge"
                                            Background="#26F59E0B"
                                            BorderBrush="#4DF59E0B"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="6,2"
                                            Margin="0,0,8,0">
                                        <TextBlock x:Name="TxtQuestCategory"
                                                   Text="新手试炼 · 1阶"
                                                   Foreground="#FFF59E0B"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock x:Name="TxtQuestTitle"
                                               Text="【探险家启程】召唤随身背包"
                                               Foreground="#FFF0F0F5"
                                               FontSize="15"
                                               FontWeight="Bold" />
                                </StackPanel>

                                <Border x:Name="BadgeCompletedMark"
                                        HorizontalAlignment="Right"
                                        Background="#2634D399"
                                        BorderBrush="#4D34D399"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        Visibility="Collapsed">
                                    <TextBlock Text="✓ 已通关达成"
                                               Foreground="#FF34D399"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <!-- 剧情与痛点描述 -->
                            <TextBlock x:Name="TxtQuestDesc"
                                       Text="工欲善其事，必先利其器！在屏幕任意位置长按鼠标右键，唤醒属于你的随身背包（快捷面板）。"
                                       Foreground="#FFA1A1AA"
                                       FontSize="12"
                                       LineHeight="18"
                                       Margin="0,10,0,14"
                                       TextWrapping="Wrap" />

                            <!-- 步骤检查清单 -->
                            <Border Background="#FF16161B"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,12">
                                <StackPanel>
                                    <!-- 步骤 1 -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="IconStep1"
                                                   Text="⚪"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1"
                                                   x:Name="TxtStep1"
                                                   Text="步骤 1：长按鼠标右键呼出一次随身背包"
                                                   Foreground="#FFE5E5E5"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- 步骤 2 (可选) -->
                                    <Grid x:Name="Step2Row" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="IconStep2"
                                                   Text="⚪"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1"
                                                   x:Name="TxtStep2"
                                                   Text="步骤 2：将扩展放入随身背包任意格位"
                                                   Foreground="#FFE5E5E5"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 交互引导操作按钮 -->
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnActionPrimary"
                                        Content="🎒 立即呼出随身背包"
                                        Background="#FF2563EB"
                                        Foreground="#FFFFFFFF"
                                        BorderThickness="0"
                                        Padding="14,8"
                                        FontWeight="SemiBold"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Click="BtnActionPrimary_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Brd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Brd" Property="Background" Value="#FF1D4ED8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="BtnOpenBackpack"
                                        Content="🖱️ 打开随身背包"
                                        Background="#FF2D2D38"
                                        Foreground="#FFE5E5E5"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        Margin="10,0,0,0"
                                        Padding="14,8"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Click="BtnOpenBackpack_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Brd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Brd" Property="Background" Value="#FF3A3A4A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- 动态状态提示横幅 -->
                            <Border x:Name="FeedbackBorder"
                                    Background="#1A3B82F6"
                                    BorderBrush="#333B82F6"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,12,0,0">
                                <TextBlock x:Name="TxtStatusFeedback"
                                           Text="👉 在屏幕任意位置长按鼠标右键，体验秒出随身背包！"
                                           Foreground="#FF93C5FD"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- 任务检测与领奖条目 -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="本关通关奖励：" Foreground="#FFA1A1AA" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock x:Name="TxtRewardPoints" Text="+30 成就分" Foreground="#FF34D399" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text=" · " Foreground="#66FFFFFF" FontSize="13"/>
                                        <TextBlock x:Name="TxtRewardBadge" Text="🎒「初入江湖」徽章" Foreground="#FFF59E0B" FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 立即检测按钮 -->
                                <Button Grid.Column="1"
                                        x:Name="BtnVerify"
                                        Content="🔍 立即检测完成情况"
                                        Background="#FF059669"
                                        Foreground="#FFFFFFFF"
                                        BorderThickness="0"
                                        Padding="16,8"
                                        FontWeight="Bold"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Click="BtnVerify_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Brd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Brd" Property="Background" Value="#FF047857" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 下一个任务解锁与切换按钮区域 -->
                    <Border Background="#FF1E1E26"
                            BorderBrush="#FF2E303D"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnPrevQuest"
                                    Content="❮ 上一关"
                                    Background="#FF2D2D38"
                                    Foreground="#80FFFFFF"
                                    BorderThickness="0"
                                    Padding="10,6"
                                    FontSize="11"
                                    Cursor="Hand"
                                    Click="BtnPrevQuest_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Brd" Property="Background" Value="#FF3A3A4A" />
                                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="1"
                                    x:Name="BtnNextQuest"
                                    Content="➔ 解锁下一个任务"
                                    Background="#FF2563EB"
                                    Foreground="#FFFFFFFF"
                                    BorderThickness="0"
                                    Margin="10,0,0,0"
                                    Padding="14,7"
                                    FontWeight="Bold"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Click="BtnNextQuest_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Brd" Property="Background" Value="#FF1D4ED8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 关卡进度指示 -->
                            <TextBlock Grid.Column="2"
                                       x:Name="TxtQuestProgress"
                                       Text="第 1 / 5 关"
                                       Foreground="#80A1A1AA"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- 徽章墙概览 -->
                    <Border Background="#FF1E1E26"
                            BorderBrush="#FF2E303D"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="🏅 已解锁成就徽章"
                                       Foreground="#FFF0F0F5"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10" />

                            <UniformGrid x:Name="BadgesGrid" Columns="5" Rows="1">
                                <!-- 徽章 1: 初入江湖 -->
                                <Border x:Name="Badge1Border" Background="#FF16161B" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,8" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🎒" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBadge1" Text="初入江湖" Foreground="#44FFFFFF" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 徽章 2: 指尖神算 -->
                                <Border x:Name="Badge2Border" Background="#FF16161B" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,8" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🧮" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBadge2" Text="指尖神算" Foreground="#44FFFFFF" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 徽章 3: 超光速跳跃 -->
                                <Border x:Name="Badge3Border" Background="#FF16161B" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,8" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🚀" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBadge3" Text="超光速跳跃" Foreground="#44FFFFFF" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 徽章 4: 系统清道夫 -->
                                <Border x:Name="Badge4Border" Background="#FF16161B" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,8" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🧹" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBadge4" Text="系统清道夫" Foreground="#44FFFFFF" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 徽章 5: 智械先驱 -->
                                <Border x:Name="Badge5Border" Background="#FF16161B" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🧙" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBadge5" Text="智械先驱" Foreground="#44FFFFFF" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
