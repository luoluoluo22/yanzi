<Window x:Class="OpenQuickHost.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenQuickHost"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="设置"
        WindowStyle="SingleBorderWindow"
        Width="1024"
        Height="768"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBG}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    
    
    <Window.Resources>
        <local:KeywordMatchToBrushConverter x:Key="KeywordMatchToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />
        <local:ModelNameFirstCharConverter x:Key="ModelNameFirstCharConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Colors -->
        <Color x:Key="SidebarBG">#FF1E1E1E</Color>
        <Color x:Key="ContentBG">#FF161616</Color>
        <Color x:Key="BorderColor">#FF2A2A2A</Color>
        <Color x:Key="AccentColor">#FF3B82F6</Color>
        <SolidColorBrush x:Key="TextMainBrush" Color="{DynamicResource ColorTextMain}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource ColorTextSec}" />
        
        <Style x:Key="SidebarListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Padding="12,8"
                                CornerRadius="8"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushListViewItemSelectedBG}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch Style (Raycast style) -->
        <Style x:Key="RaycastSwitchStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20">
                            <Border x:Name="Track"
                                    CornerRadius="10"
                                    Background="{DynamicResource BrushBorder}" />
                            <Ellipse x:Name="Thumb"
                                    Width="16"
                                    Height="16"
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="White">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF3B82F6" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                           To="16" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                           To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF666666" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateStoreBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#FF16A34A" />
        </Style>

        <Style x:Key="GestureAssignBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="InlineLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF60A5FA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MouseTriggerOptionLabelTemplate">
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource BrushTextMain}" />
        </DataTemplate>

        <DataTemplate x:Key="MouseGestureExtensionOptionTemplate">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="22" Height="22" CornerRadius="7" Background="{Binding AccentBrush}" Opacity="0.95" VerticalAlignment="Center">
                    <Grid>
                        <Image Source="{Binding IconSource}" Width="15" Height="15" Stretch="Uniform"
                               Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform" Width="13" Height="13"
                              Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding DisplayGlyph}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeTiny}" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <local:HighlightedTextBlock SourceText="{Binding Label}"
                                                HighlightText="{Binding DataContext.ExtensionSearchText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                Foreground="{DynamicResource BrushTextMain}"
                                                HighlightBrush="#FF60A5FA"
                                                FontSize="{DynamicResource FontSizeSmallPlus}"
                                                TextTrimming="CharacterEllipsis"/>
                    <local:HighlightedTextBlock SourceText="{Binding Category}"
                                                HighlightText="{Binding DataContext.ExtensionSearchText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                Foreground="{DynamicResource BrushTextSec}"
                                                HighlightBrush="#FF93C5FD"
                                                FontSize="{DynamicResource FontSizeTiny}"
                                                TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MouseGestureAppOptionTemplate">
            <Grid Margin="0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <local:HighlightedTextBlock SourceText="{Binding AppName}"
                                            HighlightText="{Binding DataContext.AppSearchText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Foreground="{DynamicResource BrushTextMain}"
                                            HighlightBrush="#FF60A5FA"
                                            FontSize="{DynamicResource FontSizeSmallPlus}"
                                            TextTrimming="CharacterEllipsis"/>
                <local:HighlightedTextBlock Grid.Row="1"
                                            SourceText="{Binding AppPath}"
                                            HighlightText="{Binding DataContext.AppSearchText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Foreground="{DynamicResource BrushTextSec}"
                                            HighlightBrush="#FF93C5FD"
                                            FontSize="{DynamicResource FontSizeTiny}"
                                            TextTrimming="CharacterEllipsis"
                                            Margin="0,2,0,0"/>
            </Grid>
        </DataTemplate>


        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF2F3440" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#443B82F6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1F3B82F6" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#803B82F6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="{DynamicResource BrushInputBG}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Tag="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="10,0,4,0"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      Width="9"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M0,0 L4.5,5 L9,0 Z"
                                                      Fill="#FF9CA3AF"
                                                      Stretch="Fill" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF4B5563" />
                                                <Setter TargetName="Root" Property="Background" Value="#FF252832" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF3B82F6" />
                                                <Setter TargetName="Root" Property="Background" Value="#FF1F2533" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="#FF60A5FA" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource BrushBG}"
                                        BorderBrush="#FF303642"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,5,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Padding="3"
                                                  SnapsToDevicePixels="True"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#FF3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF8E8E8E" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushListViewItemSelectedBG}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Badge Styles -->
        <Style x:Key="PublishedBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A16A34A" />
            <Setter Property="BorderBrush" Value="#FF16A34A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style x:Key="DisabledBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A666666" />
            <Setter Property="BorderBrush" Value="#FF666666" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <!-- Filter Tab Style -->
        <Style x:Key="FilterTabStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="FilterTabActiveStyle" TargetType="Border" BasedOn="{StaticResource FilterTabStyle}">
            <Setter Property="Background" Value="{DynamicResource BrushListViewItemSelectedBG}" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Margin="0"
            CornerRadius="0"
            Background="{DynamicResource BrushBG}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0"
            PreviewMouseLeftButtonDown="WindowFrame_PreviewMouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar (Left) -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BrushBG}" 
                    CornerRadius="0"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Account Section -->
                    <Button Grid.Row="0"
                            Margin="10,15,10,10"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AccountButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32"
                                                Height="32"
                                                CornerRadius="16"
                                                Background="#1A3B82F6"
                                                VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18">
                                                <Path Data="{local:IconGeometry user}" Fill="#FF3B82F6" Stretch="Uniform"/>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AccountTitle}"
                                                       FontSize="{DynamicResource FontSizeNormal}"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource BrushTextMain}" />
                                            <TextBlock Text="账户"
                                                       Foreground="{DynamicResource BrushTextSec}"
                                                       FontSize="{DynamicResource FontSizeSmall}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AccountMenu">
                                <MenuItem Header="登录或切换账号" Click="SignInMenuItem_Click" />
                                <MenuItem Header="退出登录" Click="SignOutMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="刷新云状态" Click="RefreshAccountMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Global Search Box -->
                    <Border Grid.Row="1"
                            x:Name="GlobalSearchBoxBorder"
                            Margin="10,0,10,15" 
                            Background="{DynamicResource BrushBG}" 
                            CornerRadius="6" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1"
                            Height="32">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{local:IconGeometry search}" Fill="{DynamicResource BrushTextSec}" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBox Grid.Column="1" 
                                     x:Name="SettingsSearchBox"
                                     Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="{DynamicResource BrushTextMain}" 
                                     CaretBrush="White"
                                     VerticalAlignment="Center"
                                     FontSize="{DynamicResource FontSizeNormal}"
                                     PreviewKeyDown="SettingsSearchBox_PreviewKeyDown"/>
                            <Popup x:Name="SettingsSearchPopup"
                                   IsOpen="{Binding IsSearchPopupOpen}"
                                   PlacementTarget="{Binding ElementName=GlobalSearchBoxBorder}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   PopupAnimation="Slide"
                                   Width="{Binding ElementName=GlobalSearchBoxBorder, Path=ActualWidth}"
                                   Margin="0,5,0,0">
                                <Border Background="{DynamicResource BrushBG}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <ListBox x:Name="SearchPopupListBox" ItemsSource="{Binding MatchedSearchItems}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="SearchPopupListBox_SelectionChanged" PreviewKeyDown="SearchPopupListBox_PreviewKeyDown">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ItemBorder"
                                                                    Background="Transparent"
                                                                    CornerRadius="5"
                                                                    Padding="8,0"
                                                                    Height="32">
                                                                <ContentPresenter VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushListViewItemSelectedBG}" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="32">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="16" Height="16" Margin="4,0,8,0" VerticalAlignment="Center">
                                                        <Path Data="{Binding IconGeometry}" Fill="{DynamicResource BrushAccent}" Stretch="Uniform"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" Foreground="{DynamicResource BrushTextMain}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmallPlus}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            <TextBlock Grid.Column="1" 
                                       Text="搜索设置项..." 
                                       Foreground="#FF555555" 
                                       VerticalAlignment="Center" 
                                       IsHitTestVisible="False"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SettingsSearchText}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SettingsSearchBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                             Style="{StaticResource SidebarListBoxStyle}"
                             ItemContainerStyle="{DynamicResource GlobalListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20"
                                            Height="20"
                                            Background="Transparent"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0">
                                        <Path x:Name="IconPath"
                                              Data="{Binding IconGeometry}"
                                              Fill="{DynamicResource BrushTextSec}"
                                              Opacity="0.7"
                                              Stretch="Uniform" 
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{Binding Title}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               Margin="12,0,0,0" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="IconPath" Property="Fill" Value="{DynamicResource BrushAccent}" />
                                        <Setter TargetName="IconPath" Property="Opacity" Value="1.0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="IconPath" Property="Opacity" Value="0.9" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Content Area (Right) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Top Bar -->
                    <RowDefinition Height="*" />    <!-- Main Content -->
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Grid Grid.Row="0" Margin="15,10,15,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>



                    <Button Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Padding="16,6"
                            Content="重启更新"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="RestartToUpdateButton_Click"
                            Visibility="{Binding IsUpdateReadyToRestart, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF3B82F6" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" 
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="14" 
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#FF2563EB" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#FF1D4ED8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <ScrollViewer x:Name="MainContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsNormalSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="30,10,30,30">
                        
                        <!-- General Settings View -->
                        <StackPanel x:Name="GeneralSectionRoot" Visibility="{Binding IsGeneralSelected, Converter={StaticResource BooleanToVisibilityConverter}}">

                            
                            <Grid Margin="0,5">
                                <TextBlock Text="主题模式" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center"/>
                                <ComboBox Width="120" Height="36" HorizontalAlignment="Right" 
                                          Style="{DynamicResource GlobalComboBoxStyle}"
                                          SelectedValue="{Binding ThemeMode, Mode=TwoWay}" 
                                          SelectedValuePath="Tag"
                                          SelectionChanged="ThemeModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                                    <ComboBoxItem Content="深色" Tag="Dark"/>
                                    <ComboBoxItem Content="浅色" Tag="Light"/>
                                </ComboBox>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushSeparator}" Margin="0,12"/>

                            <Grid Margin="0,5">
                                <TextBlock Text="开机启动" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center"/>
                                <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" Click="SaveSettingsToggle_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12"/>

                            <Grid Margin="0,5">
                                <TextBlock Text="启动时自动检测和下载更新" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center"/>
                                <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding EnableAutoUpdate, Mode=TwoWay}" Click="SaveSettingsToggle_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12"/>

                            <Grid Margin="0,5">
                                <TextBlock Text="关闭时最小化到系统托盘" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center"/>
                                <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" Click="SaveSettingsToggle_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12"/>

                            <Grid Margin="0,5">
                                <TextBlock Text="启动后自动刷新云状态" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center"/>
                                <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding RefreshCloudOnStartup, Mode=TwoWay}" Click="SaveSettingsToggle_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12"/>

                            <Border Padding="10,8" CornerRadius="6" Tag="窗口快速排列 窗口排列快捷键">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource KeywordMatchToBrushConverter}">
                                        <Binding Path="DataContext.HighlightKeyword" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                    </MultiBinding>
                                </Border.Background>
                                <StackPanel>
                                    <Grid Margin="0,5">
                                        <TextBlock Text="窗口快速排列（鼠标靠近窗口角落时显示布局轮盘）" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center"/>
                                        <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding EnableWindowSnapAssist, Mode=TwoWay}" Click="SaveSettingsToggle_Click"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0" Visibility="{Binding EnableWindowSnapAssist, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="窗口排列快捷键" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" VerticalAlignment="Center"/>
                                        <Border x:Name="HotkeyRecorderBorder" 
                                                Grid.Column="1"
                                                Background="{DynamicResource BrushBG}"
                                                BorderThickness="1"
                                                Padding="8,0"
                                                CornerRadius="4"
                                                Width="140"
                                                Height="28"
                                                Focusable="True"
                                                MouseDown="HotkeyRecorderBorder_MouseDown"
                                                PreviewKeyDown="HotkeyRecorderBorder_PreviewKeyDown"
                                                LostFocus="HotkeyRecorderBorder_LostFocus"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#FF3B82F6"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="HotkeyText" 
                                                           Text="{Binding WindowSnapAssistHotkey, TargetNullValue='--'}"
                                                           Foreground="{DynamicResource BrushTextMain}"
                                                           FontSize="{DynamicResource FontSizeSmallPlus}"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" 
                                                        Content="×" 
                                                        FontSize="14"
                                                        Foreground="{DynamicResource BrushTextSec}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        Click="ClearSnapAssistHotkey_Click"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="主程序快捷键" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                            <TextBlock Text="用于呼出或隐藏启动器。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border x:Name="LauncherHotkeyRecorderBorder"
                                                Grid.Column="1"
                                                Background="{DynamicResource BrushBG}"
                                                BorderThickness="1"
                                                Padding="8,0"
                                                CornerRadius="4"
                                                Width="140"
                                                Height="28"
                                                Focusable="True"
                                                MouseDown="LauncherHotkeyRecorderBorder_MouseDown"
                                                LostFocus="LauncherHotkeyRecorderBorder_LostFocus"
                                                PreviewKeyDown="LauncherHotkeyRecorderBorder_PreviewKeyDown"
                                                PreviewKeyUp="LauncherHotkeyRecorderBorder_PreviewKeyUp"
                                                Cursor="Hand"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#FF3B82F6"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="LauncherHotkeyText"
                                                           Text="{Binding LauncherHotkey, TargetNullValue='--'}"
                                                           Foreground="{DynamicResource BrushTextMain}"
                                                           FontSize="{DynamicResource FontSizeSmallPlus}"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Content="×"
                                                        FontSize="14"
                                                        Foreground="{DynamicResource BrushTextSec}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Center"
                                                        Margin="4,0,0,0"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        Click="ClearLauncherHotkey_Click"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="主程序快捷键修改后会立即重新注册。支持常规组合键，也支持录制 DoubleCtrl / DoubleAlt。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="本地 Agent API" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                            <TextBlock Text="允许外部 Agent 读取/修改扩展数据及控制启动器。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding EnableAgentApi, Mode=TwoWay}" Click="SaveSettingsToggle_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Visibility="{Binding EnableAgentApi, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="#FF22C55E" VerticalAlignment="Center"/>
                                                <TextBlock Text="本地 API 服务运行中，端口: " Foreground="#FF22C55E" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="Medium" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding AgentApiPort}" Foreground="#FF22C55E" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="打开 API 控制台" Style="{StaticResource SecondaryBtn}" Height="28" Padding="14,0" Click="OpenApiDocsUrlButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="说明" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                    <TextBlock Text="基础行为设置会在保存后立即生效。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- AI Settings Grid Moved -->

                        <StackPanel x:Name="EnvironmentSectionRoot" Visibility="{Binding IsEnvironmentSelected, Converter={StaticResource BooleanToVisibilityConverter}}">


                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="用户环境变量" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                            <TextBlock Text="供脚本扩展和 WebView 应用读取。适合保存 NOTION_TOKEN、NOTION_DATABASE_ID 等第三方服务 Key。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="添加变量" Style="{StaticResource SecondaryBtn}" Height="30" Padding="12,0" Click="AddEnvironmentVariableButton_Click"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding EnvironmentVariables}" Margin="0,16,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrushBG}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="14"/>
                                                            <ColumnDefinition Width="1.8*"/>
                                                            <ColumnDefinition Width="14"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="名称" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"/>
                                                        <TextBlock Grid.Column="2" Text="值" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"/>
                                                        <TextBlock Grid.Column="4" Text="说明" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"/>

                                                        <TextBox Grid.Row="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,6,0,0" Padding="10,7" VerticalContentAlignment="Center"/>
                                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,6,0,0" Padding="10,7" VerticalContentAlignment="Center"/>
                                                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,6,0,0" Padding="10,7" VerticalContentAlignment="Center"/>
                                                        <Button Grid.Row="1" Grid.Column="5" Content="删除" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0" Margin="12,6,0,0" Click="RemoveEnvironmentVariableButton_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding EnvironmentStatusText}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="保存环境变量" Style="{StaticResource PrimaryBtn}" Height="32" Padding="14,0" Click="SaveEnvironmentVariablesButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Sync View -->
                        <StackPanel x:Name="SyncSectionRoot" Visibility="{Binding IsSyncSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Header with Status Badge -->
                            <Grid Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="同步与备份" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"/>
                                    <TextBlock Text="管理您的数据备份与多设备同步配置" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" 
                                        Background="#1A22C55E" 
                                        BorderBrush="#3322C55E" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#FF22C55E" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LastSyncStatusTextBlock" Text="上次同步: 刚刚" Foreground="#FF22C55E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Account object sync status -->
                            <Border Background="{DynamicResource BrushBG}" CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,0,16" Padding="18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="账号配置同步" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormalPlus}" FontWeight="SemiBold"/>
                                                <Border Background="#1A3B82F6" BorderBrush="#553B82F6" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding AccountSyncStatus.ModeText}" Foreground="#FF60A5FA" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AccountSyncStatus.ExplanationText}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="刷新并同步" Style="{StaticResource SecondaryBtn}" Height="30" Padding="12,0" Click="RefreshAccountObjectSyncButton_Click"/>
                                    </Grid>

                                    <UniformGrid Columns="4" Margin="0,16,0,0">
                                        <Border Background="#0AFFFFFF" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="同步健康" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"/>
                                                <TextBlock Text="{Binding AccountSyncStatus.HealthText}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FF22C55E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AccountSyncStatus.HasPending}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFF59E0B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AccountSyncStatus.HasErrors}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFEF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0AFFFFFF" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="2,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="远端版本" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"/>
                                                <TextBlock Text="{Binding AccountSyncStatus.RevisionText}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0AFFFFFF" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="4,0,2,0">
                                            <StackPanel>
                                                <TextBlock Text="同步队列" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"/>
                                                <TextBlock Text="{Binding AccountSyncStatus.ObjectCountText}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0AFFFFFF" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="最后同步" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"/>
                                                <TextBlock Text="{Binding AccountSyncStatus.LastCheckedText}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <ItemsControl ItemsSource="{Binding AccountSyncStatus.Objects}" Margin="0,14,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="4,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.4*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.6*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="Medium"/>
                                                            <TextBlock Text="{Binding ObjectId}" Foreground="{DynamicResource BrushTextSec}" FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#FF22C55E"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPending}" Value="True"><Setter Property="Foreground" Value="#FFF59E0B"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="#FFEF4444"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasConflict}" Value="True"><Setter Property="Foreground" Value="#FFEF4444"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" Text="{Binding Revision, StringFormat=rev {0}}" Foreground="{DynamicResource BrushTextSec}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}"/>
                                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right">
