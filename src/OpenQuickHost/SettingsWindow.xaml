                                                    <Grid Margin="0,0,8,0">
                                                        <Border x:Name="ExtensionSearchAnchor"
                                                                Height="30"
                                                                Background="{DynamicResource BrushBG}"
                                                                BorderBrush="{DynamicResource BrushBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <Path Data="{local:IconGeometry search}" Fill="{DynamicResource BrushTextSec}" Stretch="Uniform"/>
                                                                </Viewbox>
                                                                <TextBox Grid.Column="1"
                                                                         x:Name="ExtensionSearchBox"
                                                                         Text="{Binding ExtensionSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         Foreground="{DynamicResource BrushTextMain}"
                                                                         CaretBrush="White"
                                                                         VerticalContentAlignment="Center"
                                                                         ToolTip="搜索扩展；不输入时显示全部扩展"
                                                                         GotKeyboardFocus="MouseGestureExtensionSearchBox_GotKeyboardFocus"
                                                                         TextChanged="MouseGestureExtensionSearchBox_TextChanged"
                                                                         PreviewKeyDown="MouseGestureExtensionSearchBox_PreviewKeyDown"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="搜索扩展..."
                                                                           Foreground="#FF666666"
                                                                           VerticalAlignment="Center"
                                                                           IsHitTestVisible="False"
                                                                           Margin="2,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Text, ElementName=ExtensionSearchBox}" Value="">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <Popup PlacementTarget="{Binding ElementName=ExtensionSearchAnchor}"
                                                               Placement="Bottom"
                                                               AllowsTransparency="True"
                                                               PopupAnimation="Slide"
                                                               StaysOpen="False"
                                                               IsOpen="{Binding IsExtensionPopupOpen, Mode=TwoWay}">
                                                            <Border Width="{Binding ActualWidth, ElementName=ExtensionSearchAnchor}"
                                                                    MaxHeight="260"
                                                                    Margin="0,4,0,0"
                                                                    Background="{DynamicResource BrushBG}"
                                                                    BorderBrush="{DynamicResource BrushBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    SnapsToDevicePixels="True">
                                                                <ListBox ItemsSource="{Binding FilteredExtensionOptions}"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         Foreground="{DynamicResource BrushTextMain}"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                         PreviewKeyDown="MouseGestureExtensionListBox_PreviewKeyDown"
                                                                         MouseDoubleClick="MouseGestureExtensionListBox_MouseDoubleClick"
                                                                         MouseLeftButtonUp="MouseGestureExtensionListBox_PreviewMouseLeftButtonUp">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MouseGestureExtensionOptionTemplate}"/>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                    <Button Grid.Column="1" Content="绑定扩展" Style="{StaticResource SecondaryBtn}" Height="30" Padding="10,0" Click="BindCommonMouseGestureButton_Click"/>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Margin="0,0,8,0">
                                                        <Border x:Name="AppSearchAnchor"
                                                                Height="30"
                                                                Background="{DynamicResource BrushBG}"
                                                                BorderBrush="{DynamicResource BrushBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <Path Data="{local:IconGeometry search}" Fill="{DynamicResource BrushTextSec}" Stretch="Uniform"/>
                                                                </Viewbox>
                                                                <TextBox Grid.Column="1"
                                                                         x:Name="AppSearchBox"
                                                                         Text="{Binding AppSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         Foreground="{DynamicResource BrushTextMain}"
                                                                         CaretBrush="White"
                                                                         VerticalContentAlignment="Center"
                                                                         ToolTip="搜索应用；不输入时显示全部应用"
                                                                         GotKeyboardFocus="MouseGestureAppSearchBox_GotKeyboardFocus"
                                                                         TextChanged="MouseGestureAppSearchBox_TextChanged"
                                                                         PreviewKeyDown="MouseGestureAppSearchBox_PreviewKeyDown"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="搜索应用..."
                                                                           Foreground="#FF666666"
                                                                           VerticalAlignment="Center"
                                                                           IsHitTestVisible="False"
                                                                           Margin="2,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Text, ElementName=AppSearchBox}" Value="">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <Popup PlacementTarget="{Binding ElementName=AppSearchAnchor}"
                                                               Placement="Bottom"
                                                               AllowsTransparency="True"
                                                               PopupAnimation="Slide"
                                                               StaysOpen="False"
                                                               IsOpen="{Binding IsAppPopupOpen, Mode=TwoWay}">
                                                            <Border Width="{Binding ActualWidth, ElementName=AppSearchAnchor}"
                                                                    MaxHeight="260"
                                                                    Margin="0,4,0,0"
                                                                    Background="{DynamicResource BrushBG}"
                                                                    BorderBrush="{DynamicResource BrushBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    SnapsToDevicePixels="True">
                                                                <ListBox ItemsSource="{Binding FilteredAppOptionsView}"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         Foreground="{DynamicResource BrushTextMain}"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                         PreviewKeyDown="MouseGestureAppListBox_PreviewKeyDown"
                                                                         MouseDoubleClick="MouseGestureAppListBox_MouseDoubleClick"
                                                                         MouseLeftButtonUp="MouseGestureAppListBox_PreviewMouseLeftButtonUp">
                                                                    <ListBox.GroupStyle>
                                                                        <GroupStyle>
                                                                            <GroupStyle.HeaderTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Background="{DynamicResource BrushSecondaryBtnBG}" Padding="10,6,10,4">
                                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"/>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </GroupStyle.HeaderTemplate>
                                                                        </GroupStyle>
                                                                    </ListBox.GroupStyle>
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MouseGestureAppOptionTemplate}"/>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                    <Button Grid.Column="1" Content="绑定应用" Style="{StaticResource PrimaryBtn}" Height="30" Padding="10,0" Click="BindCommonMouseGestureAppButton_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Radial View -->
                        <StackPanel x:Name="RadialSectionRoot" Visibility="{Binding IsRadialSelected, Converter={StaticResource BooleanToVisibilityConverter}}">


                            <Grid Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="游戏轮盘模式" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}"/>
                                    <TextBlock Text="{Binding RadialMenuSummary}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Content="保存配置" Style="{StaticResource PrimaryBtn}" Height="32" Padding="16,0" HorizontalAlignment="Right" Click="SaveQuickPanelTrigger_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12"/>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="启用燕环" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="键盘触发" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding RadialActivationKeyOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding RadialActivationKey, Mode=TwoWay}"
                                                  Width="150"
                                                  Height="30"
                                                  SelectionChanged="SaveQuickPanelTrigger_Click"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding RadialUsesCustomShortcut, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="自定义快捷键" Foreground="#FFB8B8B8" FontSize="{DynamicResource FontSizeSmallPlus}"/>
                                            <Button Grid.Column="1"
                                                    Content="录制快捷键"
                                                    Style="{StaticResource SecondaryBtn}"
                                                    Height="28"
                                                    Padding="14,0"
                                                    Click="EditRadialHotkeyButton_Click"/>
                                        </Grid>
                                        <TextBox Text="{Binding RadialCustomShortcut, Mode=TwoWay}"
                                                 Margin="0,6,0,0"
                                                 Height="34"
                                                 IsReadOnly="True"
                                                 Background="{DynamicResource BrushBG}"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource BrushTextMain}"
                                                 Padding="10,6"/>
                                    </StackPanel>
                                    <CheckBox Content="按住触发键呼出燕环，松开执行"
                                              Foreground="{DynamicResource BrushTextMain}"
                                              FontSize="{DynamicResource FontSizeSmallPlus}"
                                              Margin="0,8,0,0"
                                              IsChecked="{Binding EnableRadialCapsLockHold, Mode=TwoWay}"
                                              Click="SaveQuickPanelTrigger_Click"/>

                                    <TextBlock Text="鼠标触发"
                                               Foreground="#FFB8B8B8"
                                               FontSize="{DynamicResource FontSizeSmallPlus}"
                                               Margin="0,12,0,0"/>
                                    <Border Margin="0,6,0,0"
                                            Background="{DynamicResource BrushBG}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,9">
                                        <TextBlock Text="{Binding RadialAssignedMouseTriggerSummary}"
                                                   Foreground="{DynamicResource BrushTextMain}"
                                                   FontSize="{DynamicResource FontSizeSmallPlus}"/>
                                    </Border>
                                    <TextBlock Text="鼠标触发统一在“鼠标触发”页分配，这里只展示当前结果。"
                                               Foreground="{DynamicResource BrushTextSec}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15" Margin="0,18,0,0">
                                <StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="当前轮盘" Foreground="#FFB8B8B8" FontSize="{DynamicResource FontSizeSmallPlus}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="RadialMenuPageComboBox"
                                                      Width="180"
                                                      Height="30"
                                                      ItemsSource="{Binding RadialMenuPages}"
                                                      SelectionChanged="RadialMenuPageComboBox_SelectionChanged"
                                                      ToolTip="滚轮会在 1 级顶层轮盘之间切换">
                                                 <ComboBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{Binding IndentMargin}">
                                                             <Image Source="{Binding Icon}" 
                                                                    Width="16" 
                                                                    Height="16" 
                                                                    Margin="0,0,6,0" 
                                                                    VerticalAlignment="Center">
                                                                 <Image.Style>
                                                                     <Style TargetType="Image">
                                                                         <Style.Triggers>
                                                                             <Trigger Property="Source" Value="{x:Null}">
                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                             </Trigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Image.Style>
                                                             </Image>
                                                             <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                         </StackPanel>
                                                     </DataTemplate>
                                                 </ComboBox.ItemTemplate>
                                             </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="新增轮盘" Style="{StaticResource SecondaryBtn}" Height="28" Padding="14,0" Margin="0,0,8,0" Click="AddRadialMenuPageButton_Click"/>
                                            <Button Content="删除轮盘" Style="{StaticResource SecondaryBtn}" Height="28" Padding="14,0" Click="DeleteRadialMenuPageButton_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="390"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="360"
                                                Height="360"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="0"
                                                CornerRadius="180">
                                            <Canvas Width="360" Height="360">
                                                <Ellipse Width="360"
                                                         Height="360"
                                                         Fill="{DynamicResource BrushRadialOuterBG}"
                                                         Stroke="{DynamicResource BrushRadialBorder}"
                                                         StrokeThickness="1"
                                                         Canvas.Left="0"
                                                         Canvas.Top="0"/>

                                                <Ellipse Width="226"
                                                         Height="226"
                                                         Fill="Transparent"
                                                         Stroke="{DynamicResource BrushRadialBorder}"
                                                         StrokeThickness="1"
                                                         Canvas.Left="67"
                                                         Canvas.Top="67"/>

                                                <Ellipse Width="226"
                                                         Height="226"
                                                         Fill="Transparent"
                                                         Stroke="{DynamicResource BrushRadialBorderActive}"
                                                         StrokeThickness="1.5"
                                                         Canvas.Left="67"
                                                         Canvas.Top="67"
                                                         IsHitTestVisible="False"/>

                                                <ItemsControl ItemsSource="{Binding RadialMenuPreviewSeparators}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{DynamicResource BrushRadialBorderSec}" StrokeThickness="1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Width="70"
                                                        Height="70"
                                                        Canvas.Left="145"
                                                        Canvas.Top="145"
                                                        Background="#01000000"
                                                        CornerRadius="35"
                                                        ToolTip="右键或双击重命名当前轮盘"
                                                        MouseLeftButtonDown="RadialMenuCenter_MouseLeftButtonDown"
                                                        MouseRightButtonDown="RadialMenuCenter_MouseRightButtonDown">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="重命名当前轮盘" Click="RenameRadialMenuPageMenuItem_Click"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Ellipse Fill="{DynamicResource BrushRadialCenterBG}"
                                                                 Stroke="{DynamicResource BrushRadialBorderActive}"
                                                                 StrokeThickness="1"
                                                                 IsHitTestVisible="False"/>
                                                        <TextBlock Text="{Binding SelectedRadialMenuPageName}"
                                                                   TextAlignment="Center"
                                                                   Foreground="{DynamicResource BrushTextMain}"
                                                                   FontSize="{DynamicResource FontSizeNormalPlus}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="6,0"
                                                                   IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding RadialMenuSlots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Path Data="{Binding SectorGeometry}"
                                                                  Stroke="{DynamicResource BrushRadialSlotBorder}"
                                                                  StrokeThickness="1"
                                                                  Fill="Transparent"
                                                                  MouseLeftButtonDown="RadialSlot_MouseLeftButtonDown"
                                                                  MouseRightButtonDown="RadialSlot_MouseRightButtonDown"
                                                                  MouseEnter="RadialSlot_MouseEnter"
                                                                  MouseLeave="RadialSlot_MouseLeave"
                                                                  AllowDrop="True"
                                                                  DragOver="RadialSlot_DragOver"
                                                                  Drop="RadialSlot_Drop">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource BrushRadialSlotHover}"/>
                                                                                <Setter Property="Stroke" Value="{DynamicResource BrushRadialSlotHoverBorder}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl ItemsSource="{Binding RadialMenuSlots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding SlotWidth}"
                                                                    Height="{Binding SlotHeight}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="{Binding SlotPadding}"
                                                                    AllowDrop="True"
                                                                    MouseLeftButtonDown="RadialSlot_MouseLeftButtonDown"
                                                                    MouseRightButtonDown="RadialSlot_MouseRightButtonDown"
                                                                    MouseEnter="RadialSlot_MouseEnter"
                                                                    MouseLeave="RadialSlot_MouseLeave"
                                                                    DragOver="RadialSlot_DragOver"
                                                                    Drop="RadialSlot_Drop">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="添加扩展/应用/系统项" Click="RadialSlotAddCommandMenuItem_Click"/>
                                                                        <MenuItem Header="设置模拟按键" Click="RadialSlotSetSimulatedKeyMenuItem_Click"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="进入子环编辑" Click="RadialSlotEnterChildPageMenuItem_Click"/>
                                                                        <MenuItem Header="添加子环" Click="RadialSlotAddChildPageMenuItem_Click"/>
                                                                        <MenuItem Header="删除" Click="RadialSlotDeleteMenuItem_Click"/>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="➕"
                                                                                   Foreground="{DynamicResource BrushRadialTextMuted}"
                                                                                   FontSize="{Binding PlusFontSize}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <!-- Show ➕ when empty and hovered -->
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding IsEmpty}" Value="True"/>
                                                                                                <Condition Binding="{Binding IsHovered}" Value="True"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        
                                                                        <!-- Show normal content for filled slots -->
                                                                        <StackPanel Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <Border Width="{Binding IconContainerSize}"
                                                                                    Height="{Binding IconContainerSize}"
                                                                                    CornerRadius="{Binding IconCornerRadius}"
                                                                                    Background="{Binding AccentBrush}"
                                                                                    HorizontalAlignment="Center"
                                                                                    Visibility="{Binding HasPresentationIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <Grid ClipToBounds="True">
                                                                                    <Image Source="{Binding IconSource}"
                                                                                           Stretch="UniformToFill"
                                                                                           Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                    <Viewbox Width="{Binding VectorIconSize}"
                                                                                             Height="{Binding VectorIconSize}"
                                                                                             Stretch="Uniform"
                                                                                             HorizontalAlignment="Center"
                                                                                             VerticalAlignment="Center"
                                                                                             Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                                                    </Viewbox>
                                                                                    <TextBlock Text="{Binding DisplayGlyph}"
                                                                                               Foreground="White"
                                                                                               FontSize="{Binding GlyphFontSize}"
                                                                                               FontWeight="SemiBold"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"
                                                                                               Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Label}"
                                                                                       Foreground="{DynamicResource BrushAccent}"
                                                                                       FontWeight="SemiBold"
                                                                                       HorizontalAlignment="Center"
                                                                                       FontSize="{DynamicResource FontSizeTiny}"
                                                                                       >
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasPresentationIcon}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Text="{Binding ExtensionTitle}"
                                                                                       Foreground="{DynamicResource BrushTextMain}"
                                                                                       FontSize="{DynamicResource FontSizeTiny}"
                                                                                       Margin="0,5,0,0"
                                                                                       TextAlignment="Center"
                                                                                       Width="{Binding TitleWidth}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="把右侧扩展拖到这里"/>
                                                                            <TextBlock Text="{Binding ChildPageTitle}"
                                                                                       Foreground="{DynamicResource BrushTextSec}"
                                                                                       FontSize="{DynamicResource FontSizeTiny}"
                                                                                       Margin="0,3,0,0"
                                                                                       TextAlignment="Center"
                                                                                       Width="{Binding TitleWidth}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       Visibility="{Binding HasChildPageTitle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                       ToolTip="子环入口"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                        </Border>

                                        <Border Grid.Column="1" Background="{DynamicResource BrushBG}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="添加到轮盘" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="拖拽到轮盘进行添加" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBox x:Name="RadialMenuSearchBox"
                                                                 Text="{Binding RadialMenuSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30"
                                                                 Padding="10,4"
                                                                 ToolTip="搜索扩展、应用、系统设置项。按 ↓ 选择，Enter 添加到当前槽位。"
                                                                 PreviewKeyDown="RadialMenuSearchBox_PreviewKeyDown"/>
                                                        <TextBlock Text="扩展、程序、系统设置..."
                                                                   Foreground="{DynamicResource BrushTextSec}"
                                                                   Opacity="0.5"
                                                                   FontSize="{DynamicResource FontSizeSmallPlus}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,0,0"
                                                                   IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=RadialMenuSearchBox}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </StackPanel>
                                                <ListBox Grid.Row="1"
                                                         Height="310"
                                                         ItemsSource="{Binding FilteredRadialMenuCommandOptions}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{DynamicResource BrushTextMain}"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         PreviewMouseWheel="RadialMenuCommandListBox_PreviewMouseWheel"
                                                         PreviewKeyDown="RadialMenuCommandListBox_PreviewKeyDown"
                                                         MouseDoubleClick="RadialMenuCommandListBox_MouseDoubleClick">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource BrushSecondaryBtnBG}"
                                                                        BorderBrush="#1AFFFFFF"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="8"
                                                                        Margin="0,0,0,6"
                                                                        Cursor="Hand"
                                                                        PreviewMouseMove="RadialExtensionDragStart_MouseMove">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Width="28" Height="28" CornerRadius="7" Background="{Binding AccentBrush}" Margin="0,0,8,0">
                                                                            <Grid>
                                                                                <Image Source="{Binding IconSource}" Width="22" Height="22" Stretch="Uniform" Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                <Viewbox Width="18" Height="18" Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                                                </Viewbox>
                                                                                <TextBlock Text="{Binding DisplayGlyph}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeTiny}" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="进程白名单" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                    <TextBlock Text="留空表示所有程序都能触发燕环；填写后只对这些进程生效。支持 code、notepad.exe 和 * 通配。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding RadialWhitelistedProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="70"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Button Content="🎯 定位窗口添加" Style="{StaticResource SecondaryBtn}" Height="28" Padding="14,0" Click="PickRadialWhitelistProcessButton_Click"/>
                                            <Button Content="保存白名单" Style="{StaticResource SecondaryBtn}" Height="28" Padding="14,0" Margin="0,8,0,0" Click="SaveQuickPanelTrigger_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="进程黑名单" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                    <TextBlock Text="当白名单为空时，这些进程会被排除。适合游戏、全屏软件或不希望触发燕环的窗口。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding RadialBlacklistedProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="70"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Button Content="🎯 定位窗口添加" Style="{StaticResource SecondaryBtn}" Height="28" Padding="14,0" Click="PickRadialBlacklistProcessButton_Click"/>
                                            <Button Content="保存黑名单" Style="{StaticResource SecondaryBtn}" Height="28" Padding="14,0" Margin="0,8,0,0" Click="SaveQuickPanelTrigger_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Yarn Select View -->
                        <StackPanel x:Name="YarnSelectSectionRoot" Visibility="{Binding IsYarnSelectSelected, Converter={StaticResource BooleanToVisibilityConverter}}">


                            <Grid Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="选中即操作" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}"/>
                                    <TextBlock Text="{Binding YarnSelectSummary}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Content="保存" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Click="SaveYarnSelectSettings_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12"/>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="启用燕选" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}"/>
                                            <TextBlock Text="按住鼠标左键选择内容时，继续按字母或鼠标键触发动作。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding EnableYarnSelect, Mode=TwoWay}" Click="SaveYarnSelectSettings_Click"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{DynamicResource BrushTextMain}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="规则列表" Foreground="#FFB8B8B8" FontSize="{DynamicResource FontSizeSmallPlus}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="新增规则" Style="{StaticResource SecondaryBtn}" Height="28" Padding="14,0" Margin="0,0,8,0" Click="AddYarnSelectRuleButton_Click"/>
                                            <Button Content="恢复默认" Style="{StaticResource SecondaryBtn}" Height="28" Padding="14,0" Click="ResetYarnSelectRulesButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding YarnSelectRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="52"/>
                                                            <ColumnDefinition Width="86"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding TriggerKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 Height="30"
                                                                 Margin="0,0,8,0"
                                                                 ToolTip="填写单个字母/数字，或 Right、X1、X2"/>
                                                        <ComboBox Grid.Column="2"
                                                                  Height="30"
                                                                  Margin="0,0,8,0"
                                                                  ItemsSource="{Binding DataContext.YarnSelectActionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValuePath="Value"
                                                                  SelectedValue="{Binding ActionType, Mode=TwoWay}"/>
                                                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                                            <TextBox Text="{Binding ExtensionSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Height="30"
                                                                     ToolTip="搜索并选择扩展。动作类型为运行扩展时，会把选中文本作为参数传入"
                                                                     GotKeyboardFocus="YarnSelectExtensionSearchBox_GotKeyboardFocus"
                                                                     TextChanged="YarnSelectExtensionSearchBox_TextChanged"
                                                                     PreviewKeyDown="YarnSelectExtensionSearchBox_PreviewKeyDown"/>
                                                            <ListBox ItemsSource="{Binding FilteredExtensionOptions}"
                                                                     MaxHeight="126"
                                                                     Margin="0,6,0,0"
                                                                     Visibility="{Binding FilteredExtensionListVisibility}"
                                                                     Background="{DynamicResource BrushBG}"
                                                                     BorderBrush="{DynamicResource BrushBorder}"
                                                                     BorderThickness="1"
                                                                     Foreground="{DynamicResource BrushTextMain}"
                                                                     PreviewKeyDown="YarnSelectExtensionListBox_PreviewKeyDown"
                                                                     MouseDoubleClick="YarnSelectExtensionListBox_MouseDoubleClick">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="30"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Width="24"
                                                                                    Height="24"
                                                                                    CornerRadius="6"
                                                                                    Background="{Binding AccentBrush}"
                                                                                    ClipToBounds="True"
                                                                                    VerticalAlignment="Center">
                                                                                <Grid>
                                                                                    <Image Source="{Binding IconSource}"
                                                                                           Stretch="UniformToFill"
                                                                                           Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                    <Viewbox Width="14"
                                                                                             Height="14"
                                                                                             Stretch="Uniform"
                                                                                             Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                                                    </Viewbox>
                                                                                    <TextBlock Text="{Binding DisplayGlyph}"
                                                                                               Foreground="{DynamicResource BrushTextMain}"
                                                                                               FontSize="{DynamicResource FontSizeSmall}"
                                                                                               FontWeight="SemiBold"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"
                                                                                               Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}"/>
                                                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeTiny}" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </StackPanel>
                                                        <TextBox Grid.Column="4"
                                                                 Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30"
                                                                 Margin="0,0,8,0"
                                                                 ToolTip="备注"/>
                                                        <Button Grid.Column="5"
                                                                Content="删除"
                                                                Style="{StaticResource SecondaryBtn}"
                                                                Height="28"
                                                                Padding="14,0"
                                                                Click="DeleteYarnSelectRuleButton_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="进程白名单" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" Margin="0,20,0,10"/>
                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="留空表示所有程序都生效；填写后只对这些进程生效。多个进程用逗号或换行分隔，可填 code、excel、photoshop 或 xxx.exe。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding YarnSelectWhitelistedProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,10,0,0"
                                             MinHeight="70"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="🎯 定位窗口添加" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="PickYarnSelectWhitelistProcessButton_Click"/>
                                        <Button Content="保存白名单" Style="{StaticResource SecondaryBtn}" Click="SaveYarnSelectSettings_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="进程黑名单" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" Margin="0,20,0,10"/>
                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="当白名单为空时，这里的进程会被排除；多个进程用逗号或换行分隔。可填写 code、excel、photoshop 或 xxx.exe。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding YarnSelectBlacklistedProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,10,0,0"
                                             MinHeight="70"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="🎯 定位窗口添加" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="PickYarnSelectBlacklistProcessButton_Click"/>
                                        <Button Content="保存黑名单" Style="{StaticResource SecondaryBtn}" Click="SaveYarnSelectSettings_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="使用方式：拖拽选中文字后不要松开左键，直接按 C / S / R 等按键。第一次使用建议先在普通文本框中测试。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>

                        <!-- Extensions View -->
                        <Grid x:Name="ExtensionsSectionRoot" Visibility="{Binding IsExtensionsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0" x:Name="ExtensionDetailColumn" />
                            </Grid.ColumnDefinitions>

                            <!-- Main Content Area -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">


                                <!-- Top Info Card -->
                                <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding LocalExtensionSummary}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding ExtensionsRootPath}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="打开目录" Style="{StaticResource SecondaryBtn}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="OpenExtensionsFolderButton_Click"/>
                                            <Button Content="刷新" Style="{StaticResource SecondaryBtn}" Height="32" Padding="12,0" Click="RefreshExtensionStatsButton_Click" IsEnabled="{Binding CanRefreshExtensions}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Filter Tabs and Search -->
                                <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Filter Tabs -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Border x:Name="FilterAllTab" Style="{StaticResource FilterTabActiveStyle}" MouseLeftButtonDown="FilterTab_Click" Tag="all">
                                                <TextBlock Text="全部" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                            </Border>
                                            <Border x:Name="FilterPublishedTab" Style="{StaticResource FilterTabStyle}" Margin="8,0,0,0" MouseLeftButtonDown="FilterTab_Click" Tag="published">
                                                <TextBlock Text="已发布" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                            </Border>
                                            <Border x:Name="FilterDisabledTab" Style="{StaticResource FilterTabStyle}" Margin="8,0,0,0" MouseLeftButtonDown="FilterTab_Click" Tag="disabled">
                                                <TextBlock Text="已禁用" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                            </Border>
                                            <Border x:Name="FilterShortcutTab" Style="{StaticResource FilterTabStyle}" Margin="8,0,0,0" MouseLeftButtonDown="FilterTab_Click" Tag="shortcut">
                                                <TextBlock Text="快捷键" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                            </Border>
                                            <Border x:Name="FilterRecycleTab" Style="{StaticResource FilterTabStyle}" Margin="8,0,0,0" MouseLeftButtonDown="FilterTab_Click" Tag="recycle">
                                                <TextBlock Text="回收站" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Search Box -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ExtensionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34"
                                                     Padding="12,8"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip="按名称、ID、分类搜索扩展"
                                                     IsEnabled="{Binding CanRefreshExtensions}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ExtensionSearchSummary}"
                                                       Foreground="{DynamicResource BrushTextSec}"
                                                       FontSize="{DynamicResource FontSizeSmallPlus}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card Grid View -->
                                <ScrollViewer x:Name="ExtensionCardsScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="600"
                                              SizeChanged="ExtensionCardsScrollViewer_SizeChanged">
                                    <Grid Width="{Binding ViewportWidth, ElementName=ExtensionCardsScrollViewer}">
                                    <ItemsControl ItemsSource="{Binding ExtensionItems}"
                                                  Visibility="{Binding ExtensionsListVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Extension Card -->
                                                <Border Width="{Binding DataContext.ExtensionCardWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" 
                                                        Background="{DynamicResource BrushBG}" 
                                                        BorderBrush="{DynamicResource BrushBorder}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="12" 
                                                        Padding="16" 
                                                        Margin="0,0,14,14"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="ExtensionCard_Click">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="查看运行日志" Click="OpenExtensionLogMenuItem_Click">
                                                                <MenuItem.Icon>
                                                                    <Viewbox Width="14" Height="14">
                                                                        <Path Data="{local:IconGeometry file-document-outline}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" Stretch="Uniform"/>
                                                                    </Viewbox>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="编辑扩展" Click="EditExtensionButton_Click">
                                                                <MenuItem.Icon>
                                                                    <Viewbox Width="14" Height="14">
                                                                        <Path Data="{local:IconGeometry edit}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" Stretch="Uniform"/>
                                                                    </Viewbox>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="打开扩展目录" Click="OpenExtensionDirectoryButton_Click">
                                                                <MenuItem.Icon>
                                                                    <Viewbox Width="14" Height="14">
                                                                        <Path Data="{local:IconGeometry folder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" Stretch="Uniform"/>
                                                                    </Viewbox>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="删除扩展" Click="DeleteExtensionButton_Click" Foreground="#FFEF4444">
                                                                <MenuItem.Icon>
                                                                    <Viewbox Width="14" Height="14">
                                                                        <Path Data="{local:IconGeometry trash}" Fill="#FFEF4444" Stretch="Uniform"/>
                                                                    </Viewbox>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#FF4A4A4A" />
                                                                    <Setter Property="Background" Value="#FF222222" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#FF3B82F6" />
                                                                    <Setter Property="Background" Value="#FF1A1F2E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Card Header -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <!-- Icon -->
                                                            <Border Width="40" Height="40" Background="{Binding AccentBrush}" CornerRadius="10" VerticalAlignment="Top" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Source="{Binding IconSource}"
                                                                           Margin="4"
                                                                           Stretch="Uniform"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                           SnapsToDevicePixels="True"
                                                                           Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    <Viewbox Margin="7"
                                                                             Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                                    </Viewbox>
                                                                    <TextBlock Text="{Binding DisplayGlyph}"
                                                                               Foreground="{DynamicResource BrushTextMain}"
                                                                               FontSize="{DynamicResource FontSizeNormalPlus}"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Title -->
                                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" 
                                                                           Foreground="{DynamicResource BrushTextMain}" 
                                                                           FontSize="{DynamicResource FontSizeNormalPlus}" 
                                                                           FontWeight="SemiBold" 
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <!-- Toggle Switch -->
                                                            <CheckBox Grid.Column="2"
                                                                      Style="{StaticResource RaycastSwitchStyle}"
                                                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                      VerticalAlignment="Top"
                                                                      Click="ExtensionEnabledSwitch_Click"/>
                                                        </Grid>

                                                        <!-- Badges -->
                                                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                                            <Border Style="{StaticResource PublishedBadgeStyle}" Margin="0,0,6,6" Visibility="{Binding PublishedBadgeVisibility}">
                                                                <TextBlock Text="已发布" Foreground="#FF16A34A" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <Border Background="#1A3B82F6" BorderBrush="#FF3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6" Visibility="{Binding ShortcutBadgeVisibility}">
                                                                <TextBlock Text="{Binding ShortcutLabel}" Foreground="#FF3B82F6" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <!-- 开机自启徽标 -->
                                                            <Border Background="#1AEC4899" BorderBrush="#FFEC4899" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6" Visibility="{Binding AutoStartBadgeVisibility}" ToolTip="开机自启已启用">
                                                                <TextBlock Text="自启" Foreground="#FFEC4899" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <!-- 定时运行徽标 -->
                                                            <Border Background="#1A60A5FA" BorderBrush="#FF60A5FA" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6" Visibility="{Binding ScheduleBadgeVisibility}" ToolTip="{Binding ScheduleDetailLabel}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="⏰ " Foreground="#FF60A5FA" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding ScheduleDetailLabel}" Foreground="#FF60A5FA" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="#1AFBBF24" BorderBrush="#FFFBBF24" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,6">
                                                                <TextBlock Text="{Binding Category}" Foreground="#FFFBBF24" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </WrapPanel>

                                                        <!-- Card Footer -->
                                                        <Border Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                            <Border.Triggers>
                                                                <EventTrigger RoutedEvent="Border.MouseEnter">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="FooterActions" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="Border.MouseLeave">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="FooterActions" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Border.Triggers>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Version}" 
                                                                           Foreground="#FF6B7280" 
                                                                           FontSize="{DynamicResource FontSizeSmall}" 
                                                                           VerticalAlignment="Center"/>
                                                                <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal" Opacity="0">
                                                                    <Button Style="{DynamicResource GhostButtonStyle}" 
                                                                            Width="24" Height="24"
                                                                            Padding="4"
                                                                            Margin="0,0,4,0" 
                                                                            Click="EditExtensionButton_Click"
                                                                            ToolTip="编辑">
                                                                        <Viewbox Width="12" Height="12">
                                                                            <Path Data="{local:IconGeometry edit}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                        </Viewbox>
                                                                    </Button>
                                                                    <Button Style="{DynamicResource GhostButtonStyle}" 
                                                                            Width="24" Height="24"
                                                                            Padding="4"
                                                                            Margin="0,0,4,0"
                                                                            Click="OpenExtensionDirectoryButton_Click"
                                                                            ToolTip="打开目录">
                                                                        <Viewbox Width="12" Height="12">
                                                                            <Path Data="{local:IconGeometry folder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                        </Viewbox>
                                                                    </Button>
                                                                    <Button Style="{DynamicResource GhostButtonStyle}"
                                                                            Width="24" Height="24"
                                                                            Padding="4"
                                                                            Foreground="#FFEF4444"
                                                                            IsEnabled="{Binding DeleteButtonEnabled}"
                                                                            Click="DeleteExtensionButton_Click"
                                                                            ToolTip="删除扩展并移入回收站">
                                                                        <Viewbox Width="12" Height="12">
                                                                            <Path Data="{local:IconGeometry trash}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                        </Viewbox>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding RecycleBinItems}"
                                                  Visibility="{Binding RecycleBinListVisibility}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrushBG}"
                                                        BorderBrush="{DynamicResource BrushBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="14"
                                                        Margin="0,0,14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" Background="#1AEF4444" CornerRadius="9" VerticalAlignment="Center">
                                                            <Viewbox Width="16" Height="16">
                                                                <Path Data="{local:IconGeometry trash}" Fill="#FFEF4444" Stretch="Uniform"/>
                                                            </Viewbox>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding DeletedAtLabel}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <Button Content="{Binding RestoreButtonText}"
                                                                    Style="{StaticResource SecondaryBtn}"
                                                                    Height="30"
                                                                    Padding="12,0"
                                                                    Margin="0,0,8,0"
                                                                    IsEnabled="{Binding RestoreButtonEnabled}"
                                                                    Click="RestoreRecycleBinExtensionButton_Click"/>
                                                            <Button Content="{Binding DeleteButtonText}"
                                                                    Style="{StaticResource SecondaryBtn}"
                                                                    Height="30"
                                                                    Padding="12,0"
                                                                    Foreground="#FFEF4444"
                                                                    IsEnabled="{Binding DeleteButtonEnabled}"
                                                                    Click="DeleteRecycleBinExtensionButton_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Right Detail Panel -->
                            <Border Grid.Column="1" 
                                    x:Name="ExtensionDetailPanel"
                                    DataContext="{Binding SelectedExtensionItem}"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource BrushBG}" 
                                    BorderBrush="{DynamicResource BrushBorder}" 
                                    BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="48" Height="48" Background="{Binding AccentBrush}" CornerRadius="12" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding IconSource}"
                                                           Margin="5"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           SnapsToDevicePixels="True"
                                                           Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Viewbox Margin="8"
                                                             Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding DisplayGlyph}"
                                                               Foreground="{DynamicResource BrushTextMain}"
                                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeLargePlus}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border Style="{StaticResource PublishedBadgeStyle}" Margin="0,0,6,0" Visibility="{Binding PublishedBadgeVisibility}">
                                                        <TextBlock Text="已发布" Foreground="#FF16A34A" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Background="#1A3B82F6" BorderBrush="#FF3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding ShortcutBadgeVisibility}">
                                                        <TextBlock Text="{Binding ShortcutLabel}" Foreground="#FF3B82F6" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Background="#1AFBBF24" BorderBrush="#FFFBBF24" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Category}" Foreground="#FFFBBF24" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Width="28"
                                                    Height="28"
                                                    Style="{DynamicResource GhostButtonStyle}"
                                                    Click="CloseExtensionDetailPanelButton_Click"
                                                    ToolTip="关闭详情">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Data="{local:IconGeometry close}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DescriptionOrFallback}" Foreground="#FFD1D5DB" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                            <!-- ═══ 触发方式段卡 ═══ -->
                                            <TextBlock Text="触发方式" Foreground="#FF6B7280" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                            <!-- 开机自启 段卡 -->
                                            <Border Background="{DynamicResource BrushBG}" CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,0,10">
                                                <Grid Margin="14,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" Background="#1A7C3AED" CornerRadius="7" VerticalAlignment="Center">
                                                        <TextBlock Text="⚡" FontSize="{DynamicResource FontSizeNormalPlus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="开机自启" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="主程序启动后自动运行此扩展" Foreground="#FF6B7280" FontSize="{DynamicResource FontSizeSmall}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2"
                                                              Style="{StaticResource RaycastSwitchStyle}"
                                                              IsChecked="{Binding HasAppLaunchStartup, Mode=OneWay}"
                                                              VerticalAlignment="Center"
                                                              Click="ToggleExtensionStartupButton_Click"/>
                                                </Grid>
                                            </Border>

                                            <!-- 定时运行 段卡 -->
                                            <Border Background="{DynamicResource BrushBG}" CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,0,10">
                                                <Grid Margin="14,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" Background="#1A059669" CornerRadius="7" VerticalAlignment="Center">
                                                        <TextBlock Text="⏰" FontSize="{DynamicResource FontSizeNormalPlus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="定时运行" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding ScheduleDetailLabel}" Foreground="#FF6B7280" FontSize="{DynamicResource FontSizeSmall}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Content="配置"
                                                            Style="{StaticResource SecondaryBtn}"
                                                            Height="28" Padding="12,0"
                                                            VerticalAlignment="Center"
                                                            Click="ConfigureExtensionScheduleButton_Click"/>
                                                </Grid>
                                            </Border>

                                            <!-- 快捷键 段卡 -->
                                            <Border Background="{DynamicResource BrushBG}" CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,0,16">
                                                <Grid Margin="14,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" Background="#1A3B82F6" CornerRadius="7" VerticalAlignment="Center">
                                                        <TextBlock Text="⌨" FontSize="{DynamicResource FontSizeNormalPlus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="快捷键" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding ShortcutDetailLabel}" Foreground="#FF6B7280" FontSize="{DynamicResource FontSizeSmall}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Content="设置"
                                                            Style="{StaticResource SecondaryBtn}"
                                                            Height="28" Padding="12,0"
                                                            VerticalAlignment="Center"
                                                            Click="EditExtensionShortcutButton_Click"/>
                                                </Grid>
                                            </Border>

                                            <!-- ═══ 快捷操作 ═══ -->
                                            <TextBlock Text="快捷操作" Foreground="#FF6B7280" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <WrapPanel Margin="0,0,0,16">
                                                <Button Content="复制商店链接" Background="{DynamicResource BrushBG}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,8" Click="CopyExtensionStoreLinkButton_Click" Visibility="{Binding StoreLinkButtonVisibility}"/>
                                                <Button Content="打开商店链接" Background="{DynamicResource BrushBG}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,8" Click="OpenExtensionStoreLinkButton_Click" Visibility="{Binding StoreLinkButtonVisibility}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Margin="0,0,12,0"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource RaycastSwitchStyle}"
                                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                      Click="ExtensionEnabledSwitch_Click"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EnabledStateLabel}" Foreground="#FFD1D5DB" FontSize="{DynamicResource FontSizeSmallPlus}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Content="{Binding PublishButtonText}"
                                                    Style="{StaticResource SecondaryBtn}"
                                                    Margin="0,0,8,0"
                                                    Click="PublishExtensionButton_Click"
                                                    Visibility="{Binding PublishNewButtonVisibility}"
                                                    IsEnabled="{Binding PublishButtonEnabled}"/>
                                            <Button Grid.Column="2"
                                                    Content="{Binding PublishButtonText}"
                                                    Style="{StaticResource SecondaryBtn}"
                                                    Margin="0,0,8,0"
                                                    Click="PublishExtensionButton_Click"
                                                    Visibility="{Binding PublishUpdateButtonVisibility}"
                                                    IsEnabled="{Binding PublishButtonEnabled}"/>
                                            <Button Grid.Column="3"
                                                    Content="{Binding UnpublishButtonText}"
                                                    Style="{StaticResource SecondaryBtn}"
                                                    Click="UnpublishExtensionButton_Click"
                                                    Visibility="{Binding UnpublishButtonVisibility}"
                                                    IsEnabled="{Binding UnpublishButtonEnabled}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="AiSectionRoot" Grid.Row="1"
                      Margin="30,10,30,30"
                      Visibility="{Binding IsAiSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="SearchProviderTextBox"
                                 Height="36"
                                 Margin="0,0,0,10"
                                 Padding="10,8"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ProviderSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="搜索模型平台..." />
                        <ListBox Grid.Row="1"
                                 x:Name="ProvidersListBox"
                                 ItemsSource="{Binding FilteredProviders}"
                                 SelectedItem="{Binding SelectedServiceProvider, Mode=TwoWay}"
                                 Style="{StaticResource SidebarListBoxStyle}"
                                 ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#1A3B82F6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AvatarChar}"
                                                       Foreground="#FF60A5FA"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Foreground="{DynamicResource BrushTextMain}"
                                                   FontSize="{DynamicResource FontSizeSmallPlus}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0" />
                                        <Border Grid.Column="2"
                                                Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="#1A22C55E"
                                                BorderBrush="#FF22C55E"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="5,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="ON" Foreground="#FF22C55E" FontSize="8" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2"
                                Content="+ 添加提供商"
                                Style="{StaticResource SecondaryBtn}"
                                Height="38"
                                Margin="0,10,0,0"
                                VerticalAlignment="Bottom"
                                Click="AddProviderButton_Click" />
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource BrushBorder}" Width="1" VerticalAlignment="Stretch" />

                    <ScrollViewer Grid.Column="2" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" PanningMode="VerticalOnly">
                        <StackPanel>
                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16"
                                    Visibility="{Binding DataContext.SelectPromptVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Text="请在左侧选择或添加一个模型服务提供商以配置。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" HorizontalAlignment="Center" />
                            </Border>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16"
                                    DataContext="{Binding SelectedServiceProvider}"
                                    Visibility="{Binding DataContext.DetailsVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text=" 配置" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="启用平台 " Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <CheckBox Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="SaveSettingsToggle_Click" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="平台名称" Foreground="#FFB8B8B8" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,16,0,0" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" TextChanged="AiSettings_TextChanged"/>

                                    <TextBlock Text="API 密钥" Foreground="#FFB8B8B8" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,14,0,0" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" Height="36" VerticalContentAlignment="Center" Padding="10,0" TextChanged="AiSettings_TextChanged"/>
                                        <Button Grid.Column="1" Content="检测" Height="36" Margin="8,0,0,0" Style="{StaticResource SecondaryBtn}" Padding="16,0" Click="CheckApiKeyButton_Click"/>
                                    </Grid>
                                    <TextBlock Text="多个密钥使用逗号分隔 · 仅保存在本机 Windows 加密存储，不上传云端或个人仓库" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeTiny}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="API 地址" Foreground="#FFB8B8B8" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,14,0,0" />
                                    <TextBox Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" TextChanged="AiSettings_TextChanged"/>
                                    <TextBlock Text="{Binding PreviewUrl, FallbackValue=预览：http://127.0.0.1/v1/chat/completions}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeTiny}" Margin="0,4,0,0"/>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="模型列表" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text=" (" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Models.Count}" Foreground="#FF60A5FA" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text=" 个)" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="默认激活模型" Foreground="#FFB8B8B8" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,14,0,0" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" Margin="0,6,0,0" Height="36" Style="{StaticResource DarkComboBoxStyle}" VerticalContentAlignment="Center" SelectionChanged="AiModelComboBox_SelectionChanged"/>

                                    <ItemsControl ItemsSource="{Binding Models}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrushContentBG}" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="20" Height="20" CornerRadius="10" Background="#1AFF3B82" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Converter={StaticResource ModelNameFirstCharConverter}}"
                                                                       Foreground="#FFFF3B82" FontSize="9" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <Border Width="14" Height="14" CornerRadius="7" Background="#1A22C55E" ToolTip="支持视觉" Margin="0,0,3,0">
                                                                <TextBlock Text="👁" Foreground="#FF22C55E" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <Border Width="14" Height="14" CornerRadius="7" Background="#1A3B82F6" ToolTip="支持联网" Margin="0,0,3,0">
                                                                <TextBlock Text="🌐" Foreground="#FF3B82F6" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <Border Width="14" Height="14" CornerRadius="7" Background="#1AFABF2C" ToolTip="支持画图" Margin="0,0,3,0">
                                                                <TextBlock Text="☀️" Foreground="#FFFABF2C" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <Border Width="14" Height="14" CornerRadius="7" Background="#1AF97316" ToolTip="支持工具">
                                                                <TextBlock Text="🔧" Foreground="#FFF97316" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Grid.Column="3" Content="-" Width="20" Height="20" Style="{StaticResource IconButtonStyle}" Click="DeleteModelButton_Click" Tag="{Binding}" Padding="0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="管理" Style="{StaticResource SecondaryBtn}" Height="28" Padding="12,0" Click="ManageModelsButton_Click" />
                                        <Button Content="+ 添加" Style="{StaticResource SecondaryBtn}" Height="28" Padding="12,0" Margin="8,0,0,0" Click="AddNewModelButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="系统提示词配置" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="独立窗口编辑" Style="{StaticResource SecondaryBtn}" Padding="10,4" Click="EditSystemPromptInNewWindow_Click"/>
                                    </Grid>
                                    <TextBlock Text="配置 AI 助手的全局人格、工作指令和可用工具规范。修改后请点击“保存”按钮保存。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <TextBox x:Name="AiSystemPromptTextBox" Text="{Binding AiSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" Height="180" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="AiSettings_TextChanged"/>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="1" Content="重置" Style="{StaticResource SecondaryBtn}" Click="ResetSystemPromptButton_Click" Margin="0,0,10,0" />
                                        <Button Grid.Column="2" Content="保存" Style="{StaticResource PrimaryBtn}" Click="SaveAiSettingsButton_Click" IsEnabled="{Binding HasAiSettingsChanged}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Thumb Grid.ColumnSpan="2"
                   Height="6"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Cursor="SizeNS"
                   DragDelta="ResizeTopThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Height="6"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNS"
                   DragDelta="ResizeBottomThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="6"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   DragDelta="ResizeLeftThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="6"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   DragDelta="ResizeRightThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="4,4,0,0"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeTopLeftThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,4,4,0"
                   Cursor="SizeNESW"
                   DragDelta="ResizeTopRightThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="4,0,0,4"
                   Cursor="SizeNESW"
                   DragDelta="ResizeBottomLeftThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="18"
                   Height="18"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,8,8"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeBottomRightThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            
            <!-- Toast Notification -->
            <Border x:Name="ToastNotification"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,60,20,0"
                    Background="#FF22C55E"
                    CornerRadius="8"
                    Padding="16,12"
                    Visibility="Collapsed"
                    Panel.ZIndex="1000">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="12" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTransform" X="400"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                        <Path Data="{local:IconGeometry check}" Fill="White" Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock x:Name="ToastMessage" 
                               Text="已保存" 
                               Foreground="{DynamicResource BrushTextMain}" 
                               FontSize="{DynamicResource FontSizeNormal}" 
                               FontWeight="Medium"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="CloudSyncToastNotification"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,20,20"
                    Background="#FF2563EB"
                    CornerRadius="12"
                    Padding="16,14"
                    Visibility="Collapsed"
                    Panel.ZIndex="1001">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.22" BlurRadius="18" ShadowDepth="6" Direction="270"/>
                </Border.Effect>
                <StackPanel Width="240">
                    <TextBlock x:Name="CloudSyncToastMessage"
                               Text="正在同步云端配置..."
                               Foreground="White"
                               FontSize="{DynamicResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <ProgressBar x:Name="CloudSyncToastProgress"
                                 Margin="0,10,0,0"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Foreground="#FFBFDBFE"
                                 Background="#33475569"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
