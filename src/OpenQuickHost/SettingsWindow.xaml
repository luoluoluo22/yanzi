                                        <StackPanel>
                                            <TextBlock Text="扩展同步与删除状态" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PersonalExtensionSyncStatusText}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="如需重新安装已在设备间同步删除的扩展，请先从扩展回收站进行恢复。" Foreground="{DynamicResource BrushTextSec}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="20,12" Background="#0A8B5CF6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="扩展数据同步状态" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ExtensionDataSyncStatusText}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="每项扩展数据独立跟踪；如遇并发或冲突，本地配置会以冲突副本安全留存，不会被后台静默覆写。" Foreground="{DynamicResource BrushTextSec}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="20,14" Background="#12EF4444" BorderBrush="#55EF4444" BorderThickness="0,0,0,1"
                                            Visibility="{Binding HasExtensionSyncConflicts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="扩展并发冲突需要选择" Foreground="#FFF87171" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold"/>
                                            <TextBlock Text="远端版本已安全应用，本地包或删除意图已保存为冲突副本；选择前不会再次自动覆盖。" Foreground="{DynamicResource BrushTextSec}" FontSize="10" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding ExtensionSyncConflictItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#44EF4444" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ExtensionId}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding LocalText}" Foreground="#FFF59E0B" FontSize="10" Margin="0,4,0,0"/>
                                                                    <TextBlock Text="{Binding RemoteText}" Foreground="#FF60A5FA" FontSize="10" Margin="0,2,0,0"/>
                                                                    <TextBlock Foreground="{DynamicResource BrushTextSec}" FontSize="10" Margin="0,2,0,0">
                                                                        <Run Text="远端来源："/><Run Text="{Binding RemoteDeviceText}"/><Run Text=" · "/><Run Text="{Binding DetectedAtText}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                    <Button Content="采用本地" Style="{StaticResource SecondaryBtn}" Height="27" Padding="9,0" Margin="0,0,6,0" Click="UseLocalExtensionSyncConflictButton_Click"/>
                                                                    <Button Content="接受远端" Style="{StaticResource SecondaryBtn}" Height="27" Padding="9,0" Click="AcceptRemoteExtensionSyncConflictButton_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="20,14" Background="#128B5CF6" BorderBrush="#668B5CF6" BorderThickness="0,0,0,1"
                                            Visibility="{Binding HasExtensionDataConflicts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="扩展数据同步冲突处理" Foreground="#FFC4B5FD" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold"/>
                                            <TextBlock Text="检测到本地与云端数据存在冲突。您可以选择“采用本地”保留当前数据并同步，或选择“接受远端”覆写为云端数据。" Foreground="{DynamicResource BrushTextSec}" FontSize="10" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding ExtensionDataConflictItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#558B5CF6" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayId}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding LocalText}" Foreground="#FFF59E0B" FontSize="10" Margin="0,4,0,0"/>
                                                                    <TextBlock Text="{Binding RemoteText}" Foreground="#FF60A5FA" FontSize="10" Margin="0,2,0,0"/>
                                                                    <TextBlock Foreground="{DynamicResource BrushTextSec}" FontSize="10" Margin="0,2,0,0">
                                                                        <Run Text="远端来源："/><Run Text="{Binding RemoteDeviceText}"/><Run Text=" · "/><Run Text="{Binding DetectedAtText}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                    <Button Content="采用本地" Style="{StaticResource SecondaryBtn}" Height="27" Padding="9,0" Margin="0,0,6,0" Click="UseLocalExtensionDataConflictButton_Click"/>
                                                                    <Button Content="接受远端" Style="{StaticResource SecondaryBtn}" Height="27" Padding="9,0" Click="AcceptRemoteExtensionDataConflictButton_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- 子板块 1：跨后端不可变配置恢复点 -->
                                    <StackPanel>
                                        <Border Padding="20,12" Background="#05FFFFFF" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="历史备份与恢复" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding PersonalConfigRestoreStatusText}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Content="刷新恢复点" Style="{StaticResource SecondaryBtn}" Height="26" Padding="10,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Click="RefreshPersonalConfigRestorePointsButton_Click"/>
                                            </Grid>
                                        </Border>
                                        <Border Padding="20,14" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding PersonalConfigRestorePoints}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource BrushBG}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding CreatedAtText}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{Binding RevisionText}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="10,1,0,0"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,5,0,0"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                            <TextBlock Text="来源：" Foreground="{DynamicResource BrushTextSec}" FontSize="10"/>
                                                                            <TextBlock Text="{Binding DeviceText}" Foreground="{DynamicResource BrushTextSec}" FontSize="10"/>
                                                                            <TextBlock Text=" · " Foreground="{DynamicResource BrushTextSec}" FontSize="10"/>
                                                                            <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource BrushTextSec}" FontSize="10"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="恢复此点" Style="{StaticResource SecondaryBtn}" Height="28" Padding="10,0" Margin="14,0,0,0"
                                                                            VerticalAlignment="Center" Click="RestorePersonalConfigPointButton_Click"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>

                                    <!-- 子板块 2：云端提交历史 (Git 提供商) -->
                                    <StackPanel Visibility="{Binding IsGitSyncProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Padding="20,12" Background="#05FFFFFF" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="云端提交历史 (Git)" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding PersonalSyncCommitStatusText}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="访问云端仓库"
                                                            Style="{StaticResource InlineLinkButtonStyle}"
                                                            Margin="0,0,12,0"
                                                            Click="VisitPersonalSyncRepositoryButton_Click"/>
                                                    <Button Content="刷新提交"
                                                            Style="{StaticResource SecondaryBtn}"
                                                            Height="26"
                                                            Padding="10,0"
                                                            Click="RefreshPersonalSyncCommitsButton_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Padding="20,14" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                            <ItemsControl ItemsSource="{Binding PersonalSyncCommitItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BrushBG}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding ShortSha}" Foreground="#FF9CA3AF" FontSize="{DynamicResource FontSizeSmall}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                        <Button Content="打开"
                                                                                Tag="{Binding Url}"
                                                                                Style="{StaticResource InlineLinkButtonStyle}"
                                                                                Margin="8,-3,0,0"
                                                                                Click="OpenPersonalSyncCommitButton_Click"/>
                                                                        <Button Content="{Binding DiffBtnText}"
                                                                                Tag="{Binding}"
                                                                                Style="{StaticResource InlineLinkButtonStyle}"
                                                                                Margin="12,-3,0,0"
                                                                                Click="TogglePersonalSyncCommitDiff_Click"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding FriendlyMessage}" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                                    <TextBlock Text="{Binding Author}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,6,0,0"/>
                                                                    <Border Margin="0,8,0,0" 
                                                                            Background="#0D000000" 
                                                                            BorderBrush="{DynamicResource BrushBorder}" 
                                                                            BorderThickness="1" 
                                                                            CornerRadius="4" 
                                                                            Padding="8"
                                                                            Visibility="{Binding DiffVisibility}">
                                                                        <TextBox Text="{Binding DiffText, Mode=OneWay}"
                                                                                 Foreground="{DynamicResource BrushTextMain}"
                                                                                 Background="Transparent"
                                                                                 BorderThickness="0"
                                                                                 IsReadOnly="True"
                                                                                 AcceptsReturn="True"
                                                                                 TextWrapping="Wrap"
                                                                                 FontFamily="Consolas"
                                                                                 FontSize="11"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding LocalTimeLabel}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="12,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>

                                    <!-- 子板块 3：本地同步运行日志 -->
                                    <Border Padding="20,12" Background="#05FFFFFF" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="本地同步运行日志" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeSmallPlus}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Content="刷新日志" 
                                                    Style="{StaticResource SecondaryBtn}" 
                                                    Height="26" 
                                                    Padding="10,0" 
                                                    HorizontalAlignment="Right"
                                                    Click="RefreshSyncLogButton_Click"/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="20,14">
                                        <TextBox Text="{Binding SyncActivityLogText, Mode=OneWay}"
                                                 Height="140"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Background="Transparent"
                                                 BorderBrush="{DynamicResource BrushBorder}"
                                                 BorderThickness="1"
                                                 Foreground="{DynamicResource BrushTextSec}"
                                                 FontFamily="Consolas"
                                                 FontSize="{DynamicResource FontSizeSmall}"
                                                 Padding="12" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Local Backup & Restore Card -->
                            <Border Background="{DynamicResource BrushBG}" CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,16,0,0">
                                <StackPanel>
                                    <!-- Card Header -->
                                    <Border Padding="20,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="本地备份与还原" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                    </Border>
                                    
                                    <!-- Card Body -->
                                    <Border Padding="20,16">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="自动备份频率" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium" Margin="0,0,0,6"/>
                                                    <ComboBox SelectedValuePath="Tag"
                                                              SelectedValue="{Binding AutoBackupFrequency, Mode=TwoWay}"
                                                              Style="{DynamicResource GlobalComboBoxStyle}"
                                                              Height="36"
                                                              SelectionChanged="AutoBackupFrequencyComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="关闭自动备份" Tag="None"/>
                                                        <ComboBoxItem Content="每日备份一次" Tag="Daily"/>
                                                        <ComboBoxItem Content="每周备份一次" Tag="Weekly"/>
                                                        <ComboBoxItem Content="每月备份一次" Tag="Monthly"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="开启后，应用将在启动时根据设定的频率自动在后台备份您的完整数据（配置和插件扩展，日志除外）。最多保留 5 个自动备份文件，避免占用过多磁盘空间。"
                                                           Foreground="{DynamicResource BrushTextSec}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           VerticalAlignment="Bottom"
                                                           TextWrapping="Wrap"/>
                                            </Grid>

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="自动备份目录" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium" Margin="0,0,0,6"/>
                                                    <TextBox Text="{Binding CustomBackupDirectory, Mode=TwoWay}" 
                                                             Height="36" 
                                                             Padding="12,8" 
                                                             IsReadOnly="True"
                                                             VerticalContentAlignment="Center" 
                                                             Background="Transparent" 
                                                             BorderBrush="{DynamicResource BrushBorder}" 
                                                             BorderThickness="1" 
                                                             Foreground="{DynamicResource BrushTextMain}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" 
                                                        Content="选择..." 
                                                        Style="{StaticResource SecondaryBtn}" 
                                                        Height="36" 
                                                        Margin="8,22,0,0" 
                                                        VerticalAlignment="Bottom"
                                                        Click="BrowseBackupDirectoryButton_Click"/>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,16"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BackupStatusText}" 
                                                               Foreground="{DynamicResource BrushTextSec}" 
                                                               FontSize="{DynamicResource FontSizeSmall}" 
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="导入备份" Style="{StaticResource SecondaryBtn}" Height="32" Padding="16,0" Margin="0,0,8,0" Click="ImportBackupButton_Click"/>
                                                    <Button Content="立即备份" Style="{StaticResource PrimaryBtn}" Height="32" Padding="20,0" Click="CreateBackupButton_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Yanm View -->
                        <StackPanel x:Name="YanmSectionRoot" Visibility="{Binding IsYanmSelected, Converter={StaticResource BooleanToVisibilityConverter}}">


                            <Grid Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="全局信息层" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}"/>
                                    <TextBlock Text="{Binding YanmSummary}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Content="保存" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Click="SaveYanmSettings_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,12"/>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="启用燕幕" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}"/>
                                            <TextBlock Text="启用后可按住触发键临时显示信息层，或双击触发键固定进入燕幕。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding EnableYanm, Mode=TwoWay}" Click="SaveYanmSettings_Click"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{DynamicResource BrushTextMain}" Margin="0,0,0,12"/>

                                    <TextBlock Text="默认激发按键" Foreground="#FFB8B8B8" FontSize="{DynamicResource FontSizeSmallPlus}"/>
                                    <ComboBox ItemsSource="{Binding YanmActivationKeyOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding YanmActivationKey, Mode=TwoWay}"
                                              Margin="0,6,0,0"
                                              Height="36"
                                              SelectionChanged="YanmActivationKey_SelectionChanged"/>
                                    <TextBlock Text="Win 符合信息层预期，但会拦截系统开始菜单；CapsLock 更少冲突，但会改变原有大小写锁定习惯。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding YanmUsesCustomShortcut, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="自定义快捷键" Foreground="#FFB8B8B8" FontSize="{DynamicResource FontSizeSmallPlus}"/>
                                            <Button Grid.Column="1"
                                                    Content="录制快捷键"
                                                    Style="{StaticResource SecondaryBtn}"
                                                    Height="28"
                                                    Padding="14,0"
                                                    Click="EditYanmHotkeyButton_Click"/>
                                        </Grid>
                                        <TextBox Text="{Binding YanmCustomShortcut, Mode=TwoWay}"
                                                 Margin="0,6,0,0"
                                                 Height="36"
                                                 IsReadOnly="True"
                                                 Background="{DynamicResource BrushBG}"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource BrushTextMain}"
                                                 Padding="10,6"/>
                                    </StackPanel>

                                    <CheckBox Content="允许鼠标触发（右键按住移动）"
                                              Visibility="Collapsed"/>
                                    <TextBlock Text="鼠标触发"
                                               Foreground="#FFB8B8B8"
                                               FontSize="{DynamicResource FontSizeSmallPlus}"
                                               Margin="0,10,0,0"/>
                                    <Border Margin="0,6,0,0"
                                            Background="{DynamicResource BrushBG}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,9">
                                        <TextBlock Text="{Binding YanmAssignedMouseTriggerSummary}"
                                                   Foreground="{DynamicResource BrushTextMain}"
                                                   FontSize="{DynamicResource FontSizeSmallPlus}"/>
                                    </Border>
                                    <TextBlock Text="鼠标触发统一在“鼠标触发”页分配，这里只展示当前结果；键盘快捷键仍可在本页设置。"
                                               Foreground="{DynamicResource BrushTextSec}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>

                                    <Rectangle Height="1" Fill="{DynamicResource BrushTextMain}" Margin="0,14,0,12"/>

                                    <CheckBox Content="按住触发键时临时显示，松开隐藏"
                                              Foreground="{DynamicResource BrushTextMain}"
                                              FontSize="{DynamicResource FontSizeNormal}"
                                              Margin="0,0,0,10"
                                              IsChecked="{Binding YanmTriggerHold, Mode=TwoWay}"
                                              Click="SaveYanmSettings_Click"/>
                                    <CheckBox Content="双击触发键固定显示 / 取消固定"
                                              Foreground="{DynamicResource BrushTextMain}"
                                              FontSize="{DynamicResource FontSizeNormal}"
                                              IsChecked="{Binding YanmTriggerDoubleTap, Mode=TwoWay}"
                                              Click="SaveYanmSettings_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBG}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="15" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="进程白名单" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"/>
                                    <TextBlock Text="留空表示所有程序都能触发燕幕；填写后只对这些进程生效。支持 code、notepad.exe 和 * 通配。" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding YanmWhitelistedProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="70"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Button Content="🎯 定位窗口添加" Style="{StaticResource SecondaryBtn}" Height="28" Padding="14,0" Click="PickYanmWhitelistProcessButton_Click"/>
