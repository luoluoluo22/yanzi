<Window x:Class="OpenQuickHost.SkillExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出 Skill"
        Width="460"
        Height="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Border Margin="1"
            CornerRadius="0"
            Background="{DynamicResource BrushBG}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Content Separator -->
                <RowDefinition Height="*" />    <!-- Main Content -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <StackPanel>
                <TextBlock Text="导出 Skill" Style="{StaticResource TitleText}" />
                <TextBlock Margin="0,8,0,0"
                           Text="将软件内置的技能组同步到开发工具的 Skills 目录中。"
                           Style="{StaticResource DescriptionText}" />
            </StackPanel>

            <!-- 2. Main Content Section -->
            <StackPanel Grid.Row="2" Margin="0,25,0,0">
                <TextBlock Text="目标 Agent"
                           Foreground="{DynamicResource BrushTextSec}"
                           FontSize="{DynamicResource FontSizeSmallPlus}"
                           FontWeight="SemiBold"
                           Margin="2,0,0,8" />
                <ComboBox x:Name="TargetComboBox"
                          Style="{DynamicResource GlobalComboBoxStyle}"
                          Height="36"
                          SelectedIndex="0">
                    <ComboBoxItem Tag="Codex">Codex</ComboBoxItem>
                    <ComboBoxItem Tag="Antigravity">Antigravity</ComboBoxItem>
                    <ComboBoxItem Tag="Trae">Trae</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="导出作用域"
                           Foreground="{DynamicResource BrushTextSec}"
                           FontSize="{DynamicResource FontSizeSmallPlus}"
                           FontWeight="SemiBold"
                           Margin="2,18,0,8" />
                <ComboBox x:Name="ScopeComboBox"
                          Style="{DynamicResource GlobalComboBoxStyle}"
                          Height="36"
                          SelectedIndex="0">
                    <ComboBoxItem Tag="Project">项目级</ComboBoxItem>
                    <ComboBoxItem Tag="Global">全局级</ComboBoxItem>
                </ComboBox>
                
                <TextBlock Margin="2,15,0,0"
                           Text="* 项目级导出将会在下一步要求选择目标项目根目录。"
                           Foreground="{DynamicResource BrushTextSec}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 3. Footer Actions Section -->
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="取消"
                        Style="{StaticResource SecondaryBtn}"
                        Margin="0,0,6,0"
                        Click="CancelButton_Click" />
                <Button Grid.Column="1"
                        Content="开始导出"
                        Style="{StaticResource PrimaryBtn}"
                        Margin="6,0,0,0"
                        Click="ConfirmButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
