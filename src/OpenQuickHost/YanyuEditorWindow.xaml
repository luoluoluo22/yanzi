<Window x:Class="OpenQuickHost.YanyuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenQuickHost"
        xmlns:ui="clr-namespace:Yanzi.UI.Wpf;assembly=Yanzi.UI.Wpf"
        Title="{local:Term YanVoice, Suffix='编辑'}"
        Width="820"
        Height="620"
        MinWidth="680"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Style="{StaticResource DialogWindow}">
    <Border Margin="1"
            CornerRadius="0"
            Background="{DynamicResource Yanzi.Color.Background}"
            BorderBrush="{DynamicResource Yanzi.Color.Border}"
            BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="UseRegexCheckBox"
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Content="正则匹配"
                          Style="{DynamicResource Yanzi.CheckBox.Preview}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="启用" VerticalAlignment="Center"
                               Foreground="{DynamicResource Yanzi.Color.Foreground}"
                               Margin="0,0,8,0" />
                    <CheckBox x:Name="EnabledCheckBox"
                              IsChecked="True"
                              ToolTip="启用或停用这条燕语"
                              Style="{DynamicResource Yanzi.Switch.Shadcn}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="缩写词"
                                       Foreground="{DynamicResource Yanzi.Color.Foreground}"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="TriggerTextBox"
                                     Height="40"
                                     Margin="0,8,0,0"
                                     Style="{DynamicResource Yanzi.Input}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="触发后缀"
                                       Foreground="{DynamicResource Yanzi.Color.Foreground}"
                                       FontWeight="SemiBold" />
                            <ComboBox x:Name="SuffixComboBox"
                                      Height="40"
                                      Margin="0,8,0,0"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      TextSearch.TextPath="Label"
                                      Style="{DynamicResource Yanzi.Select}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <ui:YanziKbd KeyText="{Binding KbdLabel}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                            <TextBlock Text="动作类型"
                                       Foreground="{DynamicResource Yanzi.Color.Foreground}"
                                       FontWeight="SemiBold" />
                            <ComboBox x:Name="ActionTypeComboBox"
                                      Height="40"
                                      Margin="0,8,0,0"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectionChanged="ActionTypeComboBox_SelectionChanged"
                                      Style="{DynamicResource Yanzi.Select}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                            <TextBlock Text="绑定进程"
                                       Foreground="{DynamicResource Yanzi.Color.Foreground}"
                                       FontWeight="SemiBold" />
                            <ComboBox x:Name="BoundProcessBox"
                                      Height="40"
                                      Margin="0,8,0,0"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      TextSearch.TextPath="ProcessName"
                                      Style="{DynamicResource Yanzi.Select}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="16" Height="16"
                                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="可选择正在运行的进程，也可输入进程名；多个进程用逗号分隔。留空表示所有应用。"
                               Margin="2,8,0,0"
                               Foreground="{DynamicResource Yanzi.Color.MutedForeground}"
                               FontSize="{DynamicResource FontSizeSmallPlus}"
                               TextWrapping="Wrap" />

                    <Border x:Name="TextContentPanel"
                            Margin="0,20,0,0" Style="{DynamicResource Yanzi.Card}"
                            Background="{DynamicResource Yanzi.Color.Card}"
                            BorderBrush="{DynamicResource Yanzi.Color.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="文本内容"
                                       Foreground="{DynamicResource Yanzi.Color.Foreground}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="正则捕获可用 {0}、{1}、{name} 占位符。"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource Yanzi.Color.MutedForeground}"
                                       FontSize="{DynamicResource FontSizeSmallPlus}" />
                            <TextBox x:Name="TextContentBox"
                                     Margin="0,10,0,0"
                                     MinHeight="160"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{DynamicResource Yanzi.Textarea}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ExtensionPanel"
                            Margin="0,20,0,0" Style="{DynamicResource Yanzi.Card}"
                            Background="{DynamicResource Yanzi.Color.Card}"
                            BorderBrush="{DynamicResource Yanzi.Color.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="绑定小程序"
                                       Foreground="{DynamicResource Yanzi.Color.Foreground}"
                                       FontWeight="SemiBold" />
                            <Grid Margin="0,10,0,0" Height="40">
                                <TextBox x:Name="ExtensionSearchBox"
                                         Height="40"
                                         Style="{DynamicResource Yanzi.Input}"
                                         PreviewKeyDown="ExtensionSearchBox_PreviewKeyDown"
                                         TextChanged="ExtensionSearchBox_TextChanged" />
                                <Border x:Name="SelectedExtensionIcon"
                                        Width="28"
                                        Height="28"
                                        Margin="8,0,0,0"
                                        CornerRadius="7"
                                        Background="{Binding AccentBrush}"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Image Source="{Binding IconSource}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Viewbox Width="16"
                                                 Height="16"
                                                 Stretch="Uniform"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Data="{Binding VectorIcon}"
                                                  Fill="White"
                                                  Stretch="Uniform" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding DisplayGlyph}"
                                                   Foreground="{DynamicResource Yanzi.Color.Foreground}"
                                                   FontSize="{DynamicResource FontSizeNormal}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ListBox x:Name="ExtensionListBox"
                                     Margin="0,8,0,0" Style="{DynamicResource Yanzi.List}"
                                     MaxHeight="180"
                                     Visibility="Collapsed"
                                     Background="{DynamicResource Yanzi.Color.Popover}"
                                     BorderBrush="{DynamicResource BrushBorder}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource Yanzi.Color.Foreground}"
                                     ItemContainerStyle="{DynamicResource Yanzi.ListItem}"
                                     SelectionChanged="ExtensionListBox_SelectionChanged"
                                     PreviewKeyDown="ExtensionListBox_PreviewKeyDown"
                                     MouseDoubleClick="ExtensionListBox_MouseDoubleClick"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="28"
                                                    Height="28"
                                                    CornerRadius="7"
                                                    Background="{Binding AccentBrush}"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <Image Source="{Binding IconSource}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Viewbox Width="16"
                                                             Height="16"
                                                             Stretch="Uniform"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Path Data="{Binding VectorIcon}"
                                                              Fill="White"
                                                              Stretch="Uniform" />
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding DisplayGlyph}"
                                                               Foreground="{DynamicResource Yanzi.Color.Foreground}"
                                                               FontSize="{DynamicResource FontSizeNormal}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{DynamicResource Yanzi.Color.Foreground}"
                                                           FontSize="{DynamicResource FontSizeNormal}" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Foreground="{DynamicResource Yanzi.Color.MutedForeground}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="说明"
                               Margin="0,20,0,0"
                               Foreground="{DynamicResource Yanzi.Color.Foreground}"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="DescriptionBox"
                             Margin="0,8,0,0"
                             MinHeight="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{DynamicResource Yanzi.Textarea}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorText"
                           VerticalAlignment="Center"
                           Foreground="#FFEF4444"
                           FontSize="{DynamicResource FontSizeSmallPlus}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Button x:Name="DeleteButton"
                        Grid.Column="1"
                        Content="删除"
                        Style="{DynamicResource Yanzi.Button.Destructive}"
                        Width="90"
                        Margin="0,0,10,0"
                        Click="DeleteButton_Click" />
                <Button Grid.Column="2"
                        Content="取消"
                        Style="{DynamicResource Yanzi.Button.Outline}"
                        Width="90"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click" />
                <Button Grid.Column="3"
                        Content="保存"
                        Style="{DynamicResource Yanzi.Button.Default}"
                        Width="90"
                        Click="SaveButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
