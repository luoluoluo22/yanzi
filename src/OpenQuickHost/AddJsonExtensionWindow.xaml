                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="FolderSearchIncludeFilesCheck" Content="包含文件" IsChecked="True"
                                              Foreground="{DynamicResource BrushTextSec}" VerticalAlignment="Center"
                                              Checked="FolderSearchSimple_Toggled" Unchecked="FolderSearchSimple_Toggled" />
                                    <CheckBox Grid.Column="2" x:Name="FolderSearchIncludeDirsCheck" Content="包含子文件夹"
                                              Foreground="{DynamicResource BrushTextSec}" VerticalAlignment="Center"
                                              Checked="FolderSearchSimple_Toggled" Unchecked="FolderSearchSimple_Toggled" />
                                    <CheckBox Grid.Column="4" x:Name="FolderSearchSubdirsCheck" Content="递归子目录" IsChecked="True"
                                              Foreground="{DynamicResource BrushTextSec}" VerticalAlignment="Center"
                                              Checked="FolderSearchSimple_Toggled" Unchecked="FolderSearchSimple_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Grid>


                        <Expander x:Name="AdvancedSimpleExpander"
                                  Header="更多高级选项 · ID、版本、关键词、权限"
                                  Foreground="{DynamicResource BrushTextSec}"
                                  Background="{DynamicResource BrushSecondaryBtnBG}"
                                  Margin="0,12,0,0" Padding="6" FontSize="12.5">
                            <StackPanel Margin="6,10,6,4">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="扩展 ID（英文小写、短横线）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="IdSimpleBox" Style="{StaticResource FormTextBoxStyle}"
                                                 TextChanged="IdSimpleBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="版本号" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="VersionSimpleBox" Style="{StaticResource FormTextBoxStyle}"
                                                 TextChanged="VersionSimpleBox_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="分类" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="CategorySimpleBox" Style="{StaticResource FormTextBoxStyle}"
                                                 TextChanged="CategorySimpleBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="权限（逗号分隔，如 clipboard, network）"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="PermissionsSimpleBox" Style="{StaticResource FormTextBoxStyle}"
                                                 TextChanged="PermissionsSimpleBox_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="关键词（逗号分隔，启动器搜索时用到）"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="KeywordsSimpleBox" Style="{StaticResource FormTextBoxStyle}"
                                         TextChanged="KeywordsSimpleBox_TextChanged" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>


                <Grid x:Name="AdvancedModePanel" Grid.Column="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="28,24,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="编辑扩展 JSON" Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeLargePlus}" FontWeight="SemiBold" />
                            <TextBlock Text="直接修改代码，与简单扩展实时同步。"
                                       Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmallPlus}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ManualCopyJsonButton" Content="复制 JSON"
                                    Style="{DynamicResource GhostButtonStyle}"
                                    Height="32" Padding="14,0"
                                    Click="ManualCopyJsonButton_Click" />
                            <Button x:Name="ManualCopyPromptButton" Content="复制提示词"
                                    Style="{DynamicResource GhostButtonStyle}"
                                    Height="32" Padding="14,0" Margin="8,0,0,0"
                                    Click="ManualCopyPromptButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="28,0,18,12"
                            Background="{DynamicResource BrushSecondaryBtnBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="格式化" Style="{DynamicResource GhostButtonStyle}"
                                    Height="30" Padding="12,0"
                                    Click="FormatManualJsonButton_Click" />
                            <TextBox x:Name="ManualJsonFindBox" Grid.Column="2"
                                     Style="{StaticResource FormTextBoxStyle}" Height="30"
                                     FontFamily="Consolas" ToolTip="查找内容（Ctrl+F 聚焦）" />
                            <TextBox x:Name="ManualJsonReplaceBox" Grid.Column="4"
                                     Style="{StaticResource FormTextBoxStyle}" Height="30"
                                     FontFamily="Consolas" ToolTip="替换为" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="查找" Style="{DynamicResource GhostButtonStyle}"
                                        Height="30" Padding="10,0" Click="FindManualJsonButton_Click" />
                                <Button Content="替换" Style="{DynamicResource GhostButtonStyle}"
                                        Height="30" Padding="10,0" Margin="6,0,0,0"
                                        Click="ReplaceManualJsonButton_Click" />
                                <Button Content="全部替换" Style="{DynamicResource GhostButtonStyle}"
                                        Height="30" Padding="10,0" Margin="6,0,0,0"
                                        Click="ReplaceAllManualJsonButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="28,0,18,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" x:Name="JsonEditorRow" />
                            <RowDefinition Height="Auto" x:Name="InlineScriptSplitterRow" />
                            <RowDefinition Height="0" x:Name="InlineScriptRow" />
                        </Grid.RowDefinitions>

                        <!-- 上方：JSON 编辑器 -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1.4" CornerRadius="10" Margin="0,0,0,4">
                            <Grid>
                                <!-- WebView2 高级编辑器（首选） -->
                                <wv2:WebView2 x:Name="JsonWebViewEditor"
                                              Visibility="Collapsed" />

                                <!-- 原生 TextBox（离线降级 Fallback） -->
                                <TextBox x:Name="ManualJsonInputBox"
                                         Padding="18" AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource BrushTextMain}"
                                         FontFamily="Consolas" FontSize="13.5"
                                         CaretBrush="{DynamicResource BrushAccent}"
                                         SelectionBrush="{StaticResource AccentGlowBrush}"
                                         TextChanged="ManualJsonInputBox_TextChanged" />

                                <!-- 双击跳转状态栏 -->
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                        Margin="0,0,16,16" Padding="10,5" CornerRadius="12"
                                        Background="{DynamicResource BrushDialogBG}" BorderThickness="1"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="ManualJsonStatusText_MouseLeftButtonDown"
                                        ToolTip="双击可自动跳转到错误所在的行或列">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ManualJsonStatusDot" Width="7" Height="7"
                                                 Fill="{DynamicResource BrushTextSec}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ManualJsonStatusText" Margin="8,0,0,0"
                                                   Text="等待输入" Foreground="{DynamicResource BrushTextSec}"
                                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 中间：分割线 (GridSplitter) -->
                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Visibility="Collapsed" x:Name="InlineScriptSplitter" />

                        <!-- 下方：内联脚本独立编辑器 -->
                        <Border Grid.Row="2" x:Name="InlineScriptPanel"
                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1.4" CornerRadius="10" Margin="0,4,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <!-- 顶部：脚本语言指示与同步状态 -->
                                <Border Grid.Row="0" Background="#14FFFFFF" CornerRadius="8,8,0,0" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="InlineScriptTitle" Text="内联脚本代码编辑器" Foreground="{DynamicResource BrushTextMain}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border x:Name="InlineScriptLanguageBadgeHost" Background="#1A3B82F6" CornerRadius="4" Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="InlineScriptLanguageBadge" Text="C#" Foreground="{DynamicResource BrushAccent}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="与上方 JSON 实时双向同步" Foreground="{DynamicResource BrushTextSec}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <wv2:WebView2 x:Name="ScriptWebViewEditor"
                                                  Visibility="Collapsed" />
                                    
                                    <TextBox x:Name="InlineScriptInputBox"
                                             Padding="16" AcceptsReturn="True" AcceptsTab="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrushBorder}"
                                             Foreground="{DynamicResource BrushTextMain}"
                                             FontFamily="Consolas" FontSize="13.5"
                                             CaretBrush="{DynamicResource BrushAccent}"
                                             SelectionBrush="{StaticResource AccentGlowBrush}"
                                             TextChanged="InlineScriptInputBox_TextChanged" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>


                <Border Grid.Column="1"
                        Background="{DynamicResource BrushSecondaryBtnBG}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,24">
                        <StackPanel>
                            <TextBlock Text="实时预览" Style="{StaticResource SectionTitleStyle}" />
                            <Border Background="{DynamicResource BrushSecondaryBtnBG}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="在启动器中显示为"
                                               Foreground="{DynamicResource BrushTextSec}"
                                               FontSize="{DynamicResource FontSizeTiny}" Margin="2,0,0,8" />
                                    <Border Background="{DynamicResource BrushListViewItemMouseOver}" CornerRadius="9" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="PreviewIconHost" Width="40" Height="40"
                                                    CornerRadius="10" Background="{DynamicResource BrushAccent}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image x:Name="IconPreviewImage" Width="40" Height="40"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="Collapsed" />
                                                    <Viewbox x:Name="IconPreviewVectorHost" Width="22" Height="22"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Visibility="Collapsed">
                                                        <Path x:Name="IconPreviewVector" Width="24" Height="24"
                                                              Fill="{DynamicResource BrushTextMain}" Stretch="Uniform" />
                                                    </Viewbox>
                                                    <TextBlock x:Name="IconPreviewGlyph" Text="E" Foreground="{DynamicResource BrushTextMain}"
                                                               FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBox x:Name="PreviewNameText" Text="未命名扩展"
                                                         Foreground="{DynamicResource BrushTextMain}"
                                                         FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold"
                                                         Background="Transparent" BorderThickness="0"
                                                         Padding="0" CaretBrush="{DynamicResource BrushAccent}"
                                                         SelectionBrush="{StaticResource AccentGlowBrush}"
                                                         ToolTip="点击直接修改名称"
                                                         TextChanged="PreviewNameText_TextChanged" />
                                                <TextBox x:Name="PreviewDescText" Text="选择类型并填写信息以预览"
                                                         Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Padding="0" Margin="0,2,0,0"
                                                         CaretBrush="{DynamicResource BrushAccent}"
                                                         SelectionBrush="{StaticResource AccentGlowBrush}"
                                                         ToolTip="点击直接修改描述"
                                                         TextChanged="PreviewDescText_TextChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="IconPreviewHintText" Margin="2,8,0,0"
                                               Foreground="{DynamicResource BrushTextSec}"
                                               FontSize="10.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="基础信息" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,10" />
                            <TextBlock Text="名称" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="NameSimpleBox" Style="{StaticResource FormTextBoxStyle}"
                                     TextChanged="NameSimpleBox_TextChanged" />
                            <TextBlock Text="描述" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6" />
                            <TextBox x:Name="DescriptionSimpleBox" Style="{StaticResource FormTextBoxStyle}"
                                     AcceptsReturn="True" Height="64" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     TextChanged="DescriptionSimpleBox_TextChanged" />

                            <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,10" />
                            <TextBlock Text="图标（mdi:* 或图片路径）" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="IconSimpleBox" Style="{StaticResource FormTextBoxStyle}"
                                     TextChanged="IconSimpleBox_TextChanged" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="选图片" Style="{DynamicResource GhostButtonStyle}"
                                        Height="30" Padding="12,0"
                                        Click="PickIconImageButton_Click" />
                                <Button Content="清空" Style="{DynamicResource GhostButtonStyle}"
                                        Height="30" Padding="12,0" Margin="8,0,0,0"
                                        Click="ClearIconButton_Click" />
                            </StackPanel>

                            <TextBlock Text="主题色" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6" />
                            <WrapPanel x:Name="ColorSwatchPanel">
                                <Button Tag="#FF3B82F6" Width="26" Height="26" Background="#FF3B82F6"
                                        BorderThickness="0" Margin="0,0,6,6" Click="AccentSwatch_Click" Cursor="Hand" />
                                <Button Tag="#FF8B5CF6" Width="26" Height="26" Background="#FF8B5CF6"
                                        BorderThickness="0" Margin="0,0,6,6" Click="AccentSwatch_Click" Cursor="Hand" />
                                <Button Tag="#FF10B981" Width="26" Height="26" Background="#FF10B981"
                                        BorderThickness="0" Margin="0,0,6,6" Click="AccentSwatch_Click" Cursor="Hand" />
                                <Button Tag="#FFEC4899" Width="26" Height="26" Background="#FFEC4899"
                                        BorderThickness="0" Margin="0,0,6,6" Click="AccentSwatch_Click" Cursor="Hand" />
                                <Button Tag="#FFF59E0B" Width="26" Height="26" Background="#FFF59E0B"
                                        BorderThickness="0" Margin="0,0,6,6" Click="AccentSwatch_Click" Cursor="Hand" />
                                <Button Tag="#FF06B6D4" Width="26" Height="26" Background="#FF06B6D4"
                                        BorderThickness="0" Margin="0,0,6,6" Click="AccentSwatch_Click" Cursor="Hand" />
                                <Button Tag="#FFF87171" Width="26" Height="26" Background="#FFF87171"
                                        BorderThickness="0" Margin="0,0,6,6" Click="AccentSwatch_Click" Cursor="Hand" />
                                <Button Tag="#FF6366F1" Width="26" Height="26" Background="#FF6366F1"
                                        BorderThickness="0" Margin="0,0,6,6" Click="AccentSwatch_Click" Cursor="Hand" />
                            </WrapPanel>
                            <TextBox x:Name="AccentHexSimpleBox"
                                     Style="{StaticResource FormTextBoxStyle}" Margin="0,4,0,0"
                                     ToolTip="也可手动输入 #RRGGBB 或 #AARRGGBB"
                                     TextChanged="AccentHexSimpleBox_TextChanged" />

                            <!-- 触发方式（参考设置 - 扩展页右侧设计） -->
                            <TextBlock Text="触发方式" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,10" />

                            <!-- 开机自启 段卡 -->
                            <Border Background="{DynamicResource BrushSecondaryBtnBG}" CornerRadius="10"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    Margin="0,0,0,10">
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" Background="#1A7C3AED" CornerRadius="7" VerticalAlignment="Center">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#FFA78BFA"
                                              Data="M13,2 L4.09,12.97 A1,1 0 0 0 4.67,14.58 L11,16 L10,22 L18.91,11.03 A1,1 0 0 0 18.33,9.42 L13,8 Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="开机自启" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" />
                                        <TextBlock Text="主程序启动后自动运行此扩展"
                                                   Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"
                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="TriggerStartupSwitch" Grid.Column="2"
                                              VerticalAlignment="Center"
                                              Click="TriggerStartupSwitch_Click" />
                                </Grid>
                            </Border>

                            <!-- 定时运行 段卡（暂仅展示，配置入口） -->
                            <Border Background="{DynamicResource BrushSecondaryBtnBG}" CornerRadius="10"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    Margin="0,0,0,10">
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" Background="#1A059669" CornerRadius="7" VerticalAlignment="Center">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#FF34D399"
                                              Data="M12,20A8,8 0 1,1 20,12A8,8 0 0,1 12,20M12,7V12.25L15.5,14.33L14.78,15.55L10.5,13V7H12Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="定时运行" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TriggerScheduleLabel" Text="未配置 · 点击设置 cron"
                                                   Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"
                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="配置"
                                            Style="{DynamicResource GhostButtonStyle}"
                                            Height="28" Padding="12,0"
                                            VerticalAlignment="Center"
                                            Click="TriggerScheduleConfigure_Click" />
                                </Grid>
                            </Border>

                            <!-- 全局快捷键 段卡 -->
                            <Border Background="{DynamicResource BrushSecondaryBtnBG}" CornerRadius="10"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    Margin="0,0,0,10">
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" Background="#1A3B82F6" CornerRadius="7" VerticalAlignment="Center">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#FF60A5FA"
                                              Data="M19,10H17V8H19M19,13H17V11H19M16,10H14V8H16M16,13H14V11H16M16,17H8V15H16M7,10H5V8H7M7,13H5V11H7M8,11H10V13H8M8,8H10V10H8M11,11H13V13H11M11,8H13V10H11M20,5H4C2.89,5 2,5.89 2,7V17A2,2 0 0,0 4,19H20A2,2 0 0,0 22,17V7C22,5.89 21.1,5 20,5Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="全局快捷键" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TriggerShortcutLabel" Text="未设置 · 点击录制"
                                                   Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"
                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="设置"
                                            Style="{DynamicResource GhostButtonStyle}"
                                            Height="28" Padding="12,0"
                                            VerticalAlignment="Center"
                                            Click="TriggerShortcutEdit_Click" />
                                </Grid>
                            </Border>

                            <!-- 鼠标手势 段卡 -->
                            <Border Background="{DynamicResource BrushSecondaryBtnBG}" CornerRadius="10"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid Margin="14,12,14,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" Background="#1AFB923C" CornerRadius="7" VerticalAlignment="Center">
                                            <Path Width="14" Height="14" Stretch="Uniform" Fill="#FFFB923C"
                                                  Data="M9,5A2,2 0 0,1 11,7V18.18C11,18.18 14,16 16,16C17.5,16 20,17.69 20,19.69V20.69C20,22.31 18.97,22.69 17.31,22.69H10.31C9.31,22.69 7.95,22.5 7.18,21.74L1.41,16C1.41,16 0.91,14.5 2.41,13C3.91,11.5 5.41,12 5.41,12L7,12.45V7A2,2 0 0,1 9,5Z"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="鼠标手势" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock x:Name="TriggerGestureSequenceText"
                                                           FontFamily="Consolas" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Bold"
                                                           Foreground="#FFFB923C"
                                                           Visibility="Collapsed" />
                                                <TextBlock x:Name="TriggerGestureLabel" Text="未设置 · 点击录制"
                                                           Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}"
                                                           VerticalAlignment="Bottom" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="录制"
                                                Style="{DynamicResource GhostButtonStyle}"
                                                Height="28" Padding="12,0"
                                                VerticalAlignment="Center"
                                                Click="TriggerGestureRecord_Click" />
                                    </Grid>
                                    <StackPanel Margin="14,0,14,12" x:Name="TriggerGestureExtraRow" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource BrushListViewItemMouseOver}"
                                                    BorderBrush="{DynamicResource BrushBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,7">
                                                <TextBlock Text="触发方式使用设置页的全局鼠标手势触发"
                                                           Foreground="{DynamicResource BrushTextSec}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <Button Grid.Column="1" Content="清除"
                                                    Style="{DynamicResource GhostButtonStyle}"
                                                    Height="32" Padding="12,0" Margin="8,0,0,0"
                                                    Click="TriggerGestureClear_Click" />
                                        </Grid>

                                        <TextBlock Text="常用手势"
                                                   Foreground="{DynamicResource BrushTextSec}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Margin="0,10,0,6" />
                                        <WrapPanel x:Name="GesturePresetPanel" ItemHeight="28" ItemWidth="Auto">
                                            <Button Content="↑" Tag="↑" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↓" Tag="↓" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="←" Tag="←" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="→" Tag="→" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↖" Tag="↖" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↘" Tag="↘" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↗" Tag="↗" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↙" Tag="↙" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↑↓" Tag="↑↓" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↓↑" Tag="↓↑" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="←→" Tag="←→" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="→←" Tag="→←" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↑←" Tag="↑←" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↑→" Tag="↑→" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↓←" Tag="↓←" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="↓→" Tag="↓→" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="←↑" Tag="←↑" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="←↓" Tag="←↓" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="→↑" Tag="→↑" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                            <Button Content="→↓" Tag="→↓" Style="{DynamicResource GhostButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6" Click="GesturePreset_Click" />
                                        </WrapPanel>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="最小距离（像素）"
                                                           Foreground="{DynamicResource BrushTextSec}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Margin="0,0,0,4" />
                                                <TextBox x:Name="GestureMinDistanceBox"
                                                         Style="{StaticResource FormTextBoxStyle}"
                                                         TextChanged="GestureConfigTextBox_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="容差（度，可选）"
                                                           Foreground="{DynamicResource BrushTextSec}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Margin="0,0,0,4" />
                                                <TextBox x:Name="GestureToleranceBox"
                                                         Style="{StaticResource FormTextBoxStyle}"
                                                         TextChanged="GestureConfigTextBox_TextChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="GestureConflictHintText"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource BrushTextSec}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,22,0,0" Padding="14"
                                    Background="#0D3B82F6"
                                    BorderBrush="#333B82F6"
                                    BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✨" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center" />
                                        <TextBlock Text="让 AI 帮你写完整 JSON" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource BrushTextMain}"
                                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="复制提示词到任意 AI 对话，得到 JSON 后切到「高级模式」粘贴即可。"
                                               Foreground="{DynamicResource BrushTextSec}"
                                               FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap"
                                               Margin="0,8,0,10" />
                                    <Button x:Name="SidePanelCopyPromptButton" Content="复制提示词"
                                            Style="{DynamicResource GhostButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Height="30" Padding="14,0" FontSize="{DynamicResource FontSizeSmallPlus}"
                                            Click="ManualCopyPromptButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>


            <!-- 测试结果（两个模式共用，平铺在底栏之上） -->
            <Border x:Name="ManualTestResultPanel" Grid.Row="1"
                    VerticalAlignment="Bottom"
                    Margin="28,0,28,16"
                    Background="{DynamicResource BrushSecondaryBtnBG}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="16"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="测试日志" Foreground="{DynamicResource BrushTextMain}"
                                   FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ManualCopyTestFailureButton" Content="复制日志"
                                    Style="{DynamicResource GhostButtonStyle}"
                                    Height="28" Padding="10,0" FontSize="{DynamicResource FontSizeSmall}"
                                    Visibility="Collapsed"
                                    Click="ManualCopyTestFailureButton_Click" />
                            <Button Content="关闭" Style="{DynamicResource GhostButtonStyle}"
                                    Height="28" Padding="10,0" FontSize="{DynamicResource FontSizeSmall}" Margin="6,0,0,0"
                                    Click="CloseTestResultPanel_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ManualTestSummaryText"
                               Foreground="{DynamicResource BrushTextSec}"
                               FontSize="{DynamicResource FontSizeSmallPlus}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBox x:Name="ManualTestLogTextBox"
                             Height="160" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BrushBG}" BorderThickness="0"
                             Foreground="{DynamicResource BrushTextSec}"
                             FontFamily="Consolas" FontSize="{DynamicResource FontSizeSmallPlus}" />
                </StackPanel>
            </Border>

            <!-- 底栏：错误提示 + 试运行 / 保存 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                    Padding="22,12" Background="{DynamicResource BrushSecondaryBtnBG}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ErrorText"
                                   Foreground="{StaticResource RedBrush}" FontSize="12.5" FontWeight="SemiBold"
                                   Visibility="Collapsed" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderDescription"
                                   Text="选好类型，填几项关键信息就能保存。"
                                   Foreground="{DynamicResource BrushTextSec}" FontSize="11.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Grid VerticalAlignment="Center">
                            <TextBox x:Name="TestArgumentBox"
                                     Width="180" Height="32" Margin="0,0,12,0"
                                     VerticalAlignment="Center" Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     ToolTip="临时传入测试的参数"
                                     GotFocus="TestArgumentBox_GotFocus"
                                     LostFocus="TestArgumentBox_LostFocus"
                                     TextChanged="TestArgumentBox_TextChanged" />
                            <TextBlock x:Name="TestArgumentPlaceholder"
                                       Text="输入测试参数..."
                                       Foreground="{DynamicResource BrushTextSec}"
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       Margin="8,0,20,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Visibility="Collapsed" />
                        </Grid>
                        <CheckBox x:Name="TestDelayCheck" Content="延迟 3 秒"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  ToolTip="测试前等待 3 秒，方便切到目标窗口（如模拟按键）" />
                        <Button x:Name="HeaderTestButton" Content="试运行"
                                Style="{DynamicResource GhostButtonStyle}"
                                Height="36" Padding="18,0"
                                Click="HeaderTestButton_Click" />
                        <Button x:Name="SaveButton" Content="保存并添加"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="36" Padding="22,0" Margin="10,0,0,0"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" Width="0" Height="0">
                <TextBox x:Name="IdBox" />
                <TextBox x:Name="NameBox" />
                <TextBox x:Name="VersionBox" />
                <TextBox x:Name="CategoryBox" />
                <TextBox x:Name="DescriptionBox" />
                <TextBox x:Name="KeywordsBox" />
                <TextBox x:Name="OpenTargetBox" />
                <TextBox x:Name="QueryPrefixesBox" />
                <TextBox x:Name="QueryTargetTemplateBox" />
                <TextBox x:Name="IconBox" TextChanged="IconBox_TextChanged" />
                <TextBox x:Name="AccentHexBox" />
                <TextBox x:Name="GlobalShortcutBox" />
                <TextBox x:Name="HotkeyBehaviorBox" />
                <TextBox x:Name="RuntimeBox" />
                <TextBox x:Name="EntryModeBox" />
                <TextBox x:Name="EntryBox" />
                <TextBox x:Name="ScriptSourceBox" />
                <TextBox x:Name="PermissionsBox" />
                <TextBox x:Name="StartupModeBox" />
                <TextBox x:Name="StartupScheduleBox" />
                <ItemsControl x:Name="BuiltInIconsList" />
                <Border x:Name="JsonStatusBadge" />
                <Button x:Name="ManualTestExtensionButton" Click="ManualTestExtensionButton_Click" />
                <!-- 旧的简单模式触发控件已移到右侧三段卡，但 SimpleMode handlers 仍引用，保留隐藏 -->
                <TextBox x:Name="GlobalShortcutSimpleBox" TextChanged="GlobalShortcutSimpleBox_TextChanged" />
                <ComboBox x:Name="StartupModeCombo" SelectionChanged="StartupModeCombo_SelectionChanged">
                    <ComboBoxItem Content="不自动启动" Tag="" IsSelected="True" />
                    <ComboBoxItem Content="软件启动时" Tag="on_app_launch" />
                </ComboBox>
                <Grid x:Name="WizardHeaderPanel" />
                <Border x:Name="Step1Panel" />
                <Border x:Name="Step2Panel" />
                <Border x:Name="Step3Panel" />
                <Grid x:Name="ManualEditorPanel" />
                <TextBox x:Name="AiRequestBox" />
                <TextBlock x:Name="AiRequestPlaceholder" />
                <TextBox x:Name="AiPromptPreviewBox" />
                <TextBlock x:Name="AiPromptPlaceholder" />
                <TextBox x:Name="AiJsonInputBox" />
                <TextBlock x:Name="AiJsonPlaceholder" />
                <Button x:Name="ManualModeButton" />
                <Button x:Name="TestExtensionButton" />
                <Button x:Name="CopyTestFailureButton" />
                <Border x:Name="TestResultPanel" />
                <TextBlock x:Name="TestSummaryText" />
                <TextBox x:Name="TestLogTextBox" />
                <Button x:Name="GoStep2Button" />
                <Button x:Name="GoStep3Button" />
                <Button x:Name="CopyAiGuidePromptButton" />
                <TextBlock x:Name="AiPromptStatusText" />
                <Ellipse x:Name="AiPromptStatusDot" />
                <TextBlock x:Name="AiJsonStatusText" />
                <Ellipse x:Name="JsonStatusDot" />
                <Border x:Name="Step1Dot" />
                <TextBlock x:Name="Step1DotText" />
                <Border x:Name="Step2Dot" />
                <TextBlock x:Name="Step2DotText" />
                <Border x:Name="Step3Dot" />
                <TextBlock x:Name="Step3DotText" />
                <TextBlock x:Name="Step1Label" />
                <TextBlock x:Name="Step2Label" />
                <TextBlock x:Name="Step3Label" />
                <Border x:Name="StepLine1" />
                <Border x:Name="StepLine2" />
                <TextBlock>
                    <Run x:Name="PageHeaderPrefix" Text="" />
                    <Run x:Name="PageHeaderAccent" Text="" />
                </TextBlock>
            </Grid>

        </Grid>
    </Border>
</Window>

