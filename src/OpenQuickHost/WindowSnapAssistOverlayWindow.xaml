<Window x:Class="OpenQuickHost.WindowSnapAssistOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口排列"
        Width="368"
        Height="368"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Window.Resources>
        <Style x:Key="SnapWheelItemStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#33111827" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
    <Canvas x:Name="RootCanvas">
        <Canvas x:Name="WheelLayer"
                Width="368"
                Height="368"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Canvas x:Name="CustomSlotLayer"
                    Width="368"
                    Height="368"
                    Visibility="Collapsed" />

            <!-- Main wheel background -->
            <Ellipse Width="184" Height="184"
                     Fill="Black"
                     Stroke="#554BD4FF"
                     StrokeThickness="1"
                     Canvas.Left="92" Canvas.Top="92"/>

            <Path x:Name="InnerMaximizeHalf"
                  Fill="Black"
                  Stroke="#2267E8F9"
                  StrokeThickness="1"/>
            <Path x:Name="InnerRestoreHalf"
                  Fill="Black"
                  Stroke="#2267E8F9"
                  StrokeThickness="1"/>

            <!-- Layout items -->
            <Border x:Name="TopLeftItem" Style="{StaticResource SnapWheelItemStyle}" Canvas.Left="120" Canvas.Top="118">
                <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="26" Height="18" Stroke="#55FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Width="13" Height="9" Fill="#CC3B82F6" RadiusX="1" RadiusY="1"/>
                </Canvas>
            </Border>

            <Border x:Name="TopItem" Style="{StaticResource SnapWheelItemStyle}" Canvas.Left="166" Canvas.Top="106">
                <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="26" Height="18" Stroke="#55FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Width="26" Height="9" Fill="#CC3B82F6" RadiusX="1" RadiusY="1"/>
                </Canvas>
            </Border>

            <Border x:Name="TopRightItem" Style="{StaticResource SnapWheelItemStyle}" Canvas.Left="212" Canvas.Top="118">
                <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="26" Height="18" Stroke="#55FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Width="13" Height="9" Fill="#CC3B82F6" RadiusX="1" RadiusY="1" Canvas.Left="13"/>
                </Canvas>
            </Border>

            <Border x:Name="RightItem" Style="{StaticResource SnapWheelItemStyle}" Canvas.Left="226" Canvas.Top="170">
                <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="26" Height="18" Stroke="#55FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Width="13" Height="18" Fill="#CC3B82F6" RadiusX="1" RadiusY="1" Canvas.Left="13"/>
                </Canvas>
            </Border>

            <Border x:Name="BottomRightItem" Style="{StaticResource SnapWheelItemStyle}" Canvas.Left="212" Canvas.Top="222">
                <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="26" Height="18" Stroke="#55FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Width="13" Height="9" Fill="#CC3B82F6" RadiusX="1" RadiusY="1" Canvas.Left="13" Canvas.Top="9"/>
                </Canvas>
            </Border>

            <Border x:Name="BottomItem" Style="{StaticResource SnapWheelItemStyle}" Canvas.Left="166" Canvas.Top="234">
                <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="26" Height="18" Stroke="#55FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Width="26" Height="9" Fill="#CC3B82F6" RadiusX="1" RadiusY="1" Canvas.Top="9"/>
                </Canvas>
            </Border>

            <Border x:Name="BottomLeftItem" Style="{StaticResource SnapWheelItemStyle}" Canvas.Left="120" Canvas.Top="222">
                <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="26" Height="18" Stroke="#55FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Width="13" Height="9" Fill="#CC3B82F6" RadiusX="1" RadiusY="1" Canvas.Top="9"/>
                </Canvas>
            </Border>

            <Border x:Name="LeftItem" Style="{StaticResource SnapWheelItemStyle}" Canvas.Left="106" Canvas.Top="170">
                <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="26" Height="18" Stroke="#55FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Width="13" Height="18" Fill="#CC3B82F6" RadiusX="1" RadiusY="1"/>
                </Canvas>
            </Border>

            <!-- Dynamic hint text (changes based on selection) -->
            <TextBlock x:Name="HintText"
                       Text="拖动选择布局"
                       Foreground="#88FFFFFF"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Canvas.Left="144" Canvas.Top="344"
                       IsHitTestVisible="False"/>
        </Canvas>

        <!-- Center button with dynamic app icon -->
        <Button x:Name="CenterButton"
                Canvas.Left="162"
                Canvas.Top="162"
                Width="44"
                Height="44"
                Padding="0"
                Background="#E60B1220"
                BorderBrush="#FF67E8F9"
                BorderThickness="1.5"
                ToolTip="按住拖动调整窗口布局"
                PreviewMouseLeftButtonDown="CenterButton_PreviewMouseLeftButtonDown"
                PreviewMouseRightButtonUp="CenterButton_PreviewMouseRightButtonUp">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="禁用窗口快速排列" Click="DisableSnapAssist_Click"/>
                </ContextMenu>
            </Button.ContextMenu>
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="22" />
                </Style>
            </Button.Resources>
            <Grid>
                <Path x:Name="DefaultIcon"
                      Data="M8,8 H16 V5 L21,10 L16,15 V12 H12 V16 H15 L10,21 L5,16 H8 V8 Z"
                      Width="22" Height="22"
                      Stretch="Uniform"
                      Fill="#FFFFFFFF"/>
                <Image x:Name="AppIconImage"
                       Width="28" Height="28"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="Collapsed"/>
            </Grid>
        </Button>
    </Canvas>
</Window>
