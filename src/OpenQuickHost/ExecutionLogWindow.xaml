<Window x:Class="OpenQuickHost.ExecutionLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行日志"
        Width="840"
        Height="620"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">
    <Border Margin="1"
            CornerRadius="0"
            Background="{DynamicResource Yanzi.Brush.Window}"
            BorderBrush="{DynamicResource Yanzi.Brush.Border}"
            BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Text="运行日志"
                       Style="{StaticResource TitleText}" />

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="12"
                    Background="{DynamicResource BrushInputBG}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="执行完成"
                                   Foreground="{DynamicResource Yanzi.Brush.Success}"
                                   FontSize="{DynamicResource FontSizeNormal}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="MetaText"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource Yanzi.Brush.TextSecondary}"
                                   FontSize="{DynamicResource FontSizeSmallPlus}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="CopyOutputButton"
                            Content="复制输出"
                            Width="92"
                            Height="32"
                            Margin="16,0,0,0"
                            Click="CopyOutputButton_Click"
                            Style="{DynamicResource Yanzi.Button.Outline}" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="0,16,0,8"
                       Text="标准输出"
                       Foreground="{DynamicResource Yanzi.Brush.Text}"
                       FontSize="{DynamicResource FontSizeNormal}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Top" />
            <TextBox x:Name="OutputTextBox"
                     Grid.Row="2"
                     Margin="0,42,0,0"
                     Padding="14"
                     Style="{DynamicResource Yanzi.Input}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="{DynamicResource FontSizeSmallPlus}"
                     Background="{DynamicResource Yanzi.Brush.InputBG}"
                     BorderBrush="{DynamicResource BrushBorder}"
                     BorderThickness="1"
                     Foreground="{DynamicResource Yanzi.Brush.Text}" />

            <TextBlock Grid.Row="3"
                       Margin="0,16,0,8"
                       Text="错误输出"
                       Foreground="{DynamicResource Yanzi.Brush.Text}"
                       FontSize="{DynamicResource FontSizeNormal}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Top" />
            <TextBox x:Name="ErrorTextBox"
                     Grid.Row="4"
                     Padding="14"
                     Style="{DynamicResource Yanzi.Input}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="{DynamicResource FontSizeSmallPlus}"
                     Background="{DynamicResource Yanzi.Brush.InputBG}"
                     BorderBrush="{DynamicResource BrushBorder}"
                     BorderThickness="1"
                     Foreground="{DynamicResource Yanzi.Brush.Danger}" />

            <Grid Grid.Row="5" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Yanzi.Brush.TextSecondary}"
                           FontSize="{DynamicResource FontSizeSmallPlus}"
                           Text="这里显示当前测试执行的详细输出。" />
                <Button Grid.Column="1"
                        x:Name="CloseButton"
                        Width="100"
                        Content="关闭"
                        IsDefault="True"
                        IsCancel="True"
                        Click="CloseButton_Click"
                        Style="{DynamicResource Yanzi.Button.Default}" />
            </Grid>
        </Grid>
    </Border>
</Window>
