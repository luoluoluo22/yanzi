<Window x:Class="OpenQuickHost.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录制快捷键"
        Width="500"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Border Margin="1"
            CornerRadius="0"
            Background="{DynamicResource BrushDialogBG}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Text="录制快捷键"
                       Style="{StaticResource TitleText}" />

            <TextBlock x:Name="DescriptionText"
                       Grid.Row="1"
                       Margin="0,8,0,0"
                       Style="{StaticResource DescriptionText}" />

            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Height="52"
                    CornerRadius="8"
                    Background="{DynamicResource BrushInputBG}"
                    BorderBrush="{DynamicResource BrushAccent}"
                    BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="CapturedHotkeyText"
                               Text="请直接按下新的组合键"
                               Foreground="{DynamicResource BrushTextMain}"
                               FontSize="{DynamicResource FontSizeLarge}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="显示名称"
                           Foreground="{DynamicResource BrushTextMain}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           FontWeight="SemiBold" />
                <TextBox x:Name="DisplayNameTextBox"
                         Margin="0,6,0,0"
                         Height="34"
                         VerticalContentAlignment="Center"
                         TextChanged="DisplayNameTextBox_TextChanged" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="4"
                       Margin="0,6,0,0"
                       VerticalAlignment="Center"
                       Foreground="#FFEF4444"
                       FontSize="{DynamicResource FontSizeSmallPlus}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />

            <StackPanel Grid.Row="5"
                        Margin="0,14,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="RetryButton"
                        Content="重新录制"
                        Style="{StaticResource SecondaryBtn}"
                        Width="92"
                        Margin="0,0,10,0"
                        Click="RetryButton_Click"
                        PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" />
                <Button x:Name="ClearButton"
                        Content="清空"
                        Style="{StaticResource SecondaryBtn}"
                        Width="84"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="ClearButton_Click"
                        PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" />
                <Button x:Name="CancelButton"
                        Content="取消"
                        Style="{StaticResource SecondaryBtn}"
                        Width="84"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"
                        PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" />
                <Button x:Name="ConfirmButton"
                        Content="确认"
                        Style="{StaticResource PrimaryBtn}"
                        Width="84"
                        IsEnabled="False"
                        IsDefault="True"
                        Click="ConfirmButton_Click"
                        PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
