<Window x:Class="OpenQuickHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenQuickHost"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="燕子"
        Width="700"
        Height="580"
        MinWidth="400"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushBG}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="1" />
    </shell:WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- Colors -->
        <Color x:Key="WindowBackground">#FF1C1C1C</Color>
        <Color x:Key="BorderColor">#FF333333</Color>
        <Color x:Key="SecondaryText">#FF8E8E8E</Color>
        <Color x:Key="AccentColor">#FF3B82F6</Color>
        
        <!-- Brushes -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackground}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}" />

        <Style x:Key="QuickMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#10FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Animations -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
        </Storyboard>

        <ContextMenu x:Key="FileResultContextMenu"
                     Opened="CommandListContextMenu_Opened"
                     Closed="CommandListContextMenu_Closed"
                     PreviewKeyDown="CommandListContextMenu_PreviewKeyDown">
            <MenuItem Header="打开"
                      Click="OpenFileResultMenuItem_Click" />
            <MenuItem Header="打开路径"
                      Click="OpenFileResultDirectoryMenuItem_Click" />
            <MenuItem Header="打开终端"
                      Click="OpenFileResultTerminalMenuItem_Click" />
            <MenuItem Header="预览"
                      Click="PreviewFileResultMenuItem_Click" />
            <Separator />
            <MenuItem Header="复制"
                      Click="CopyFileResultMenuItem_Click" />
            <MenuItem Header="复制完整路径"
                      Click="CopyFileResultFullPathMenuItem_Click" />
            <MenuItem Header="剪切"
                      Click="CutFileResultMenuItem_Click" />
            <MenuItem Header="移动到..."
                      Click="MoveFileResultMenuItem_Click" />
            <MenuItem Header="收藏"
                      Click="FavoriteFileResultMenuItem_Click" />
            <MenuItem Header="删除"
                      Click="DeleteFileResultMenuItem_Click" />
        </ContextMenu>

        <ContextMenu x:Key="GenericResultContextMenu"
                     Opened="CommandListContextMenu_Opened"
                     Closed="CommandListContextMenu_Closed"
                     PreviewKeyDown="CommandListContextMenu_PreviewKeyDown">
            <MenuItem Header="执行默认动作"
                      Click="OpenGenericResultMenuItem_Click" />
            <MenuItem Header="查看详情"
                      Click="ShowGenericResultDetailsMenuItem_Click" />
            <Separator />
            <MenuItem Header="复制标题"
                      Click="CopyGenericResultTitleMenuItem_Click" />
            <MenuItem Header="复制内容"
                      Click="CopyGenericResultContentMenuItem_Click" />
            <MenuItem Header="复制目标"
                      Click="CopyGenericResultTargetMenuItem_Click" />
        </ContextMenu>
    </Window.Resources>

    <Border Margin="1"
            CornerRadius="0"
            Background="{DynamicResource BrushDialogBG}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Search -->
                <RowDefinition Height="*" />    <!-- List -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Search Bar -->
            <StackPanel Grid.Row="0"
                        Visibility="{Binding NormalLauncherVisibility}"
                        Margin="20,15,20,10"
                        AllowDrop="True"
                        PreviewDragEnter="SearchBox_DragEnter"
                        PreviewDragOver="SearchBox_DragOver"
                        PreviewDrop="SearchBox_Drop">
                <Grid x:Name="SearchBarGrid"
                      AllowDrop="True"
                      PreviewDragEnter="SearchBox_DragEnter"
                      PreviewDragOver="SearchBox_DragOver"
                      PreviewDrop="SearchBox_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Icon -->
                    <Viewbox Width="20"
                             Height="20"
                             VerticalAlignment="Center"
                             Margin="5,0,15,0">
                        <Path Data="{local:IconGeometry search}"
                              Fill="{DynamicResource BrushTextSec}"
                              Stretch="Uniform"/>
                    </Viewbox>

                    <Grid Grid.Column="1">
                        <TextBlock IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeTitle}"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   Visibility="{Binding SearchInlineCompletionVisibility}"
                                   Text="{Binding SearchInlineCompletionSuffix}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="{Binding SearchInlineCompletionPrefixWidth}" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBox x:Name="SearchBox"
                                 AllowDrop="True"
                                 FontSize="{DynamicResource FontSizeTitle}"
                                 Foreground="{DynamicResource BrushTextMain}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="#FF3B82F6"
                                 VerticalAlignment="Center"
                                 Padding="0,5"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 PreviewDragEnter="SearchBox_DragEnter"
                                 PreviewDragOver="SearchBox_DragOver"
                                 PreviewDrop="SearchBox_Drop"
                                 DragEnter="SearchBox_DragEnter"
                                 DragOver="SearchBox_DragOver"
                                 Drop="SearchBox_Drop" />
                    
                        <!-- Search Box Placeholder -->
                        <TextBlock IsHitTestVisible="False"
                                   Text="搜索应用、扩展、系统项，或输入 @应用 / @系统 ..."
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   FontSize="{DynamicResource FontSizeTitle}"
                                   Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="{Binding PinButtonTooltip}"
                            Click="PinAutoHideButton_Click"
                            Style="{DynamicResource GhostButtonStyle}">
                        <Viewbox Width="14"
                                 Height="14"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Stretch="Uniform">
                            <Canvas Width="1024" Height="1024">
                                <Path Data="{local:IconGeometry pin}"
                                      Fill="{Binding PinButtonBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <Border Margin="0,10,0,0"
                        Padding="0"
                        Background="Transparent"
                        Visibility="{Binding AttachedFilesVisibility}">
                    <ItemsControl ItemsSource="{Binding AttachedFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AttachedFileItem}">
                                <Border x:Name="AttachedFileCard"
                                        Margin="0,0,0,8"
                                        Padding="10,8"
                                        Background="{DynamicResource BrushSecondaryBtnBG}"
                                        BorderBrush="#223B82F6"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Background="#E53B3B"
                                                BorderBrush="#FFFCA5A5"
                                                BorderThickness="1"
                                                Foreground="{DynamicResource BrushTextMain}"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                ToolTip="移除附件"
                                                Click="RemoveAttachedFileButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="11">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=AttachedFileCard}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="IsHitTestVisible" Value="True" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F87171" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="×"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                        <Border Grid.Column="1"
                                                Width="34"
                                                Height="34"
                                                CornerRadius="8"
                                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding IconSource}"
                                                       Stretch="Uniform"
                                                       Margin="6"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="F"
                                                           Foreground="{DynamicResource BrushTextMain}"
                                                           FontSize="{DynamicResource FontSizeNormalPlus}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource BrushTextMain}"
                                                       FontSize="{DynamicResource FontSizeNormal}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FullPath}"
                                                       Foreground="{DynamicResource BrushTextSec}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="3"
                                                Tag="{Binding}"
                                                Content="复制路径"
                                                Padding="10,5"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Foreground="{DynamicResource BrushTextMain}"
                                                Click="CopyAttachedFilePathButton_Click"
                                                Style="{DynamicResource GhostButtonStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <Popup x:Name="SearchScopePopup"
                   PlacementTarget="{Binding ElementName=SearchBarGrid}"
                   Placement="Top"
                   HorizontalOffset="0"
                   VerticalOffset="-20"
                   AllowsTransparency="True"
                   IsOpen="False"
                   StaysOpen="True"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding SearchScopes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SearchScopeTab}">
                                <Button Content="{Binding DisplayLabel}"
                                        ToolTip="{Binding Tooltip}"
                                        Tag="{Binding}"
                                        Click="SearchScopeButton_Click"
                                        Margin="0,0,5,0"
                                        Padding="7,3"
                                        FontSize="{DynamicResource FontSizeSmallPlus}"
                                        FontWeight="SemiBold"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="删除顶部标签"
                                                      Tag="{Binding}"
                                                      Click="RemovePinnedSearchScopeMenuItem_Click"
                                                      Visibility="{Binding IsPinnedCommand, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource BrushSecondaryBtnBG}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Root"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="10"
                                                                                  ShadowDepth="2"
                                                                                  Opacity="0.32"
                                                                                  Color="#000000" />
                                                            </Border.Effect>
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushListViewItemSelectedBG}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushListViewItemSelectedBorder}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushTagSelectedText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+"
                            ToolTip="固定当前选中项到顶部标签"
                            Click="SearchScopeAddButton_Click"
                            Margin="1,0,0,0"
                            Padding="7,3"
                            FontSize="{DynamicResource FontSizeSmallPlus}"
                            FontWeight="SemiBold"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource BrushSecondaryBtnBG}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="10"
                                                                      ShadowDepth="2"
                                                                      Opacity="0.32"
                                                                      Color="#000000" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#E01F9D55" />
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="#B034D399" />
                                                    <Setter Property="Content" Value="+ 添加" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Popup>

            <!-- Separator -->
            <Rectangle Grid.Row="0"
                       Height="1"
                       Fill="{DynamicResource BrushSecondaryBtnBG}"
                       VerticalAlignment="Bottom"
                       Margin="0,5,0,0"
                       Visibility="{Binding NormalLauncherVisibility}"/>

            <!-- 2. List Content -->
            <Grid Grid.Row="1"
                  Margin="10,5,10,5"
                  Visibility="{Binding NormalLauncherVisibility}">
                <ListBox x:Name="CommandList"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding FilteredCommands}"
                         SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                         ContextMenuOpening="CommandList_ContextMenuOpening"
                         MouseDoubleClick="CommandList_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="CommandList_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="CommandList_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="CommandList_PreviewMouseMove"
                         PreviewMouseRightButtonDown="CommandList_PreviewMouseRightButtonDown"
                         PreviewMouseRightButtonUp="CommandList_PreviewMouseRightButtonUp"
                         PreviewKeyDown="CommandList_PreviewKeyDown"
                         SelectionChanged="CommandList_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="CommandListContextMenu_Opened"
                                     Closed="CommandListContextMenu_Closed"
                                     PreviewKeyDown="CommandListContextMenu_PreviewKeyDown">
                            <MenuItem x:Name="SetCommandShortcutMenuItem"
                                      Header="设置快捷键"
                                      Visibility="Collapsed"
                                      Click="SetCommandShortcutMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry shortcut}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="RenameCommandMenuItem"
                                      Header="重命名"
                                      Visibility="Collapsed"
                                      Click="RenameCommandMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry pen}" Fill="#A0FFFFFF" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="EditExtensionMenuItem"
                                      Header="编辑扩展"
                                      Click="EditExtensionMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry pen}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="PublishExtensionMenuItem"
                                      Header="发布到商店"
                                      Click="PublishExtensionMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry publish}" Fill="#F59E0B" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CopyExtensionStoreLinkMenuItem"
                                      Header="复制商店链接"
                                      Visibility="Collapsed"
                                      Click="CopyExtensionStoreLinkMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry link}" Fill="#93C5FD" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="OpenExtensionStoreLinkMenuItem"
                                      Header="打开商店链接"
                                      Click="OpenExtensionStoreLinkMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry link}" Fill="#93C5FD" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="DeleteExtensionMenuItem"
                                      Header="删除"
                                      Click="DeleteExtensionMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry delete}" Fill="#EF4444" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="TerminateExtensionMenuItem"
                                      Header="停止运行"
                                      Click="TerminateExtensionMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry stop}" Fill="#EF4444" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="OpenExtensionDirectoryMenuItem"
                                      Header="打开扩展目录"
                                      Click="OpenExtensionDirectoryMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry open-folder}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ToggleYanyuEnabledMenuItem"
                                      Header="启用燕语"
                                      Click="ToggleYanyuEnabledMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry power}" Fill="#22C55E" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="CopyExtensionMenuItem"
                                      Header="复制扩展"
                                      Click="CopyExtensionMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry copy}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CutExtensionMenuItem"
                                      Header="剪切扩展"
                                      Click="CutExtensionMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry cut}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="PasteExtensionMenuItem"
                                      Header="粘贴扩展"
                                      Click="PasteExtensionMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry paste}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="AddToQuickPanelMenuItem"
                                      Header="添加到鼠标面板"
                                      Click="AddToQuickPanelMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry plus}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CreateDesktopShortcutMenuItem"
                                      Header="添加桌面快捷方式"
                                      Click="CreateDesktopShortcutMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Data="{local:IconGeometry desktop-shortcut}" Fill="{DynamicResource BrushAccent}" Stretch="Uniform" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="4,2,4,2" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="CommandListItem_PreviewMouseLeftButtonDown" />
                            <EventSetter Event="MouseMove" Handler="CommandListItem_MouseMove" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root"
                                                Padding="12,8"
                                                CornerRadius="8"
                                                Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushListViewItemSelectedBG}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CommandItem}">
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCSharpPrebuilding}" Value="True">
                                                <Setter Property="Opacity" Value="0.58" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- 1. 普通扩展/应用/文件布局 (Source != Cloud) -->
                                <Grid x:Name="NormalExtensionLayout">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="Cloud">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon Area -->
                                    <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border Width="32"
                                                Height="32"
                                                CornerRadius="8"
                                                ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{Binding AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImageIcon}" Value="True">
                                                            <Setter Property="Background" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Image Source="{Binding IconSource}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       SnapsToDevicePixels="True"
                                                       Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Viewbox Margin="6"
                                                         Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Path Width="24"
                                                          Height="24"
                                                          Data="{Binding VectorIcon}"
                                                          Fill="White"
                                                          Stretch="Uniform" />
                                                </Viewbox>
                                                <TextBlock Text="{Binding DisplayGlyph}"
                                                       FontSize="{DynamicResource FontSizeNormalPlus}"
                                                       Foreground="{DynamicResource BrushTextMain}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Border Width="9"
                                                        Height="9"
                                                        CornerRadius="4.5"
                                                        Background="#FFFF5A7A"
                                                        BorderBrush="#CCFFFFFF"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,1,1,0"
                                                        Visibility="{Binding HasNewBadge, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Border Background="{DynamicResource BrushDialogBG}"
                                                        Visibility="{Binding IsCSharpPrebuilding, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Viewbox Width="18"
                                                         Height="18"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsCSharpPrebuilding, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Path Data="{local:IconGeometry sync}"
                                                          Fill="{DynamicResource BrushTextMain}"
                                                          Stretch="Uniform"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                        <Path.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                         From="0"
                                                                                         To="360"
                                                                                         Duration="0:0:0.9" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Path.Triggers>
                                                    </Path>
                                                </Viewbox>
                                            </Grid>
                                        </Border>
                                        <!-- Running indicator (Green Dot) -->
                                        <Border Width="9"
                                                Height="9"
                                                CornerRadius="4.5"
                                                Background="#FF10B981"
                                                BorderBrush="#CCFFFFFF"
                                                BorderThickness="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Margin="-2,0,0,-2"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>

                                    <!-- Text Area -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   Grid.Row="0"
                                                   FontSize="{DynamicResource FontSizeNormalPlus}"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextMain}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding EffectiveSubtitle}"
                                                   Grid.Row="1"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource BrushTextSec}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                     <!-- Action Label -->
                                     <StackPanel Grid.Column="2"
                                                 Orientation="Horizontal"
                                                 VerticalAlignment="Center"
                                                 Margin="8,0,5,0">
                                        <Border Background="{DynamicResource BrushBG}"
                                                BorderBrush="{DynamicResource BrushBorderStrong}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding HasGlobalShortcut, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ShortcutLabel}"
                                                       Foreground="{DynamicResource BrushTextSec}"
                                                       FontSize="{DynamicResource FontSizeTiny}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayTypeLabel}" 
                                                   Foreground="{DynamicResource BrushTextSec}" 
                                                   FontSize="{DynamicResource FontSizeSmallPlus}" 
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasDisplayTypeLabel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 2. 商店扩展专用布局 (Source == Cloud) -->
                                <Grid x:Name="CloudExtensionLayout">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="Cloud">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon Area -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border Width="32"
                                                Height="32"
                                                CornerRadius="8"
                                                ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{Binding AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImageIcon}" Value="True">
                                                            <Setter Property="Background" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Image Source="{Binding IconSource}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       SnapsToDevicePixels="True"
                                                       Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Viewbox Margin="6"
                                                         Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Path Width="24"
                                                          Height="24"
                                                          Data="{Binding VectorIcon}"
                                                          Fill="White"
                                                          Stretch="Uniform" />
                                                </Viewbox>
                                                <TextBlock Text="{Binding DisplayGlyph}"
                                                       FontSize="{DynamicResource FontSizeNormalPlus}"
                                                       Foreground="{DynamicResource BrushTextMain}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Text Area -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   Grid.Row="0"
                                                   FontSize="{DynamicResource FontSizeNormalPlus}"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextMain}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding EffectiveSubtitle}"
                                                   Grid.Row="1"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource BrushTextSec}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <!-- Action & Stats Area -->
                                    <StackPanel Grid.Column="2" 
                                                Orientation="Vertical" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Right" 
                                                Margin="8,0,5,0">
                                        <!-- Stats (下载量 & 评分) -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                            <!-- 下载量 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="⤓ " Foreground="{DynamicResource BrushTextMuted}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding InstallCountLabel}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- 评分 -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="★ " Foreground="#FFFFB000" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RatingLabel}" Foreground="{DynamicResource BrushTextSec}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Buttons -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- 试运行：始终显示，是否可用由 HasArchive 决定 -->
                                            <Button Content="试运行"
                                                    Click="StoreDryRunButton_Click"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding HasArchive}"
                                                    Height="22"
                                                    Padding="8,0"
                                                    Margin="0,0,6,0"
                                                    FontSize="11"
                                                    Background="#20FFFFFF"
                                                    Foreground="{DynamicResource BrushTextMain}"
                                                    BorderBrush="#30FFFFFF"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    Focusable="False">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Grid>
                                                <!-- 未安装时显示：安装按钮 -->
                                                <Button Content="安装"
                                                        Click="StoreInstallButton_Click"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding HasArchive}"
                                                        Height="22"
                                                        Padding="10,0"
                                                        FontSize="11"
                                                        Background="{DynamicResource BrushAccent}"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Focusable="False">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- 已安装时显示：已安装标签 -->
                                                <Border Background="#12FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="已安装" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 4. 商店加载中 Loading Overlay -->
                <Grid x:Name="StoreLoadingOverlay"
                      Panel.ZIndex="15"
                      Visibility="Collapsed"
                      Background="#D518181A">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="160"
                                     Height="6"
                                     Foreground="#FF3B82F6"
                                     Background="#33FFFFFF"
                                     BorderThickness="0"
                                     HorizontalAlignment="Center" />
                        <TextBlock Text="正在加载扩展商店..."
                                   Foreground="{DynamicResource BrushTextSec}"
                                   FontSize="{DynamicResource FontSizeNormal}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 3. 商店扩展二级详情 Overlay -->
                <Grid x:Name="StoreExtensionDetailOverlay"
                      Panel.ZIndex="20"
                      Visibility="Collapsed"
                      Background="#F018181A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- 顶部导航 -->
                        <RowDefinition Height="*" />    <!-- 内容区域 -->
                    </Grid.RowDefinitions>
                    
                    <Grid.Style>
                        <!-- 我们加一个简单的淡入动画或者简单的样式 -->
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                    </Grid.Style>

                    <!-- 顶部导航栏 -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="15,10">
                        <Grid>
                            <Button x:Name="CloseStoreDetailButton"
                                    Click="CloseStoreDetailButton_Click"
                                    Width="32" Height="32"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Focusable="False">
                                <TextBlock Text="←" Foreground="{DynamicResource BrushTextMain}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <TextBlock Text="扩展详情" Foreground="{DynamicResource BrushTextMain}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 主体内容 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                        <StackPanel>
                            <!-- 头部基本信息 (图标 & 标题 & 版本 & 作者) -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 大图标 (48x48) -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" ClipToBounds="True" Background="{Binding AccentBrush}" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <Grid>
                                        <Image Source="{Binding IconSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Viewbox Margin="9" Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Width="24" Height="24" Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding DisplayGlyph}" FontSize="20" Foreground="{DynamicResource BrushTextMain}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushTextMain}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource BrushTextSec}" FontSize="12" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding ItemKindLabel}" Foreground="{DynamicResource BrushTextSec}" FontSize="12" Margin="0,0,12,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- 统计胶囊 (下载量 & 评分) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <!-- 下载量胶囊 -->
                                <Border Background="#153B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⤓ " Foreground="{DynamicResource BrushTextMain}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding InstallCountLabel}" Foreground="{DynamicResource BrushTextMain}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text=" 次下载" Foreground="{DynamicResource BrushTextSec}" FontSize="11" Margin="2,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 评分星级胶囊 -->
                                <Border Background="#15FFB000" BorderBrush="#30FFB000" BorderThickness="1" CornerRadius="12" Padding="12,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="★ " Foreground="#FFFFB000" FontSize="12"/>
                                        <TextBlock Text="{Binding RatingLabel}" Foreground="{DynamicResource BrushTextMain}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text=" 评分" Foreground="{DynamicResource BrushTextSec}" FontSize="11" Margin="2,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 详细说明 -->
                            <TextBlock Text="扩展介绍" Foreground="{DynamicResource BrushTextMain}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="#10FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,24,0">
                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource BrushTextMain}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </Border>

                            <!-- 操作大按钮 -->
                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
                                        Content="试运行" 
                                        Click="StoreDryRunButton_Click" 
                                        Tag="{Binding}"
                                         IsEnabled="{Binding HasArchive}" 
                                        Height="36" 
                                        Margin="0,0,6,0" 
                                        Background="#20FFFFFF" 
                                        Foreground="{DynamicResource BrushTextMain}" 
                                        BorderBrush="#35FFFFFF" 
                                        BorderThickness="1" 
                                        Cursor="Hand"
                                        Focusable="False">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                
                                <Button Grid.Column="1" 
                                        Content="安装到本机" 
                                        Click="StoreInstallButton_Click" 
                                        Tag="{Binding}"
                                        IsEnabled="{Binding HasArchive}" 
                                        Height="36" 
                                        Margin="6,0,0,0" 
                                        Background="{DynamicResource BrushAccent}" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        Cursor="Hand"
                                        Focusable="False">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 已安装置灰状态：只占右侧一列 -->
                                <Border Grid.Column="1" 
                                        Background="#15FFFFFF" 
                                        BorderBrush="#20FFFFFF" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Height="36" 
                                        Margin="6,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="已安装此扩展" Foreground="{DynamicResource BrushTextMuted}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid Grid.RowSpan="3"
                  Margin="18,16,18,16"
                  Panel.ZIndex="25"
                  Visibility="{Binding AiChatVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧话题列表 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushDialogBG}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="20,18"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="对话历史"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeLargePlus}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AiChatModelDisplayText}"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource BrushTextSec}"
                                               FontSize="{DynamicResource FontSizeSmall}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource BrushSecondaryBtnBG}"
                                        BorderBrush="{DynamicResource BrushBorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Esc 返回"
                                               Foreground="{DynamicResource BrushTextSec}"
                                               FontSize="{DynamicResource FontSizeSmall}" />
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,8,0,8"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AiChatTopics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:AiChatTopic}">
                                        <Border x:Name="TopicItem"
                                                Margin="12,8,12,0"
                                                Padding="14,12"
                                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="AiChatTopicItem_MouseLeftButtonUp"
                                                MouseRightButtonUp="AiChatTopicItem_MouseRightButtonUp">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{DynamicResource BrushTextMain}"
                                                           FontSize="{DynamicResource FontSizeNormal}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PreviewText}"
                                                           Margin="0,7,0,0"
                                                           Foreground="{DynamicResource BrushTextSec}"
                                                           FontSize="{DynamicResource FontSizeSmallPlus}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="36"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                           Margin="0,8,0,0"
                                                           Foreground="{DynamicResource BrushTextMuted}"
                                                           FontSize="{DynamicResource FontSizeSmall}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="TopicItem" Property="Background" Value="{DynamicResource BrushListViewItemSelectedBG}" />
                                                <Setter TargetName="TopicItem" Property="BorderBrush" Value="#FF3B82F6" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TopicItem" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2"
                                Padding="12"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="0,1,0,0">
                            <Button Height="42"
                                    Background="{DynamicResource BrushSecondaryBtnBG}"
                                    BorderBrush="{DynamicResource BrushBorderStrong}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource BrushTextMain}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="AiChatNewTopicButton_Click"
                                    Style="{DynamicResource GhostButtonStyle}">
                                <TextBlock Text="+ 新建对话"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold" />
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右侧对话区域 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部工具栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedAiChatTopic.Title}"
                                       Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AiChatModelDisplayText}"
                                       Margin="0,5,0,0"
                                       Foreground="{DynamicResource BrushTextSec}"
                                       FontSize="{DynamicResource FontSizeSmall}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Margin="0,0,10,0"
                                Padding="18,8"
                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                BorderBrush="{DynamicResource BrushBorderStrong}"
                                BorderThickness="1"
                                Foreground="{DynamicResource BrushTextMain}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="AiChatRenameTopicButton_Click"
                                Style="{DynamicResource GhostButtonStyle}">
                            <TextBlock Text="重命名" FontSize="{DynamicResource FontSizeSmallPlus}" />
                        </Button>

                        <Button Grid.Column="2"
                                Margin="0,0,10,0"
                                Padding="18,8"
                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                BorderBrush="#FF4B2E35"
                                BorderThickness="1"
                                Foreground="#FFFCA5A5"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="AiChatDeleteTopicButton_Click"
                                Style="{DynamicResource GhostButtonStyle}">
                            <TextBlock Text="删除" FontSize="{DynamicResource FontSizeSmallPlus}" />
                        </Button>

                        <Button Grid.Column="3"
                                Margin="0,0,10,0"
                                Padding="18,8"
                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                BorderBrush="{DynamicResource BrushBorderStrong}"
                                BorderThickness="1"
                                Foreground="{DynamicResource BrushTextMain}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip="打开 AI 设置"
                                Click="AiChatSettingsButton_Click"
                                Style="{DynamicResource GhostButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="{DynamicResource FontSizeNormal}" Margin="0,0,4,0" />
                                <TextBlock Text="设置" FontSize="{DynamicResource FontSizeSmallPlus}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 消息列表 -->
                    <Border Grid.Row="1"
                            Margin="0,0,0,16"
                            Background="{DynamicResource BrushDialogBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <ScrollViewer x:Name="AiChatScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AiChatMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:AiChatMessage}">
                                            <StackPanel x:Name="MessageContainer" 
                                                       Margin="0,0,0,16"
                                                       HorizontalAlignment="Left">
                                                <Border x:Name="Bubble"
                                                        MaxWidth="600"
                                                        Padding="16,12"
                                                        Background="{DynamicResource BrushSecondaryBtnBG}"
                                                        CornerRadius="14"
                                                        Cursor="Hand"
                                                        MouseRightButtonUp="AiChatMessageBubble_MouseRightButtonUp">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Text}"
                                                                   Foreground="{DynamicResource BrushTextMain}"
                                                                   FontSize="{DynamicResource FontSizeNormalPlus}"
                                                                   LineHeight="22"
                                                                   TextWrapping="Wrap" />
                                                        <ItemsControl ItemsSource="{Binding Attachments}"
                                                                      Visibility="{Binding AttachmentsVisibility}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type local:AiChatMessageAttachment}">
                                                                    <Border Margin="0,10,0,0"
                                                                            Padding="10,8"
                                                                            Background="{DynamicResource BrushSecondaryBtnBG}"
                                                                            BorderBrush="#33FFFFFF"
                                                                            BorderThickness="1"
                                                                            CornerRadius="10">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding FileName}"
                                                                                       Foreground="{DynamicResource BrushTextMain}"
                                                                                       FontSize="{DynamicResource FontSizeSmallPlus}"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding FileSizeText}"
                                                                                       Margin="0,4,0,0"
                                                                                       Foreground="{DynamicResource BrushTextMain}"
                                                                                       FontSize="{DynamicResource FontSizeSmall}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="TimeStamp"
                                                           Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                                           Margin="12,6,0,0"
                                                           Foreground="{DynamicResource BrushTextMuted}"
                                                           FontSize="{DynamicResource FontSizeSmall}" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter TargetName="MessageContainer" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="Bubble" Property="Background" Value="#FF3B82F6" />
                                                    <Setter TargetName="TimeStamp" Property="Margin" Value="0,6,12,0" />
                                                    <Setter TargetName="TimeStamp" Property="TextAlignment" Value="Right" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Visibility="{Binding NoTopicVisibility}">
                                <TextBlock Text="选择左侧话题，或创建一个新对话。"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeLarge}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 附件列表 -->
                    <Border Grid.Row="2"
                            Margin="0,0,0,12"
                            Background="{DynamicResource BrushSecondaryBtnBG}"
                            BorderBrush="{DynamicResource BrushBorderStrong}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Visibility="{Binding AttachmentsVisibility}">
                        <ItemsControl ItemsSource="{Binding AiChatAttachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AiChatAttachment}">
                                    <Border Margin="0,0,0,8"
                                            Padding="12,10"
                                            Background="{DynamicResource BrushSecondaryBtnBG}"
                                            BorderBrush="{DynamicResource BrushBorderStrong}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="{DynamicResource BrushTextMain}"
                                                           FontSize="{DynamicResource FontSizeNormal}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FileSizeText}"
                                                           Margin="0,5,0,0"
                                                           Foreground="{DynamicResource BrushTextSec}"
                                                           FontSize="{DynamicResource FontSizeSmall}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Text="已附加" />
                                            <Button Grid.Column="2"
                                                    Tag="{Binding}"
                                                    Width="28"
                                                    Height="28"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="AiChatRemoveAttachmentButton_Click">
                                                <TextBlock Text="×"
                                                           Foreground="{DynamicResource BrushTextMain}"
                                                           FontSize="{DynamicResource FontSizeSubtitle}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 输入框 -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource BrushDialogBG}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,14"
                            AllowDrop="True"
                            Drop="AiChatInputArea_Drop"
                            DragOver="AiChatInputArea_DragOver">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="1" Opacity="0.2"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource BrushSecondaryBtnBG}"
                                    BorderBrush="{DynamicResource BrushBorderStrong}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="添加附件"
                                    Click="AiChatAddAttachmentButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="999">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="+"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-2,0,0" />
                            </Button>

                            <Grid Grid.Column="1">
                                <TextBox x:Name="AiChatInputBox"
                                         Text="{Binding AiChatInputText, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{DynamicResource FontSizeLargePlus}"
                                         Foreground="{DynamicResource BrushTextMain}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="#FF3B82F6"
                                         VerticalAlignment="Center"
                                         Padding="0,5"
                                         PreviewKeyDown="AiChatInputBox_PreviewKeyDown" />
                                <TextBlock IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextSec}"
                                           FontSize="{DynamicResource FontSizeLargePlus}"
                                           Text="继续对话..."
                                           Visibility="{Binding AiChatInputPlaceholderVisibility}" />
                            </Grid>

                            <Button Grid.Column="2"
                                    Width="42"
                                    Height="42"
                                    Margin="14,0,0,0"
                                    Background="#FF3B82F6"
                                    BorderBrush="#00000000"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AiChatSendButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="➜"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeSubtitle}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 底部状态栏 -->
                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Tab 切换标签 · Shift+Enter 换行 · Esc 返回搜索"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   FontSize="{DynamicResource FontSizeSmallPlus}"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding AiChatStatusText}"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   FontSize="{DynamicResource FontSizeSmallPlus}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="1"
                    Margin="16,10,16,8"
                    Padding="18"
                    Background="{DynamicResource BrushDialogBG}"
                    BorderBrush="#FF323232"
                    BorderThickness="1"
                    CornerRadius="14"
                    Panel.ZIndex="20"
                    Visibility="{Binding IsHostedViewOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Width="34"
                                Height="34"
                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                BorderBrush="{DynamicResource BrushBorderStrong}"
                                BorderThickness="1"
                                Foreground="{DynamicResource BrushTextMain}"
                                FontSize="{DynamicResource FontSizeNormalPlus}"
                                Click="CloseHostedViewButton_Click">
                            <TextBlock Text="←"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HostedViewTitle}"
                                       Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HostedViewSubtitle}"
                                       Foreground="#FF8A8A8A"
                                       FontSize="{DynamicResource FontSizeSmallPlus}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                BorderBrush="{DynamicResource BrushBorderStrong}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,5"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding HostedViewCommandLabel}"
                                       Foreground="{DynamicResource BrushTextSec}"
                                       FontSize="{DynamicResource FontSizeSmall}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,0" Visibility="{Binding HostedViewLegacyVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                BorderBrush="#FF2E2E2E"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding HostedViewInputLabel}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold" />

                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <TextBox x:Name="HostedViewInputBox"
                                             Text="{Binding HostedViewInput, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             TextWrapping="Wrap"
                                             Background="{DynamicResource BrushBG}"
                                             BorderBrush="#FF2E2E2E"
                                             BorderThickness="1"
                                             Foreground="{DynamicResource BrushTextMain}"
                                             CaretBrush="#FF3B82F6"
                                             Padding="12"
                                             FontSize="{DynamicResource FontSizeNormalPlus}"
                                             TextChanged="HostedViewInputBox_TextChanged" />

                                    <TextBlock IsHitTestVisible="False"
                                               Margin="14,12,14,0"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               Text="{Binding HostedViewInputPlaceholder}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=HostedViewInputBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource BrushSecondaryBtnBG}"
                                BorderBrush="#FF2E2E2E"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding HostedViewOutputLabel}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="{DynamicResource FontSizeNormal}"
                                           FontWeight="SemiBold" />

                                <Border Grid.Row="1"
                                        Margin="0,10,0,0"
                                        Background="{DynamicResource BrushBG}"
                                        BorderBrush="#FF2E2E2E"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <TextBox Text="{Binding HostedViewOutput}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             TextWrapping="Wrap"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#FFE5E5E5"
                                             CaretBrush="#FF3B82F6"
                                             Padding="0"
                                             FontSize="{DynamicResource FontSizeNormalPlus}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <ContentControl Grid.Row="1"
                                    Margin="0,18,0,0"
                                    Content="{Binding HostedViewDynamicContent}"
                                    Visibility="{Binding HostedViewDynamicVisibility}" />

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding HostedViewStatus}"
                                   Foreground="#FF818181"
                                   FontSize="{DynamicResource FontSizeSmallPlus}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,14,0" />

                        <Button Grid.Column="1"
                                Content="{Binding HostedViewActionButtonText}"
                                Background="#FF2563EB"
                                Foreground="{DynamicResource BrushTextMain}"
                                BorderThickness="0"
                                Padding="18,10"
                                FontSize="{DynamicResource FontSizeNormal}"
                                FontWeight="SemiBold"
                                Click="HostedViewRunButton_Click"
                                Visibility="{Binding HostedViewFooterActionVisibility}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushBG}"
                    CornerRadius="0"
                    Padding="20,10"
                    Visibility="{Binding NormalLauncherVisibility}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FooterAddExtensionButton"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="0,0,10,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="添加扩展"
                                AllowDrop="True"
                                Click="FooterAddExtensionButton_Click"
                                PreviewDragEnter="FooterAddExtensionButton_DragEnter"
                                PreviewDragOver="FooterAddExtensionButton_DragOver"
                                PreviewDrop="FooterAddExtensionButton_Drop"
                                Style="{DynamicResource GhostButtonStyle}">
                            <Viewbox Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stretch="Uniform">
                                <Canvas Width="1024" Height="1024">
                                    <Path Data="{local:IconGeometry plus}" Fill="{DynamicResource BrushTextMain}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="FooterQuickMenuButton"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="0,0,12,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="FooterQuickMenuButton_Click"
                                Style="{DynamicResource GhostButtonStyle}">
                            <Path Data="{local:IconGeometry dots-horizontal}" Fill="{DynamicResource BrushTextMain}" Height="14" Width="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterMenuHintText"
                                   Text="右箭头菜单"
                                   Foreground="{DynamicResource BrushTextSec}"
                                   FontSize="{DynamicResource FontSizeSmallPlus}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushBG}"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="FooterMenuHintKeyText"
                                       Text="→"
                                       Foreground="{DynamicResource BrushTextSec}"
                                       FontSize="{DynamicResource FontSizeTiny}"/>
                        </Border>
                    </StackPanel>

                    <Popup x:Name="FooterQuickMenuPopup"
                           Placement="Top"
                           PlacementTarget="{Binding ElementName=FooterQuickMenuButton}"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False">
                        <Border Width="280"
                                Margin="0,0,0,16"
                                Background="{DynamicResource BrushDialogBG}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="4" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel Margin="10">
                                <!-- Header Section -->
                                <StackPanel Margin="10,6,10,12">
                                    <TextBlock Text="快捷操作"
                                               Foreground="{DynamicResource BrushTextMain}"
                                               FontSize="{DynamicResource FontSizeLarge}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="快速执行常用动作，无需搜索。"
                                               Foreground="{DynamicResource BrushTextSec}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Separator Background="{DynamicResource BrushSeparator}" Margin="6,0,6,8"/>

                                <Button Style="{DynamicResource GhostButtonStyle}"
                                        ToolTip="把程序内置技能组复制到外部文件夹进行编辑或备份"
                                        HorizontalContentAlignment="Stretch" Click="QuickMenuInstallSkill_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{local:IconGeometry skill-export}"
                                              Stroke="{DynamicResource BrushTextMain}" StrokeThickness="1.4" Height="16" Width="16" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.9"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="导出 Skill" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button Style="{DynamicResource GhostButtonStyle}"
                                        ToolTip="进入设置页调整程序同步、外观及各项偏好"
                                        HorizontalContentAlignment="Stretch" Click="QuickMenuOpenSettings_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{local:IconGeometry settings}" 
                                              Fill="{DynamicResource BrushTextMain}" Height="18" Width="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="设置" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button Style="{DynamicResource GhostButtonStyle}"
                                        ToolTip="强制重新同步当前账户下的云端扩展状态"
                                        HorizontalContentAlignment="Stretch" Click="QuickMenuRefreshCloud_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{local:IconGeometry refresh}" 
                                              Stroke="{DynamicResource BrushTextMain}" StrokeThickness="1.5" Height="16" Width="16" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.9"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="刷新云端" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Rectangle Height="1" Fill="{DynamicResource BrushSeparator}" Margin="6,10" />

                                <Button Style="{DynamicResource GhostButtonStyle}"
                                        ToolTip="打开本地使用说明与扩展开发参考文档"
                                        HorizontalContentAlignment="Stretch" Click="QuickMenuOpenDocs_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{local:IconGeometry help-docs}" 
                                              Stroke="{DynamicResource BrushTextMain}" StrokeThickness="1.2" Height="16" Width="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="帮助文档" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button Style="{DynamicResource GhostButtonStyle}"
                                        ToolTip="查看 燕子 (Swallow) 的版本信息与产品声明"
                                        HorizontalContentAlignment="Stretch" Click="QuickMenuOpenAbout_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Stylized Swallow Bird Icon -->
                                        <Path Data="{local:IconGeometry about}" 
                                              Fill="{DynamicResource BrushAccent}" Height="16" Width="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="关于燕子" Foreground="{DynamicResource BrushTextMain}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>


        </Grid>
    </Border>
</Window>
