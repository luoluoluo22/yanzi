<Window x:Class="OpenQuickHost.ScheduleConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenQuickHost"
        Title="定时运行设置"
        Width="500"
        SizeToContent="Height"
        MinHeight="160"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Window.Resources>
        <!-- Switch Style (copied from SettingsWindow) -->
        <Style x:Key="ScheduleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20">
                            <Border x:Name="Track" CornerRadius="10" Background="#FF333333" />
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="2,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Fill="White">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF3B82F6" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="16" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment Button -->
        <Style x:Key="SegBtnBase" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Day-of-week chip -->
        <Style x:Key="DowChipBase" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Interval chip -->
        <Style x:Key="IntervalChipBase" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Dark ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF2D2D2D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1A3B82F6"/>
                                <Setter Property="Foreground" Value="#FF93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <ToggleButton x:Name="ToggleBtn"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              x:Name="ContentSite"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="{TemplateBinding Padding}"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     CaretBrush="White"
                                     FontSize="{TemplateBinding FontSize}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Visibility="Collapsed"/>
                            <Path Width="10" Height="6"
                                  HorizontalAlignment="Right" Margin="0,0,10,0"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 5 5 L 10 0"
                                  Stroke="#FF8E8E8E" StrokeThickness="1.5"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Border Background="#FF1E1E1E"
                                        BorderBrush="#FF2A2A2A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,0"
                                        MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="1"
            CornerRadius="12"
            Background="#F2161616"
            BorderBrush="#22FFFFFF"
            BorderThickness="1">
        <StackPanel Margin="24,20,24,20">

            <!-- ══════════ Row 1: 定时运行 [开关] ══════════ -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="定时运行" Foreground="White" FontSize="{DynamicResource FontSizeNormalPlus}" FontWeight="SemiBold"/>
                    <TextBlock Text="按设定的时间周期自动运行此扩展" Foreground="#FF6B7280" FontSize="{DynamicResource FontSizeSmall}" Margin="0,3,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="1"
                          x:Name="EnableToggle"
                          Style="{StaticResource ScheduleSwitchStyle}"
                          VerticalAlignment="Center"
                          Checked="EnableToggle_Changed"
                          Unchecked="EnableToggle_Changed"/>
            </Grid>

            <!-- ══════════ Expandable Config (visible when enabled) ══════════ -->
            <StackPanel x:Name="ConfigPanel" Visibility="Collapsed" Margin="0,18,0,0">

                <!-- Divider -->
                <Rectangle Height="1" Fill="#FF232323" Margin="0,0,0,18"/>

                <!-- ── 调度模式 ── -->
                <TextBlock Text="调度模式" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ModeSimpBtn" Grid.Column="0" Style="{StaticResource SegBtnBase}" MouseLeftButtonDown="ModeSimpBtn_Click">
                        <TextBlock x:Name="ModeSimpText" Text="简单设置" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="ModeCronBtn" Grid.Column="2" Style="{StaticResource SegBtnBase}" MouseLeftButtonDown="ModeCronBtn_Click">
                        <TextBlock x:Name="ModeCronText" Text="Cron 表达式" FontSize="{DynamicResource FontSizeNormal}" FontWeight="Medium" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- ═══════ SIMPLE PANEL ═══════ -->
                <StackPanel x:Name="SimpleModePanel">

                    <!-- ── 频率 ── -->
                    <TextBlock Text="运行频率" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,18">
                        <Border x:Name="FreqMinBtn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="FreqBtn_Click" Tag="min">
                            <TextBlock Text="按分钟" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="FreqHourBtn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="FreqBtn_Click" Tag="hour">
                            <TextBlock Text="按小时" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="FreqDailyBtn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="FreqBtn_Click" Tag="daily">
                            <TextBlock Text="每天" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="FreqWeekBtn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="FreqBtn_Click" Tag="week">
                            <TextBlock Text="每周" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="FreqMonthBtn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="FreqBtn_Click" Tag="month">
                            <TextBlock Text="每月" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                        </Border>
                    </WrapPanel>

                    <!-- ── 按分钟 ── -->
                    <StackPanel x:Name="MinutePanel" Visibility="Collapsed" Margin="0,0,0,18">
                        <TextBlock Text="间隔" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Border x:Name="Min5Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="MinChip_Click" Tag="5">
                                <TextBlock Text="5 分钟" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Min10Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="MinChip_Click" Tag="10">
                                <TextBlock Text="10 分钟" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Min15Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="MinChip_Click" Tag="15">
                                <TextBlock Text="15 分钟" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Min30Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="MinChip_Click" Tag="30">
                                <TextBlock Text="30 分钟" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Min45Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="MinChip_Click" Tag="45">
                                <TextBlock Text="45 分钟" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                        </WrapPanel>
                        <!-- 自定义分钟输入 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="自定义：" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmallPlus}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="CustomMinuteBox" Width="60" Height="32" Padding="8,6"
                                     FontSize="{DynamicResource FontSizeNormal}" TextChanged="CustomMinuteBox_TextChanged"
                                     ToolTip="输入 1-59 之间的数字"/>
                            <TextBlock Text="分钟" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmallPlus}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── 按小时 ── -->
                    <StackPanel x:Name="HourPanel" Visibility="Collapsed" Margin="0,0,0,18">
                        <TextBlock Text="间隔" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Border x:Name="Hr1Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="HrChip_Click" Tag="1">
                                <TextBlock Text="1 小时" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Hr2Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="HrChip_Click" Tag="2">
                                <TextBlock Text="2 小时" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Hr3Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="HrChip_Click" Tag="3">
                                <TextBlock Text="3 小时" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Hr4Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="HrChip_Click" Tag="4">
                                <TextBlock Text="4 小时" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Hr6Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="HrChip_Click" Tag="6">
                                <TextBlock Text="6 小时" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Hr12Btn" Style="{StaticResource IntervalChipBase}" Margin="0,0,8,8" MouseLeftButtonDown="HrChip_Click" Tag="12">
                                <TextBlock Text="12 小时" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ── 每天 ── -->
                    <StackPanel x:Name="DailyPanel" Visibility="Collapsed" Margin="0,0,0,18">
                        <TextBlock Text="时间" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="#FF1A1A1A" BorderBrush="#FF2E2E2E" BorderThickness="1" CornerRadius="8" Padding="16,0" Height="44">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="DailyHourBox" Width="64" Height="32" IsEditable="True" SelectionChanged="TimeChanged" LostFocus="EditableCombo_LostFocus"/>
                                <TextBlock Text=" : " Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeLargePlus}" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="DailyMinBox" Width="64" Height="32" IsEditable="True" SelectionChanged="TimeChanged" LostFocus="EditableCombo_LostFocus"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 每周 ── -->
                    <StackPanel x:Name="WeeklyPanel" Visibility="Collapsed" Margin="0,0,0,18">
                        <TextBlock Text="星期" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,14">
                            <Border x:Name="DowMon" Style="{StaticResource DowChipBase}" Margin="0,0,6,0" MouseLeftButtonDown="DowChip_Click" Tag="1">
                                <TextBlock Text="一" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="DowTue" Style="{StaticResource DowChipBase}" Margin="0,0,6,0" MouseLeftButtonDown="DowChip_Click" Tag="2">
                                <TextBlock Text="二" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="DowWed" Style="{StaticResource DowChipBase}" Margin="0,0,6,0" MouseLeftButtonDown="DowChip_Click" Tag="3">
                                <TextBlock Text="三" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="DowThu" Style="{StaticResource DowChipBase}" Margin="0,0,6,0" MouseLeftButtonDown="DowChip_Click" Tag="4">
                                <TextBlock Text="四" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="DowFri" Style="{StaticResource DowChipBase}" Margin="0,0,6,0" MouseLeftButtonDown="DowChip_Click" Tag="5">
                                <TextBlock Text="五" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="DowSat" Style="{StaticResource DowChipBase}" Margin="0,0,6,0" MouseLeftButtonDown="DowChip_Click" Tag="6">
                                <TextBlock Text="六" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="DowSun" Style="{StaticResource DowChipBase}" Margin="0,0,0,0" MouseLeftButtonDown="DowChip_Click" Tag="7">
                                <TextBlock Text="日" FontSize="{DynamicResource FontSizeSmallPlus}" Foreground="#FF8E8E8E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="时间" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="#FF1A1A1A" BorderBrush="#FF2E2E2E" BorderThickness="1" CornerRadius="8" Padding="16,0" Height="44">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="WeeklyHourBox" Width="64" Height="32" IsEditable="True" SelectionChanged="TimeChanged" LostFocus="EditableCombo_LostFocus"/>
                                <TextBlock Text=" : " Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeLargePlus}" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="WeeklyMinBox" Width="64" Height="32" IsEditable="True" SelectionChanged="TimeChanged" LostFocus="EditableCombo_LostFocus"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 每月 ── -->
                    <StackPanel x:Name="MonthlyPanel" Visibility="Collapsed" Margin="0,0,0,18">
                        <TextBlock Text="日期（每月第几天）" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,14" x:Name="MonthDayWrap"/>
                        <TextBlock Text="时间" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="#FF1A1A1A" BorderBrush="#FF2E2E2E" BorderThickness="1" CornerRadius="8" Padding="16,0" Height="44">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="MonthlyHourBox" Width="64" Height="32" IsEditable="True" SelectionChanged="TimeChanged" LostFocus="EditableCombo_LostFocus"/>
                                <TextBlock Text=" : " Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeLargePlus}" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="MonthlyMinBox" Width="64" Height="32" IsEditable="True" SelectionChanged="TimeChanged" LostFocus="EditableCombo_LostFocus"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══════ CRON PANEL ═══════ -->
                <StackPanel x:Name="CronModePanel" Visibility="Collapsed" Margin="0,0,0,18">
                    <TextBlock Text="Cron 表达式" Foreground="#FF8E8E8E" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBox x:Name="CronBox" Height="44" Padding="14,12" FontFamily="Consolas" FontSize="{DynamicResource FontSizeNormalPlus}" TextChanged="CronBox_TextChanged"
                             ToolTip="例：0 9 * * * 表示每天 09:00"/>
                    <TextBlock Text="格式：分 时 日 月 周  （* 表示任意）" Foreground="#FF555555" FontSize="{DynamicResource FontSizeSmall}" Margin="0,6,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource IntervalChipBase}" Margin="0,0,8,6" MouseLeftButtonDown="CronExample_Click" Tag="*/30 * * * *">
                            <TextBlock Text="每30分钟" FontSize="{DynamicResource FontSizeSmall}" Foreground="#FF8E8E8E"/>
                        </Border>
                        <Border Style="{StaticResource IntervalChipBase}" Margin="0,0,8,6" MouseLeftButtonDown="CronExample_Click" Tag="0 * * * *">
                            <TextBlock Text="每小时" FontSize="{DynamicResource FontSizeSmall}" Foreground="#FF8E8E8E"/>
                        </Border>
                        <Border Style="{StaticResource IntervalChipBase}" Margin="0,0,8,6" MouseLeftButtonDown="CronExample_Click" Tag="0 9 * * *">
                            <TextBlock Text="每天9点" FontSize="{DynamicResource FontSizeSmall}" Foreground="#FF8E8E8E"/>
                        </Border>
                        <Border Style="{StaticResource IntervalChipBase}" Margin="0,0,8,6" MouseLeftButtonDown="CronExample_Click" Tag="0 9 * * 1-5">
                            <TextBlock Text="工作日9点" FontSize="{DynamicResource FontSizeSmall}" Foreground="#FF8E8E8E"/>
                        </Border>
                        <Border Style="{StaticResource IntervalChipBase}" Margin="0,0,8,6" MouseLeftButtonDown="CronExample_Click" Tag="0 9 1 * *">
                            <TextBlock Text="每月1日" FontSize="{DynamicResource FontSizeSmall}" Foreground="#FF8E8E8E"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- ── Preview ── -->
                <Border x:Name="PreviewBorder"
                        Background="#0D3B82F6" BorderBrush="#1A3B82F6" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,18" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✅  " Foreground="#FF3B82F6" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PreviewText" Foreground="#FFD1D5DB" FontSize="{DynamicResource FontSizeNormal}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════════ Buttons ══════════ -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="#FFEF4444" FontSize="{DynamicResource FontSizeSmallPlus}" TextWrapping="Wrap" Visibility="Collapsed"/>
                <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryBtn}" Width="90" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button Grid.Column="2" Content="确认" Style="{StaticResource PrimaryBtn}" Width="90" Click="OkButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
