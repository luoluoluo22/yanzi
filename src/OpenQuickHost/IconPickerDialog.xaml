<Window x:Class="OpenQuickHost.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="选择图标" Width="580" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <!-- 精美滚动条样式 -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" ViewportSize="{TemplateBinding ViewportWidth}" Width="6" Margin="2,0,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 窄边滚动条滑块样式 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource BrushBorder}" BorderThickness="0" Width="6">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF16161B" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5" CornerRadius="16" SnapsToDevicePixels="True">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <!-- 顶部标题栏 -->
                <RowDefinition Height="Auto" />
                <!-- 搜索框 -->
                <RowDefinition Height="Auto" />
                <!-- 图标列表 -->
                <RowDefinition Height="*" />
                <!-- 底部按钮 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" Margin="2,2,2,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <TextBlock Text="选择内置图标" Foreground="{DynamicResource BrushTextMain}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Click="CancelButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="14">
                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="{DynamicResource BrushTextSec}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                    <Setter Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 搜索框 -->
            <Border Grid.Row="1" Background="{DynamicResource BrushSecondaryBtnBG}" CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="2,0,2,16">
                <Grid Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="{DynamicResource BrushTextSec}" Width="14" Height="14" Margin="12,0,8,0" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="0,0,12,0"
                             Foreground="{DynamicResource BrushTextMain}" FontSize="13.5" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource BrushAccent}" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                    <TextBlock Grid.Column="1" Text="搜索内置图标名称..." Foreground="{DynamicResource BrushTextSec}" FontSize="13.5"
                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Opacity="0.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 图标列表 -->
            <ListBox x:Name="IconsListBox" Grid.Row="2" Margin="2,0,2,16" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single" SelectionChanged="IconsListBox_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="itemBorder" Width="80" Height="80" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4">
                                            <!-- 图标渲染 -->
                                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                                                <Path x:Name="vectorPath" Data="{Binding Geometry}" Fill="{DynamicResource BrushTextMain}" Opacity="0.75" Stretch="Uniform" />
                                            </Viewbox>
                                            <!-- 文字描述 -->
                                            <TextBlock x:Name="labelTxt" Text="{Binding Label}" Foreground="{DynamicResource BrushTextSec}" FontSize="11" TextAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                            <Setter TargetName="labelTxt" Property="Foreground" Value="{DynamicResource BrushTextMain}" />
                                            <Setter TargetName="vectorPath" Property="Opacity" Value="1.0" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BrushSecondaryBtnBG}" />
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                                            <Setter TargetName="labelTxt" Property="Foreground" Value="{DynamicResource BrushAccent}" />
                                            <Setter TargetName="vectorPath" Property="Fill" Value="{DynamicResource BrushAccent}" />
                                            <Setter TargetName="vectorPath" Property="Opacity" Value="1.0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 底部按钮 -->
            <Grid Grid.Row="3" Margin="2,0,2,2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{DynamicResource GhostButtonStyle}" Height="32" Padding="16,0" Click="CancelButton_Click" Cursor="Hand" />
                    <Button Content="确认" Style="{DynamicResource GhostButtonStyle}" BorderBrush="{DynamicResource BrushAccent}" Height="32" Padding="16,0" Margin="10,0,0,0" Click="ConfirmButton_Click" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
