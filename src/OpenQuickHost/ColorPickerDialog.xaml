<Window x:Class="OpenQuickHost.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="颜色选择" Width="300" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Border Background="#FF16161B" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5" CornerRadius="16" SnapsToDevicePixels="True">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- 顶部标题 -->
                <RowDefinition Height="Auto" />
                <!-- 画布 (S/B) -->
                <RowDefinition Height="160" />
                <!-- 色相 (H) -->
                <RowDefinition Height="12" />
                <!-- 透明度 (A) -->
                <RowDefinition Height="12" />
                <!-- 输入行 (吸管、HEX、Alpha) -->
                <RowDefinition Height="Auto" />
                <!-- 常用色板 -->
                <RowDefinition Height="Auto" />
                <!-- 底部按钮 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. 顶部标题 -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <TextBlock Text="颜色" Foreground="{DynamicResource BrushTextMain}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24" Click="CancelButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="12">
                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="{DynamicResource BrushTextSec}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushListViewItemMouseOver}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. S/B 画布 -->
            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12">
                <Grid x:Name="SbCanvas" Background="Red" MouseDown="SbCanvas_MouseDown" MouseMove="SbCanvas_MouseMove" MouseUp="SbCanvas_MouseUp" Cursor="Cross">
                    <!-- 白色到透明渐变 (水平) -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- 透明到黑色渐变 (垂直) -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- 游标 -->
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="SbCursor" Width="10" Height="10" Stroke="White" StrokeThickness="1.5" Fill="Transparent" Margin="-5,-5,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.5" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
            </Border>

            <!-- 3. 色相滑块 (H) -->
            <Border Grid.Row="2" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,10">
                <Grid x:Name="HueTrack" MouseDown="HueTrack_MouseDown" MouseMove="HueTrack_MouseMove" MouseUp="HueTrack_MouseUp" Cursor="Hand">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0.0" />
                            <GradientStop Color="#FFFF00" Offset="0.167" />
                            <GradientStop Color="#00FF00" Offset="0.333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.667" />
                            <GradientStop Color="#FF00FF" Offset="0.833" />
                            <GradientStop Color="#FF0000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="HueCursor" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent" Margin="-6,0,0,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.5" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
            </Border>

            <!-- 4. 透明度滑块 (A) -->
            <Border Grid.Row="3" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,14">
                <Grid x:Name="AlphaTrack" MouseDown="AlphaTrack_MouseDown" MouseMove="AlphaTrack_MouseMove" MouseUp="AlphaTrack_MouseUp" Cursor="Hand">
                    <!-- 棋盘格背景 -->
                    <Grid.Background>
                        <VisualBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid Width="8" Height="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="4" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="4" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Column="0" Grid.Row="0" Background="#FF222226" />
                                    <Border Grid.Column="1" Grid.Row="0" Background="#FF16161B" />
                                    <Border Grid.Column="0" Grid.Row="1" Background="#FF16161B" />
                                    <Border Grid.Column="1" Grid.Row="1" Background="#FF222226" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Grid.Background>
                    <!-- 当前颜色透明度渐变层 -->
                    <Border x:Name="AlphaBackgroundMask" CornerRadius="0">
                        <Border.Background>
                            <LinearGradientBrush x:Name="AlphaBrush" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#FFFFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="AlphaCursor" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent" Margin="-6,0,0,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.5" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
            </Border>

            <!-- 5. 输入行 (吸管、HEX、Alpha) -->
            <Grid Grid.Row="4" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="65" />
                </Grid.ColumnDefinitions>
                <!-- 吸管按钮 -->
                <Button x:Name="DropperBtn" Grid.Column="0" Style="{DynamicResource GhostButtonStyle}" Width="34" Height="30" Padding="0" Click="DropperBtn_Click" ToolTip="屏幕拾色吸管">
                    <Path Data="M19.35,10.04C18.67,10.04 18.06,10.3 17.59,10.73L16.27,9.41L17.59,8.09L15.47,5.97L14.15,7.29L12.83,5.97C13.26,5.5 13.52,4.89 13.52,4.21C13.52,2.99 12.53,2 11.31,2C10.74,2 10.23,2.22 9.85,2.58L10.91,3.64C11.05,3.5 11.23,3.41 11.43,3.41C11.87,3.41 12.23,3.77 12.23,4.21C12.23,4.41 12.14,4.59 12,4.73L6.87,9.86C6.73,9.72 6.55,9.63 6.35,9.63C5.91,9.63 5.55,9.99 5.55,10.43C5.55,10.63 5.64,10.81 5.78,10.95L2,14.73V19H6.27L10.05,15.22C10.19,15.36 10.37,15.45 10.57,15.45C11.01,15.45 11.37,15.09 11.37,14.65C11.37,14.45 11.28,14.27 11.14,14.13L16.27,9C16.41,9.14 16.59,9.23 16.79,9.23C17.23,9.23 17.59,8.87 17.59,8.43L19.35,10.04M4.86,17.59H3.41V16.14L6,13.55L7.45,15L4.86,17.59Z"
                          Fill="{DynamicResource BrushTextMain}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <!-- HEX 输入框 -->
                <TextBox x:Name="HexInput" Grid.Column="1" Style="{DynamicResource FormTextBoxStyle}" Height="30" Margin="8,0,8,0"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" TextChanged="HexInput_TextChanged" />
                <!-- Alpha 百分比 -->
                <TextBox x:Name="AlphaInput" Grid.Column="2" Style="{DynamicResource FormTextBoxStyle}" Height="30"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" TextChanged="AlphaInput_TextChanged" />
            </Grid>

            <!-- 6. 常用色板 -->
            <StackPanel Grid.Row="5" Margin="0,0,0,16">
                <Grid Margin="2,0,0,6">
                    <TextBlock Text="常用颜色" Foreground="{DynamicResource BrushTextSec}" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <UniformGrid Columns="7" x:Name="SwatchGrid" Rows="2">
                    <!-- 通过后台动态生成或在 XAML 写死常用颜色按钮 -->
                </UniformGrid>
            </StackPanel>

            <!-- 7. 底部按钮 -->
            <Grid Grid.Row="6" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{DynamicResource GhostButtonStyle}" Height="30" Padding="14,0" Click="CancelButton_Click" Cursor="Hand" />
                    <Button Content="确定" Style="{DynamicResource GhostButtonStyle}" BorderBrush="{DynamicResource BrushAccent}" Height="30" Padding="14,0" Margin="8,0,0,0" Click="ConfirmButton_Click" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
