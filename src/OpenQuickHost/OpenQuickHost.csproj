<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Version>0.3.12</Version>
    <FileVersion>0.3.12.0</FileVersion>
    <AssemblyVersion>0.3.12.0</AssemblyVersion>
    <InformationalVersion>0.3.12</InformationalVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);1701;1603</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Yanzi</AssemblyName>
    <Product>Yanzi</Product>
    <Title>Yanzi</Title>
    <Company>Yanzi</Company>
    <Authors>Yanzi</Authors>
    <Description>Yanzi desktop launcher and extension host for Windows.</Description>
    <ApplicationIcon>yanzi.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="yanzi.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="logo-white.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="logo-black.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="白透.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="黑透.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Content Include="Assets\edit-guide.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Resource Include="Assets\Icons\*.svg" />
    <Resource Include="Assets\mdi-icons.json" />
    <Resource Include="Assets\yanzi_mascot.png" />
    <None Include="..\..\third_party\everything-sdk\Everything64.dll" Link="Everything64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\third_party\everything-runtime\package\**\*" LinkBase="EverythingRuntime">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\skills\**\*" LinkBase="skills">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\browser-extension\**\*" LinkBase="browser-extension">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\syncsettings.json" Link="syncsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\syncsettings.example.json" Link="syncsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Basic.Reference.Assemblies.Net90" Version="1.8.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="9.0.16" />
    <PackageReference Include="System.DirectoryServices" Version="9.0.16" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.16" />
    <PackageReference Include="System.IO.Ports" Version="9.0.16" />
    <PackageReference Include="System.Management" Version="9.0.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.16" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.16" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.16" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <Target Name="CopyNativeWindowReferenceAssembliesForBuild" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\copy-native-window-refs.ps1&quot; -OutputDir &quot;$(TargetDir)NativeWindowRefs&quot;" />
  </Target>

  <Target Name="CopyNativeWindowReferenceAssembliesForPublish" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\copy-native-window-refs.ps1&quot; -OutputDir &quot;$(PublishDir)NativeWindowRefs&quot;" />
  </Target>

  <Target Name="KillProcessBeforeBuild" BeforeTargets="BeforeBuild;Clean">
    <Exec Command="taskkill /f /im Yanzi.exe /t 2&gt;nul" IgnoreExitCode="true" />
  </Target>

</Project>
