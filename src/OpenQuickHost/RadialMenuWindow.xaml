<Window x:Class="OpenQuickHost.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenQuickHost"
        Title="燕环"
        Width="1400"
        Height="1400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanToColorConverter x:Key="BooleanToColorConverter" />
    </Window.Resources>

    <Grid>
        <Ellipse Width="320"
                 Height="320"
                 Fill="{DynamicResource BrushRadialOuterBG}"
                 Stroke="{DynamicResource BrushRadialBorder}"
                 StrokeThickness="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <ItemsControl ItemsSource="{Binding OuterItems}"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path Data="{Binding SectorGeometry}"
                          Fill="{Binding SectorBrush}"
                          Opacity="{Binding SectorOpacity}"
                          Visibility="{Binding IsSectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding OuterSeparators}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{DynamicResource BrushRadialBorder}" StrokeThickness="1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Ellipse Width="200"
                 Height="200"
                 Fill="Transparent"
                 Stroke="{DynamicResource BrushRadialBorder}"
                 StrokeThickness="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <ItemsControl ItemsSource="{Binding Items}"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path Data="{Binding SectorGeometry}"
                          Fill="{Binding SectorBrush}"
                          Opacity="{Binding SectorOpacity}"
                          Visibility="{Binding IsSectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Ring line around inner circle - must be after the filled ellipse -->
        <Ellipse Width="200"
                 Height="200"
                 Fill="Transparent"
                 Stroke="{DynamicResource BrushRadialBorderActive}"
                 StrokeThickness="1.5"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <ItemsControl ItemsSource="{Binding MainSeparators}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{DynamicResource BrushRadialBorderSec}" StrokeThickness="1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Ellipse Width="48"
                 Height="48"
                 Stroke="{DynamicResource BrushRadialBorderActive}"
                 StrokeThickness="1"
                 Fill="{DynamicResource BrushRadialCenterBG}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="42" Height="42">
            <TextBlock Text="{Binding CenterPrimaryText}"
                       Foreground="{DynamicResource BrushRadialText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CenterIcon}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Image Source="{Binding CenterIcon}"
                   Width="24"
                   Height="24"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <Trigger Property="Source" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Visible"/>
                    </Style>
                </Image.Style>
            </Image>
        </Grid>

        <TextBlock Text="{Binding ActiveTitle}"
                   Foreground="{DynamicResource BrushTextSec}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Width="220"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="176"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding PaginationDots}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ItemsControl.RenderTransform>
                <TranslateTransform Y="160"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Width="6" Height="6" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource BrushRadialTextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource BrushRadialText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding PageDisplaySummary}"
                   Foreground="{DynamicResource BrushRadialTextMuted}"
                   FontSize="10"
                   Width="350"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="192"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <Button x:Name="EditButton"
                Width="34"
                Height="34"
                Padding="0"
                Background="{DynamicResource BrushRadialButtonBG}"
                BorderThickness="1"
                BorderBrush="{Binding EditButtonBrush}"
                ToolTip="进入编辑模式"
                Click="EditButton_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Button.RenderTransform>
                <TranslateTransform X="140" Y="-126" />
            </Button.RenderTransform>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.88" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditHoverActive}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Background" Value="#F03B82F6" />
                            <Setter Property="BorderBrush" Value="#FF93C5FD" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Viewbox Width="16"
                     Height="16"
                     Stretch="Uniform">
                <Path Data="{local:IconGeometry pen}"
                      Fill="{Binding EditButtonBrush}" />
            </Viewbox>
        </Button>

        <Button x:Name="PinButton"
                Width="34"
                Height="34"
                Padding="0"
                Background="{DynamicResource BrushRadialButtonBG}"
                BorderThickness="1"
                BorderBrush="{Binding PinButtonBrush}"
                ToolTip="{Binding PinButtonTooltip}"
                Click="PinButton_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Button.RenderTransform>
                <TranslateTransform X="178" Y="-126" />
            </Button.RenderTransform>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.88" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinHoverActive}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Background" Value="#F0A16207" />
                            <Setter Property="BorderBrush" Value="#FFFCD34D" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Viewbox Width="16"
                     Height="16"
                     Stretch="Uniform">
                <Path Data="{local:IconGeometry pin}"
                      Fill="{Binding PinButtonBrush}" />
            </Viewbox>
        </Button>

        <Button x:Name="AddButton"
                Width="34"
                Height="34"
                Padding="0"
                Background="{DynamicResource BrushRadialButtonBG}"
                BorderThickness="1"
                BorderBrush="{Binding AddButtonBrush}"
                ToolTip="添加轮盘"
                Click="AddButton_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Button.RenderTransform>
                <TranslateTransform X="216" Y="-126" />
            </Button.RenderTransform>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.88" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddHoverActive}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Background" Value="#F010B981" />
                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Viewbox Width="16"
                     Height="16"
                     Stretch="Uniform">
                <Path Data="{local:IconGeometry plus}"
                      Fill="{Binding AddButtonBrush}" />
            </Viewbox>
        </Button>

        <Button x:Name="DeleteButton"
                Width="34"
                Height="34"
                Padding="0"
                Background="{DynamicResource BrushRadialButtonBG}"
                BorderThickness="1"
                BorderBrush="{Binding DeleteButtonBrush}"
                ToolTip="删除当前轮盘"
                Click="DeleteButton_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Button.RenderTransform>
                <TranslateTransform X="254" Y="-126" />
            </Button.RenderTransform>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.88" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeleteHoverActive}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Background" Value="#F0EF4444" />
                            <Setter Property="BorderBrush" Value="#FFFECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Viewbox Width="16"
                     Height="16"
                     Stretch="Uniform">
                <Path Data="{local:IconGeometry delete}"
                      Fill="{Binding DeleteButtonBrush}" />
            </Viewbox>
        </Button>

        <Button x:Name="SearchButton"
                Width="34"
                Height="34"
                Padding="0"
                Background="{DynamicResource BrushRadialButtonBG}"
                BorderThickness="1"
                BorderBrush="{Binding SearchButtonBrush}"
                ToolTip="查询轮盘"
                Click="SearchButton_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Button.RenderTransform>
                <TranslateTransform X="292" Y="-126" />
            </Button.RenderTransform>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.88" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearchHoverActive}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Background" Value="#F03B82F6" />
                            <Setter Property="BorderBrush" Value="#FFDBEAFE" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Viewbox Width="16"
                     Height="16"
                     Stretch="Uniform">
                <Path Data="{local:IconGeometry search}"
                      Fill="{Binding SearchButtonBrush}" />
            </Viewbox>
        </Button>

        <Button x:Name="CloseButton"
                Width="34"
                Height="34"
                Padding="0"
                Background="{DynamicResource BrushRadialButtonBG}"
                BorderThickness="1"
                BorderBrush="{Binding CloseButtonBrush}"
                ToolTip="关闭整个燕环"
                Click="CloseButton_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Button.RenderTransform>
                <TranslateTransform X="330" Y="-126" />
            </Button.RenderTransform>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.88" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCloseHoverActive}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Background" Value="#FFF87171" />
                            <Setter Property="BorderBrush" Value="#FFFECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Viewbox Width="16"
                     Height="16"
                     Stretch="Uniform">
                <Path Data="{local:IconGeometry close}"
                      Fill="{Binding CloseButtonBrush}" />
            </Viewbox>
        </Button>

        <ItemsControl ItemsSource="{Binding OuterItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="50"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            AllowDrop="True"
                            MouseLeftButtonDown="RadialSlot_MouseLeftButtonDown"
                            MouseMove="RadialSlot_MouseMove"
                            MouseRightButtonDown="RadialSlot_MouseRightButtonDown"
                            DragOver="RadialSlot_DragOver"
                            Drop="RadialSlot_Drop"
                            DragEnter="RadialSlot_DragEnter"
                            DragLeave="RadialSlot_DragLeave"
                            Cursor="Hand"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                        </Border.RenderTransform>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="➕" 
                                           Foreground="{DynamicResource BrushRadialTextMuted}" 
                                           FontSize="{DynamicResource FontSizeTitle}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShouldShowEmptyPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                
                                <!-- Show normal content for filled slots -->
                                <Grid Width="18" Height="18" HorizontalAlignment="Center" Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Width="18" Height="18" CornerRadius="4" Background="{Binding AccentBrush}">
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding IconSource}" Stretch="UniformToFill" Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Viewbox Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                            </Viewbox>
                                            <TextBlock Text="{Binding DisplayGlyph}" Foreground="White" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <!-- Running indicator (Green Dot) -->
                                    <Border Width="6"
                                            Height="6"
                                            CornerRadius="3"
                                            Background="#FF10B981"
                                            BorderBrush="#CCFFFFFF"
                                            BorderThickness="0.8"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Margin="-1.5,0,0,-1.5"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='BrushAccent|BrushRadialText'}"
                                           FontSize="8"
                                           Width="44"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="64"
                            Height="50"
                            Background="Transparent"
                            BorderThickness="0"
                            AllowDrop="True"
                            MouseLeftButtonDown="RadialSlot_MouseLeftButtonDown"
                            MouseMove="RadialSlot_MouseMove"
                            MouseRightButtonDown="RadialSlot_MouseRightButtonDown"
                            DragOver="RadialSlot_DragOver"
                            Drop="RadialSlot_Drop"
                            DragEnter="RadialSlot_DragEnter"
                            DragLeave="RadialSlot_DragLeave"
                            Cursor="Hand"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                        </Border.RenderTransform>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="➕" 
                                           Foreground="{DynamicResource BrushRadialTextMuted}" 
                                           FontSize="{DynamicResource FontSizeHeader}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShouldShowEmptyPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                
                                <!-- Show normal content for filled slots -->
                                <Grid Width="26"
                                      Height="26"
                                      HorizontalAlignment="Center"
                                      Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="{Binding AccentBrush}">
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding IconSource}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Viewbox Width="15"
                                                     Height="15"
                                                     Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                            </Viewbox>
                                            <TextBlock Text="{Binding DisplayGlyph}"
                                                       Foreground="White"
                                                       FontSize="{DynamicResource FontSizeNormal}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <!-- Running indicator (Green Dot) -->
                                    <Border Width="8"
                                            Height="8"
                                            CornerRadius="4"
                                            Background="#FF10B981"
                                            BorderBrush="#CCFFFFFF"
                                            BorderThickness="0.8"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Margin="-2,0,0,-2"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='BrushAccent|BrushRadialText'}"
                                           FontSize="{DynamicResource FontSizeTiny}"
                                           Width="50"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Canvas Visibility="{Binding HasChildRing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Ellipse Width="200"
                     Height="200"
                     Canvas.Left="{Binding ChildRingEllipseX}"
                     Canvas.Top="{Binding ChildRingEllipseY}"
                     Fill="{DynamicResource BrushRadialInnerBG}"
                     Stroke="{DynamicResource BrushRadialBorderActive}"
                     StrokeThickness="1"/>
            <ItemsControl ItemsSource="{Binding ChildItems}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Data="{Binding SectorGeometry}"
                              Fill="{Binding SectorBrush}"
                              Opacity="{Binding SectorOpacity}"
                              Visibility="{Binding IsSectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ChildSeparators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{DynamicResource BrushRadialBorderSec}" StrokeThickness="1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Ellipse Width="52"
                     Height="52"
                     Canvas.Left="{Binding ChildRingCenterEllipseX}"
                     Canvas.Top="{Binding ChildRingCenterEllipseY}"
                     Fill="{DynamicResource BrushRadialCenterBG}"
                     Stroke="{DynamicResource BrushRadialBorderActive}"
                     StrokeThickness="1"/>
            <TextBlock Text="{Binding ChildRingTitle}"
                       Canvas.Left="{Binding ChildRingTitleX}"
                       Canvas.Top="{Binding ChildRingTitleY}"
                       Width="150"
                       TextAlignment="Center"
                       Foreground="{DynamicResource BrushRadialText}"
                       FontSize="{DynamicResource FontSizeLarge}"
                       FontWeight="SemiBold"
                       Visibility="{Binding ChildCenterContentVisibility}"/>
            <ContentControl Canvas.Left="{Binding ChildRingCenterEllipseX}"
                             Canvas.Top="{Binding ChildRingCenterEllipseY}"
                             Width="52"
                             Height="52"
                             Cursor="Hand"
                             Visibility="{Binding ChildCenterPinVisibility}">
                <Path Data="{local:IconGeometry pin}"
                       Fill="{Binding ChildPinBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Width="18"
                       Height="18"
                       Stretch="Uniform"/>
            </ContentControl>
            <ItemsControl ItemsSource="{Binding ChildItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="56"
                                Height="44"
                                Background="Transparent"
                                BorderThickness="0"
                                AllowDrop="True"
                                MouseLeftButtonDown="RadialSlot_MouseLeftButtonDown"
                                MouseMove="RadialSlot_MouseMove"
                                MouseRightButtonDown="RadialSlot_MouseRightButtonDown"
                                DragOver="RadialSlot_DragOver"
                                Drop="RadialSlot_Drop"
                                DragEnter="RadialSlot_DragEnter"
                                DragLeave="RadialSlot_DragLeave"
                                Cursor="Hand"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="➕" 
                                               Foreground="{DynamicResource BrushRadialTextMuted}" 
                                               FontSize="22" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShouldShowEmptyPlaceholder}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <!-- Show normal content for filled slots -->
                                    <Grid Width="22"
                                          Height="22"
                                          HorizontalAlignment="Center"
                                          Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Width="22" Height="22" CornerRadius="5" Background="{Binding AccentBrush}">
                                            <Grid ClipToBounds="True">
                                                <Image Source="{Binding IconSource}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Viewbox Width="13"
                                                         Height="13"
                                                         Stretch="Uniform"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                </Viewbox>
                                                <TextBlock Text="{Binding DisplayGlyph}"
                                                           Foreground="White"
                                                           FontSize="{DynamicResource FontSizeSmallPlus}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <!-- Running indicator (Green Dot) -->
                                        <Border Width="6"
                                                Height="6"
                                                CornerRadius="3"
                                                Background="#FF10B981"
                                                BorderBrush="#CCFFFFFF"
                                                BorderThickness="0.8"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Margin="-1.5,0,0,-1.5"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='BrushAccent|BrushRadialText'}"
                                               FontSize="9"
                                               Width="46"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <Canvas Visibility="{Binding HasGrandChildRing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Ellipse Width="160"
                     Height="160"
                     Canvas.Left="{Binding GrandChildRingEllipseX}"
                     Canvas.Top="{Binding GrandChildRingEllipseY}"
                     Fill="{DynamicResource BrushRadialInnerBG}"
                     Stroke="{DynamicResource BrushRadialBorderActive}"
                     StrokeThickness="1"/>
            <ItemsControl ItemsSource="{Binding GrandChildItems}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Data="{Binding SectorGeometry}"
                              Fill="{Binding SectorBrush}"
                              Opacity="{Binding SectorOpacity}"
                              Visibility="{Binding IsSectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding GrandChildSeparators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{DynamicResource BrushRadialBorderSec}" StrokeThickness="1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Ellipse Width="44"
                     Height="44"
                     Canvas.Left="{Binding GrandChildRingCenterEllipseX}"
                     Canvas.Top="{Binding GrandChildRingCenterEllipseY}"
                     Fill="{DynamicResource BrushRadialCenterBG}"
                     Stroke="{DynamicResource BrushRadialBorderActive}"
                     StrokeThickness="1"/>
            <TextBlock Text="{Binding GrandChildRingTitle}"
                       Canvas.Left="{Binding GrandChildRingTitleX}"
                       Canvas.Top="{Binding GrandChildRingTitleY}"
                       Width="128"
                       TextAlignment="Center"
                       Foreground="{DynamicResource BrushRadialText}"
                       FontSize="{DynamicResource FontSizeNormalPlus}"
                       FontWeight="SemiBold"
                       Visibility="{Binding GrandChildCenterContentVisibility}"/>
            <ContentControl Canvas.Left="{Binding GrandChildRingCenterEllipseX}"
                             Canvas.Top="{Binding GrandChildRingCenterEllipseY}"
                             Width="44"
                             Height="44"
                             Cursor="Hand"
                             Visibility="{Binding GrandChildCenterPinVisibility}">
                <Path Data="{local:IconGeometry pin}"
                       Fill="{Binding GrandChildPinBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Width="16"
                       Height="16"
                       Stretch="Uniform"/>
            </ContentControl>
            <ItemsControl ItemsSource="{Binding GrandChildItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="50"
                                Height="40"
                                Background="Transparent"
                                BorderThickness="0"
                                AllowDrop="True"
                                MouseLeftButtonDown="RadialSlot_MouseLeftButtonDown"
                                MouseMove="RadialSlot_MouseMove"
                                MouseRightButtonDown="RadialSlot_MouseRightButtonDown"
                                DragOver="RadialSlot_DragOver"
                                Drop="RadialSlot_Drop"
                                DragEnter="RadialSlot_DragEnter"
                                DragLeave="RadialSlot_DragLeave"
                                Cursor="Hand"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="➕" 
                                               Foreground="#80FFFFFF" 
                                               FontSize="{DynamicResource FontSizeTitle}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShouldShowEmptyPlaceholder}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <!-- Show normal content for filled slots -->
                                    <Grid Width="18" Height="18" HorizontalAlignment="Center" Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Width="18" Height="18" CornerRadius="4" Background="{Binding AccentBrush}">
                                            <Grid ClipToBounds="True">
                                                <Image Source="{Binding IconSource}" Stretch="UniformToFill" Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Viewbox Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                </Viewbox>
                                                <TextBlock Text="{Binding DisplayGlyph}" Foreground="White" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <!-- Running indicator (Green Dot) -->
                                        <Border Width="6"
                                                Height="6"
                                                CornerRadius="3"
                                                Background="#FF10B981"
                                                BorderBrush="#CCFFFFFF"
                                                BorderThickness="0.8"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Margin="-1.5,0,0,-1.5"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='BrushAccent|BrushRadialText'}"
                                               FontSize="8"
                                               Width="44"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Grid>
</Window>
