<Window x:Class="OpenQuickHost.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenQuickHost"
        Title="燕环"
        Width="1400"
        Height="1400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanToColorConverter x:Key="BooleanToColorConverter" />
    </Window.Resources>

    <Grid>
        <Ellipse Width="392"
                 Height="392"
                 Fill="#AA101010"
                 Stroke="#22FFFFFF"
                 StrokeThickness="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <ItemsControl ItemsSource="{Binding OuterItems}"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path Data="{Binding SectorGeometry}"
                          Fill="{Binding SectorBrush}"
                          Opacity="{Binding SectorOpacity}"
                          Visibility="{Binding IsSectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding OuterSeparators}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#22FFFFFF" StrokeThickness="1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Ellipse Width="244"
                 Height="244"
                 Fill="#CC101010"
                 Stroke="#22FFFFFF"
                 StrokeThickness="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <ItemsControl ItemsSource="{Binding Items}"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path Data="{Binding SectorGeometry}"
                          Fill="{Binding SectorBrush}"
                          Opacity="{Binding SectorOpacity}"
                          Visibility="{Binding IsSectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Ring line around inner circle - must be after the filled ellipse -->
        <Ellipse Width="244"
                 Height="244"
                 Fill="Transparent"
                 Stroke="#33FFFFFF"
                 StrokeThickness="1.5"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <ItemsControl ItemsSource="{Binding MainSeparators}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#2DFFFFFF" StrokeThickness="1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Ellipse Width="58"
                 Height="58"
                 Fill="#F2161616"
                 Stroke="#33FFFFFF"
                 StrokeThickness="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding CenterPrimaryText}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="{Binding ActiveTitle}"
                   Foreground="#FF8E8E8E"
                   FontSize="11"
                   Width="220"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="176"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <Button x:Name="PinButton"
                Width="34"
                Height="34"
                Padding="0"
                Background="#E6101010"
                BorderThickness="1"
                BorderBrush="{Binding PinButtonBrush}"
                ToolTip="{Binding PinButtonTooltip}"
                Click="PinButton_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Button.RenderTransform>
                <TranslateTransform X="214" Y="-154" />
            </Button.RenderTransform>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.88" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinHoverActive}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Background" Value="#F0A16207" />
                            <Setter Property="BorderBrush" Value="#FFFCD34D" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Viewbox Width="16"
                     Height="16"
                     Stretch="Uniform">
                <Path Data="{local:IconGeometry pin}"
                      Fill="{Binding PinButtonBrush}" />
            </Viewbox>
        </Button>

        <ItemsControl ItemsSource="{Binding OuterItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="62"
                            Height="50"
                            Background="Transparent"
                            BorderThickness="0"
                            AllowDrop="True"
                            MouseLeftButtonDown="RadialSlot_MouseLeftButtonDown"
                            MouseMove="RadialSlot_MouseMove"
                            MouseRightButtonDown="RadialSlot_MouseRightButtonDown"
                            DragOver="RadialSlot_DragOver"
                            Drop="RadialSlot_Drop"
                            MouseEnter="RadialSlot_MouseEnter"
                            MouseLeave="RadialSlot_MouseLeave"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                        </Border.RenderTransform>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="➕" 
                                           Foreground="#80FFFFFF" 
                                           FontSize="20" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShouldShowEmptyPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                
                                <!-- Show normal content for filled slots -->
                                <Grid Width="23" Height="23" HorizontalAlignment="Center" ClipToBounds="True" Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Image Source="{Binding IconSource}" Stretch="UniformToFill" Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding DisplayGlyph}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF60A5FA|#FFFFFFFF'}"
                                           FontSize="9"
                                           Width="50"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="76"
                            Height="60"
                            Background="Transparent"
                            BorderThickness="0"
                            AllowDrop="True"
                            MouseLeftButtonDown="RadialSlot_MouseLeftButtonDown"
                            MouseMove="RadialSlot_MouseMove"
                            MouseRightButtonDown="RadialSlot_MouseRightButtonDown"
                            DragOver="RadialSlot_DragOver"
                            Drop="RadialSlot_Drop"
                            MouseEnter="RadialSlot_MouseEnter"
                            MouseLeave="RadialSlot_MouseLeave"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                        </Border.RenderTransform>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="➕" 
                                           Foreground="#80FFFFFF" 
                                           FontSize="24" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShouldShowEmptyPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                
                                <!-- Show normal content for filled slots -->
                                <Grid Width="32"
                                      Height="32"
                                      HorizontalAlignment="Center"
                                      ClipToBounds="True"
                                      Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Image Source="{Binding IconSource}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Viewbox Width="19"
                                             Height="19"
                                             Stretch="Uniform"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding DisplayGlyph}"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF60A5FA|#FFFFFFFF'}"
                                           FontSize="10"
                                           Width="60"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Canvas Visibility="{Binding HasChildRing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Ellipse Width="240"
                     Height="240"
                     Canvas.Left="{Binding ChildRingEllipseX}"
                     Canvas.Top="{Binding ChildRingEllipseY}"
                     Fill="#BB101010"
                     Stroke="#33FFFFFF"
                     StrokeThickness="1"/>
            <ItemsControl ItemsSource="{Binding ChildItems}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Data="{Binding SectorGeometry}"
                              Fill="{Binding SectorBrush}"
                              Opacity="{Binding SectorOpacity}"
                              Visibility="{Binding IsSectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ChildSeparators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#2DFFFFFF" StrokeThickness="1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Ellipse Width="64"
                     Height="64"
                     Canvas.Left="{Binding ChildRingCenterEllipseX}"
                     Canvas.Top="{Binding ChildRingCenterEllipseY}"
                     Fill="#F2161616"
                     Stroke="#33FFFFFF"
                     StrokeThickness="1"/>
            <TextBlock Text="{Binding ChildRingTitle}"
                       Canvas.Left="{Binding ChildRingTitleX}"
                       Canvas.Top="{Binding ChildRingTitleY}"
                       Width="150"
                       TextAlignment="Center"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding ChildItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="68"
                                Height="54"
                                Background="Transparent"
                                BorderThickness="0"
                                AllowDrop="True"
                                MouseLeftButtonDown="RadialSlot_MouseLeftButtonDown"
                                MouseMove="RadialSlot_MouseMove"
                                MouseRightButtonDown="RadialSlot_MouseRightButtonDown"
                                DragOver="RadialSlot_DragOver"
                                Drop="RadialSlot_Drop"
                                MouseEnter="RadialSlot_MouseEnter"
                                MouseLeave="RadialSlot_MouseLeave"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="➕" 
                                               Foreground="#80FFFFFF" 
                                               FontSize="22" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShouldShowEmptyPlaceholder}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <!-- Show normal content for filled slots -->
                                    <Grid Width="26"
                                          Height="26"
                                          HorizontalAlignment="Center"
                                          ClipToBounds="True"
                                          Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Image Source="{Binding IconSource}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Viewbox Width="16"
                                                 Height="16"
                                                 Stretch="Uniform"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding DisplayGlyph}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF60A5FA|#FFFFFFFF'}"
                                               FontSize="9"
                                               Width="54"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <Canvas Visibility="{Binding HasGrandChildRing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Ellipse Width="196"
                     Height="196"
                     Canvas.Left="{Binding GrandChildRingEllipseX}"
                     Canvas.Top="{Binding GrandChildRingEllipseY}"
                     Fill="#B3101010"
                     Stroke="#33FFFFFF"
                     StrokeThickness="1"/>
            <ItemsControl ItemsSource="{Binding GrandChildItems}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Data="{Binding SectorGeometry}"
                              Fill="{Binding SectorBrush}"
                              Opacity="{Binding SectorOpacity}"
                              Visibility="{Binding IsSectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding GrandChildSeparators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#2DFFFFFF" StrokeThickness="1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Ellipse Width="54"
                     Height="54"
                     Canvas.Left="{Binding GrandChildRingCenterEllipseX}"
                     Canvas.Top="{Binding GrandChildRingCenterEllipseY}"
                     Fill="#F2161616"
                     Stroke="#33FFFFFF"
                     StrokeThickness="1"/>
            <TextBlock Text="{Binding GrandChildRingTitle}"
                       Canvas.Left="{Binding GrandChildRingTitleX}"
                       Canvas.Top="{Binding GrandChildRingTitleY}"
                       Width="128"
                       TextAlignment="Center"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding GrandChildItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="62"
                                Height="50"
                                Background="Transparent"
                                BorderThickness="0"
                                AllowDrop="True"
                                MouseLeftButtonDown="RadialSlot_MouseLeftButtonDown"
                                MouseMove="RadialSlot_MouseMove"
                                MouseRightButtonDown="RadialSlot_MouseRightButtonDown"
                                DragOver="RadialSlot_DragOver"
                                Drop="RadialSlot_Drop"
                                MouseEnter="RadialSlot_MouseEnter"
                                MouseLeave="RadialSlot_MouseLeave"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="➕" 
                                               Foreground="#80FFFFFF" 
                                               FontSize="20" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShouldShowEmptyPlaceholder}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <!-- Show normal content for filled slots -->
                                    <Grid Width="23" Height="23" HorizontalAlignment="Center" ClipToBounds="True" Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Image Source="{Binding IconSource}" Stretch="UniformToFill" Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding DisplayGlyph}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF60A5FA|#FFFFFFFF'}"
                                               FontSize="9"
                                               Width="50"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding IsNotEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Grid>
</Window>
