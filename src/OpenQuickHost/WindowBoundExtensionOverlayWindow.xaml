<Window x:Class="OpenQuickHost.WindowBoundExtensionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口绑定扩展"
        Width="68"
        Height="68"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Button x:Name="ActionButton"
            Width="68"
            Height="68"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Padding="0"
            Cursor="Hand"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            ToolTip="{Binding Title}"
            PreviewMouseLeftButtonDown="ActionButton_PreviewMouseLeftButtonDown"
            PreviewMouseMove="ActionButton_PreviewMouseMove"
            PreviewMouseLeftButtonUp="ActionButton_PreviewMouseLeftButtonUp"
            PreviewMouseRightButtonUp="ActionButton_PreviewMouseRightButtonUp"
            Click="ActionButton_Click">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter />
            </ControlTemplate>
        </Button.Template>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="IconBorder"
                    Width="34"
                    Height="34"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.32" />
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding AccentBrush}" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.12" ScaleY="1.12"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasImageIcon}" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding IconSource}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Viewbox Margin="6"
                             Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Path Width="24"
                              Height="24"
                              Data="{Binding VectorIcon}"
                              Fill="White"
                              Stretch="Uniform" />
                    </Viewbox>
                    <TextBlock Text="{Binding DisplayGlyph}"
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding Title}"
                       Foreground="White"
                       FontSize="9"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="64"
                       Margin="0,3,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.7" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Button>
</Window>
