<Window x:Class="OpenQuickHost.YanmComponentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑燕幕组件"
        Width="820"
        Height="680"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="编辑燕幕组件" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="填写组件名称和 HTML 内容。后续这里会接入 AI 生成、脚本数据和定时刷新。"
                       Foreground="#FF9CA3AF"
                       FontSize="{DynamicResource FontSizeNormal}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="组件名称" Foreground="White" FontWeight="SemiBold"/>
            <TextBox x:Name="NameBox"
                     Margin="0,8,0,0"
                     Height="38"
                     Padding="12,8"
                     Background="#FF1F1F1F"
                     Foreground="White"
                     BorderBrush="#FF333333"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="HTML 内容" Foreground="White" FontWeight="SemiBold"/>
            <TextBox x:Name="HtmlBox"
                     Grid.Row="1"
                     Margin="0,8,0,0"
                     Padding="12"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="{DynamicResource FontSizeNormal}"
                     Background="#FF141414"
                     Foreground="#FFF8FAFC"
                     BorderBrush="#FF333333"/>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock x:Name="ErrorText"
                       Foreground="#FFFF6B6B"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="复制提示词" Width="112" Height="36" Margin="0,0,10,0" Style="{StaticResource SecondaryBtn}" Click="CopyPromptButton_Click"/>
                <Button Content="取消" Width="92" Height="36" Margin="0,0,10,0" Style="{StaticResource SecondaryBtn}" Click="CancelButton_Click"/>
                <Button Content="保存" Width="104" Height="36" Style="{StaticResource PrimaryBtn}" Click="SaveButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
