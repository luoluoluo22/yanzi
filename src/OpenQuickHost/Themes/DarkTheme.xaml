<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Premium Dark Theme Colors -->
    <Color x:Key="ColorBG">#FF161616</Color>
    <Color x:Key="ColorBorder">#FF2A2A2A</Color>
    <Color x:Key="ColorAccent">#FF3B82F6</Color>
    <Color x:Key="ColorTextMain">#FFFFFFFF</Color>
    <Color x:Key="ColorTextSec">#FF8E8E8E</Color>
    <Color x:Key="ColorInputBG">#FF1E1E1E</Color>

    <SolidColorBrush x:Key="BrushBG" Color="{StaticResource ColorBG}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushTextMain" Color="{StaticResource ColorTextMain}"/>
    <SolidColorBrush x:Key="BrushTextSec" Color="{StaticResource ColorTextSec}"/>
    <SolidColorBrush x:Key="BrushInputBG" Color="{StaticResource ColorInputBG}"/>

    <!-- Premium Button Theme Resources -->
    <SolidColorBrush x:Key="BrushAccentText" Color="White"/>
    <SolidColorBrush x:Key="BrushSecondaryBtnBG" Color="#FF252525"/>
    <SolidColorBrush x:Key="BrushSecondaryBtnBorder" Color="#FF333333"/>
    <SolidColorBrush x:Key="BrushSecondaryBtnText" Color="#FFAAAAAA"/>
    
    <!-- Other Helper Theme Colors -->
    <SolidColorBrush x:Key="BrushListViewItemMouseOver" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BrushListViewItemHeaderBG" Color="#FF252525"/>
    <SolidColorBrush x:Key="BrushListViewItemSelectedBG" Color="#1F3B82F6"/>
    <SolidColorBrush x:Key="BrushListViewItemSelectedBorder" Color="#403B82F6"/>

    <!-- ContextMenu & Dialog Resources -->
    <SolidColorBrush x:Key="BrushDialogBG" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="BrushContextMenuBG" Color="#F21A1A1A"/>
    <SolidColorBrush x:Key="BrushContextMenuBorder" Color="#25FFFFFF"/>
    <SolidColorBrush x:Key="BrushSeparator" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="BrushMenuItemHighlightBG" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="BrushMenuItemGestureText" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="BrushMenuItemDisabledText" Color="#40FFFFFF"/>
</ResourceDictionary>
