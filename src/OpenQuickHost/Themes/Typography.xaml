<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography System -->
    <!-- Tiny text (Tooltips, sub-labels) -->
    <sys:Double x:Key="FontSizeTiny">10</sys:Double>
    
    <!-- Small text (Secondary details, input hints) -->
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeSmallPlus">12</sys:Double>
    
    <!-- Normal text (Standard body, buttons, list items) -->
    <sys:Double x:Key="FontSizeNormal">13</sys:Double>
    <sys:Double x:Key="FontSizeNormalPlus">14</sys:Double>
    
    <!-- Large text (Sub-headers, important buttons) -->
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLargePlus">16</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">18</sys:Double>
    
    <!-- Header text (Page headers, titles) -->
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeHeader">24</sys:Double>
    <sys:Double x:Key="FontSizeHero">32</sys:Double>
</ResourceDictionary>
