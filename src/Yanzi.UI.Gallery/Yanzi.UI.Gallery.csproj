    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\OpenQuickHost\yanzi.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
