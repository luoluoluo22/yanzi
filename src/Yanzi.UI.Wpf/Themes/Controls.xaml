<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Buttons: common focus, disabled, hover and pressed semantics. -->
    <Style x:Key="Yanzi.Button.Base" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="66"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{DynamicResource Yanzi.Font.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Yanzi.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.66"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Yanzi.Brush.Accent}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Yanzi.Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.OnAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="Yanzi.Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Base}"/>
    <Style x:Key="Yanzi.Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Danger}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.OnAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- TextBox preserves PART_ContentHost, IME, selection, keyboard and scrolling. -->
    <Style x:Key="Yanzi.Input" TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{DynamicResource Yanzi.Font.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Yanzi.Brush.Accent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Yanzi.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Yanzi.Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Yanzi.CheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="FontSize" Value="{DynamicResource Yanzi.Font.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style x:Key="Yanzi.Toggle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="FontSize" Value="{DynamicResource Yanzi.Font.Body}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="36" Height="20"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="10" Background="{DynamicResource Yanzi.Brush.Border}"/>
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Yanzi.Brush.Accent}"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="18,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Yanzi.Brush.Accent}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Yanzi.Menu" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Yanzi.MenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Surface}"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <Style x:Key="Yanzi.List" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ItemContainerStyle" Value="{DynamicResource Yanzi.ListItem}"/>
    </Style>
    <Style x:Key="Yanzi.ListItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemChrome" Background="Transparent"
                            CornerRadius="{DynamicResource Yanzi.Radius.Control}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Yanzi.Brush.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Yanzi.Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Yanzi.Loading" TargetType="{x:Type ProgressBar}">
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Border}"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="Yanzi.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Yanzi.Radius.Card}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Yanzi.Text.Secondary" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.TextSecondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Yanzi.Font.Small}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
