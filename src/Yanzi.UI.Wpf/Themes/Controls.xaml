<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Yanzi.UI.Wpf">

    <!-- Shadcn-aligned buttons: independent semantic variants, shared focus ring. -->
    <Style x:Key="Yanzi.Button.Base" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="58"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{DynamicResource Yanzi.Font.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Color.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource Yanzi.Color.Ring}" BorderThickness="2"
                                CornerRadius="{DynamicResource Yanzi.Radius.Lg}" Opacity="0"/>
                        <Border x:Name="Chrome" Margin="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Yanzi.Radius.Md}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Yanzi.Button.Default" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.PrimaryForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Yanzi.Color.PrimaryHover}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Yanzi.Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Secondary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.SecondaryForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Yanzi.Color.Accent}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Yanzi.Button.Destructive" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Destructive}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.DestructiveForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Yanzi.Color.DestructiveHover}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Yanzi.Button.Outline" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Color.Input}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Yanzi.Color.Accent}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Yanzi.Button.Ghost" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Transparent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.Foreground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Yanzi.Color.Accent}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Yanzi.Button.Link" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 0.1.0 compatibility aliases -->
    <Style x:Key="Yanzi.Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Default}"/>
    <Style x:Key="Yanzi.Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Yanzi.Button.Destructive}"/>

    <!-- WPF native edit semantics and shadcn input/ring styling. -->
    <Style x:Key="Yanzi.Input" TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{DynamicResource Yanzi.Font.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Color.Input}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Yanzi.Color.Foreground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Yanzi.Color.Ring}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource Yanzi.Color.Ring}" BorderThickness="2"
                            CornerRadius="{DynamicResource Yanzi.Radius.Lg}" Opacity="0"/>
                        <Border x:Name="Chrome"
                                Margin="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Yanzi.Radius.Md}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Focusable="False"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.65"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Yanzi.CheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="FontSize" Value="{DynamicResource Yanzi.Font.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style x:Key="Yanzi.Toggle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="FontSize" Value="{DynamicResource Yanzi.Font.Body}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="36" Height="20"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="10" Background="{DynamicResource Yanzi.Brush.Border}"/>
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Yanzi.Brush.Accent}"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="18,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Yanzi.Brush.Accent}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Yanzi.Menu" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Yanzi.MenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Surface}"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <Style x:Key="Yanzi.List" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ItemContainerStyle" Value="{DynamicResource Yanzi.ListItem}"/>
    </Style>
    <Style x:Key="Yanzi.ListItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Text}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemChrome" Background="Transparent"
                            CornerRadius="{DynamicResource Yanzi.Radius.Control}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Yanzi.Brush.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Yanzi.Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Yanzi.Loading" TargetType="{x:Type ProgressBar}">
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Border}"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="Yanzi.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Yanzi.Radius.Card}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Yanzi.Text.Secondary" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Brush.TextSecondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Yanzi.Font.Small}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Badge: six variants, optional leading/trailing glyphs and true spinner. -->
    <Style x:Key="Yanzi.Badge" TargetType="{x:Type ui:YanziBadge}">
        <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Color.Transparent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:YanziBadge}">
                    <Border x:Name="BadgeChrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="999"
                        MinHeight="22"
                        Padding="9,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:YanziLoadingRing x:Name="Spinner" Width="12" Height="12"
                                Foreground="{TemplateBinding Foreground}"
                                Margin="0,0,5,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="Leading" Text="{TemplateBinding LeadingIcon}"
                                Margin="0,0,5,0" VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                            <TextBlock x:Name="Trailing" Text="{TemplateBinding TrailingIcon}"
                                Margin="5,0,0,0" VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="LeadingIcon" Value="">
                            <Setter TargetName="Leading" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="TrailingIcon" Value="">
                            <Setter TargetName="Trailing" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Leading" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Secondary">
                <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Secondary}"/>
                <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.SecondaryForeground}"/>
            </Trigger>
            <Trigger Property="Variant" Value="Destructive">
                <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Destructive}"/>
                <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.DestructiveForeground}"/>
            </Trigger>
            <Trigger Property="Variant" Value="Outline">
                <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Transparent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.Foreground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Yanzi.Color.Border}"/>
            </Trigger>
            <Trigger Property="Variant" Value="Ghost">
                <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Transparent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.Foreground}"/>
            </Trigger>
            <Trigger Property="Variant" Value="Link">
                <Setter Property="Background" Value="{DynamicResource Yanzi.Color.Transparent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Yanzi.Color.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
