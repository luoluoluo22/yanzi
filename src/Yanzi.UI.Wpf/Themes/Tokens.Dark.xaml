<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Semantic colors. Do not put feature-specific colors here. -->
    <SolidColorBrush x:Key="Yanzi.Brush.Window" Color="#FF161616"/>
    <SolidColorBrush x:Key="Yanzi.Brush.Surface" Color="#FF202020"/>
    <SolidColorBrush x:Key="Yanzi.Brush.SurfaceHover" Color="#FF303030"/>
    <SolidColorBrush x:Key="Yanzi.Brush.Input" Color="#FF252525"/>
    <SolidColorBrush x:Key="Yanzi.Brush.Border" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="Yanzi.Brush.Text" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="Yanzi.Brush.TextSecondary" Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="Yanzi.Brush.TextMuted" Color="#FF898989"/>
    <SolidColorBrush x:Key="Yanzi.Brush.Accent" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="Yanzi.Brush.AccentHover" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="Yanzi.Brush.OnAccent" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Yanzi.Brush.Danger" Color="#FFDC4545"/>
    <SolidColorBrush x:Key="Yanzi.Brush.DangerHover" Color="#FFB91C1C"/>
    <SolidColorBrush x:Key="Yanzi.Brush.Success" Color="#FF27AE70"/>
    <SolidColorBrush x:Key="Yanzi.Brush.Warning" Color="#FFF2B84B"/>
    <sys:Double x:Key="Yanzi.Space.1">4</sys:Double>
    <sys:Double x:Key="Yanzi.Space.2">8</sys:Double>
    <sys:Double x:Key="Yanzi.Space.3">12</sys:Double>
    <sys:Double x:Key="Yanzi.Space.4">16</sys:Double>
    <sys:Double x:Key="Yanzi.Space.6">24</sys:Double>
    <sys:Double x:Key="Yanzi.Font.Small">12</sys:Double>
    <sys:Double x:Key="Yanzi.Font.Body">13</sys:Double>
    <sys:Double x:Key="Yanzi.Font.Title">18</sys:Double>
    <CornerRadius x:Key="Yanzi.Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Yanzi.Radius.Card">12</CornerRadius>
</ResourceDictionary>
