{
  "name": "yanzi-sync",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-04-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openquickhost-sync-db",
      "database_id": "512f99ac-4f5f-4e30-affb-58fc4da94bfa"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PACKAGES",
      "bucket_name": "openquickhost-sync-assets"
    }
  ],
  "routes": [
    {
      "pattern": "sync.luoluoluo.cc.cd",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "9101101",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "EXPORT_RATE_LIMITER",
      "namespace_id": "9101102",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_RELAY",
        "class_name": "DeviceRelay"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "CLOUD_VIP_ONLY": "true"
  }
}
