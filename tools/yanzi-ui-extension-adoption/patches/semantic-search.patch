 using System.Windows.Media.Imaging;
 using System.Windows.Threading;
 using OpenQuickHost.CSharpRuntime;
+using System.Reflection;
+
+internal static class YanziNativeUiBridge
+{
+    public static bool Ready { get; private set; }
+    public static bool TryApply(Window window)
+    {
+        try
+        {
+            var path = Path.Combine(
+                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+                "OpenQuickHost", "SharedUI", "Yanzi.UI.Wpf.dll");
+            var assembly = AppDomain.CurrentDomain.GetAssemblies()
+                .FirstOrDefault(a => a.GetName().Name == "Yanzi.UI.Wpf")
+                ?? Assembly.LoadFrom(path);
+            var ui = assembly.GetType("Yanzi.UI.Wpf.YanziUi", true)!;
+            var theme = assembly.GetType("Yanzi.UI.Wpf.YanziTheme", true)!;
+            ui.GetMethod("ApplyTo", BindingFlags.Public | BindingFlags.Static)!
+                .Invoke(null, new object[] { window, Enum.Parse(theme, "Dark") });
+            Ready = true;
+            return true;
+        }
+        catch (Exception) { Ready = false; return false; }
+    }
+    public static void Style(FrameworkElement control, string key)
+    {
+        if (Ready)
+            control.SetResourceReference(FrameworkElement.StyleProperty, key);
+    }
+}
 
