# Workspace boundary
RACCOON_ROOT=.

# Allow all file paths (including .env and runtime files) with the OS user's permissions.
# RACCOON_ROOT remains the base for relative paths. Default is restricted.
RACCOON_FILESYSTEM_UNRESTRICTED=0

# stdio (default) or http
RACCOON_TRANSPORT=stdio

# HTTP defaults to loopback only
RACCOON_HOST=127.0.0.1
RACCOON_PORT=3766

# Optional on loopback; required by Raccoon when binding HTTP to a non-loopback host
RACCOON_TOKEN=

# Opt in to arbitrary shell execution, project workflows, and persistent processes
RACCOON_ENABLE_SHELL=0

# Optional shell / Android tool overrides
RACCOON_SHELL=
RACCOON_ADB=adb

# Optional automatic resource governor for shell/build/cache work.
# Disabled by default to preserve maximum throughput; when enabled, new heavy
# operations wait while CPU/memory/concurrency are above these thresholds.
RACCOON_GOVERNOR_ENABLED=0
RACCOON_GOVERNOR_MAX_HEAVY_OPS=8
RACCOON_GOVERNOR_MAX_CPU_PERCENT=95
RACCOON_GOVERNOR_MIN_FREE_MEMORY_BYTES=536870912
RACCOON_GOVERNOR_POLL_MS=500

# Capacity budgets. Defaults are deliberately high enough for development;
# very large files should use fs_read_chunk/fs_write_chunk so memory stays bounded.
# Supported hard ceilings are enforced in src/config.js.
RACCOON_DEFAULT_READ_BYTES=67108864
RACCOON_MAX_READ_BYTES=536870912
RACCOON_MAX_MESSAGE_BYTES=536870912
RACCOON_DEFAULT_PROCESS_LOG_BYTES=268435456
RACCOON_MAX_PROCESS_LOG_BYTES=2147483648
RACCOON_MAX_SHELL_OUTPUT_BYTES=536870912
RACCOON_MAX_BUILD_OUTPUT_BYTES=536870912
RACCOON_MAX_GIT_PATCH_BYTES=536870912
RACCOON_MAX_PROCESS_READ_BYTES=536870912

# Batch / concurrency / session capacity. The max values are ceilings;
# normal calls still default to bounded concurrency.
RACCOON_MAX_BATCH_FILES=10000
RACCOON_BATCH_CONCURRENCY=32
RACCOON_MAX_BATCH_CONCURRENCY=256
RACCOON_MAX_DIRECTORY_ENTRIES=1000000
RACCOON_MAX_TREE_DEPTH=1000
RACCOON_MAX_PATCH_FILES=5000
RACCOON_MAX_REPLACEMENTS_PER_FILE=10000
RACCOON_MAX_WORKFLOW_STEPS=10000
RACCOON_MAX_SEARCH_CONTEXT_LINES=10000
RACCOON_MAX_PROCESS_SESSIONS=4096
RACCOON_PROCESS_EVENT_CHUNK_BYTES=262144
RACCOON_MAX_SEARCH_RESULTS=1000000
RACCOON_MAX_RECENT_TOOL_CALLS=10000

# 0 disables the HTTP request execution timeout; headers still have a bounded timeout.
RACCOON_HTTP_REQUEST_TIMEOUT_MS=0
RACCOON_HTTP_HEADERS_TIMEOUT_MS=60000

# Reject mutating tools even when shell execution is enabled
RACCOON_READ_ONLY=0

# Optional comma-separated hostname/origin allowlists for a reverse proxy
RACCOON_ALLOWED_HOSTS=
RACCOON_ALLOWED_ORIGINS=

# Optional JSONL audit metadata file; parent directory must exist
RACCOON_AUDIT_LOG=

# Optional HTTPS origin for a public Cloudflare Tunnel; enables OAuth for that host
RACCOON_PUBLIC_URL=
# Generate a random 32+ character connection password; keep it out of Git
RACCOON_OAUTH_PASSWORD=
RACCOON_OAUTH_STATE_FILE=.raccoon-runtime/oauth-state.json

# Persistent background development DAGs (requires shell enabled to execute)
RACCOON_PIPELINE_DIR=.raccoon-runtime/pipelines
RACCOON_PIPELINE_MAX_RUNNING_NODES=8
