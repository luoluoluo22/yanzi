-        // 0.1 褰诲簳鍓ョ <style>...</style> 鍜?<script>...</script> 鏍囩鍙婂叾涓棿鍖呭惈鐨勬墍鏈夋牱寮忓拰鑴氭湰鍐呭
-        text = text.replaceAll("(?is)<style[^>]*>.*?</style>", "");
-        text = text.replaceAll("(?is)<script[^>]*>.*?</script>", "");
-
-        // 1. 灏?<br> 鏇挎崲涓烘崲琛?-        text = text.replaceAll("(?i)<br\\s*/?>", "\n");
-        // 2. 灏嗘钀藉強鍧楃骇鍏冪礌闂悎鎴栧紑澶存浛鎹负鎹㈣
-        text = text.replaceAll("(?i)</?(p|div|li|h[1-6]|tr)[^>]*>", "\n");
-        // 3. 鍓ョ鎵€鏈?HTML 鏍囩
-        text = text.replaceAll("<[^>]*>", "");
-        // 4. 鏇挎崲甯歌鐨?HTML 瀹炰綋
-        text = text.replaceAll("&nbsp;", " ")
-                   .replaceAll("&amp;", "&")
-                   .replaceAll("&quot;", "\"")
-                   .replaceAll("&#39;", "'");
-        text = text.replaceAll("(?m)^[ \t]*\r?\n", "");
