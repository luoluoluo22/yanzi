<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cc.luoluoluo.yanzi.mobile">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:resizeable="true"
        android:smallScreens="true"
        android:xlargeScreens="true" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/yanzi_launcher_bitmap"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:roundIcon="@drawable/yanzi_launcher_bitmap"
        android:supportsRtl="true"
        android:theme="@style/Theme.YanziMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".FloatingWheelService"
            android:exported="false" />
        <service
            android:name=".MobileAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mobile_accessibility_service" />
        </service>

        <!-- Extensions Widget Provider -->
        <receiver android:name=".widget.ExtensionsWidgetProvider"
            android:label="燕子快捷扩展 (2x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="cc.luoluoluo.yanzi.mobile.widget.ACTION_RUN_EXT" />
                <action android:name="cc.luoluoluo.yanzi.mobile.widget.ACTION_REFRESH_EXT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_extensions_info" />
        </receiver>

        <!-- Yanm Widget Provider -->
        <receiver android:name=".widget.YanmWidgetProvider"
            android:label="燕幕组件列表 (2x4)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="cc.luoluoluo.yanzi.mobile.widget.ACTION_REFRESH_YANM" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_yanm_info" />
        </receiver>

        <!-- Yanm Widget Service -->
        <service android:name=".widget.YanmWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>
</manifest>
