<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#16181C"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_yanm_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="燕幕组件列表"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_yanm_refresh"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#00000000"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="刷新" />
    </RelativeLayout>

    <!-- List Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Empty Text -->
        <TextView
            android:id="@+id/widget_yanm_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="暂无燕幕数据，请开启App拉取"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Container for 3 static items -->
        <LinearLayout
            android:id="@+id/widget_yanm_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Item 1 -->
            <LinearLayout
                android:id="@+id/widget_yanm_item_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="#00000000"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/widget_item_accent_line_1"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:background="#22D3EE"
                    android:contentDescription="装饰条" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/widget_item_title_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_item_type_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textColor="#5EEAD4"
                            android:textSize="9sp" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/widget_item_summary_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider 1 -->
            <ImageView
                android:id="@+id/widget_yanm_divider_1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2D2D2D"
                android:layout_marginBottom="4dp"
                android:contentDescription="分割线" />

            <!-- Item 2 -->
            <LinearLayout
                android:id="@+id/widget_yanm_item_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="#00000000"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/widget_item_accent_line_2"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:background="#22D3EE"
                    android:contentDescription="装饰条" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/widget_item_title_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_item_type_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textColor="#5EEAD4"
                            android:textSize="9sp" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/widget_item_summary_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider 2 -->
            <ImageView
                android:id="@+id/widget_yanm_divider_2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2D2D2D"
                android:layout_marginBottom="4dp"
                android:contentDescription="分割线" />

            <!-- Item 3 -->
            <LinearLayout
                android:id="@+id/widget_yanm_item_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="#00000000">

                <ImageView
                    android:id="@+id/widget_item_accent_line_3"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:background="#22D3EE"
                    android:contentDescription="装饰条" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/widget_item_title_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_item_type_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textColor="#5EEAD4"
                            android:textSize="9sp" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/widget_item_summary_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
