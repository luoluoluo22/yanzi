<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/yanm_component_edit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="编辑燕幕组件"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/yanm_component_edit_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="key: note"
        android:textColor="#67E8F9"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/yanm_component_edit_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:hint="输入便签内容"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="8"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:textSize="16sp" />

    <Button
        android:id="@+id/yanm_component_edit_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="保存并同步" />
</LinearLayout>
