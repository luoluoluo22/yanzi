<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IdleTaskSource Condition="'$(IdleTaskSource)' == ''">$(LOCALAPPDATA)\OpenQuickHost\Extensions\idle-chatgpt-tasks\IdleTaskApp.cs</IdleTaskSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs"/>
    <Compile Include="TestRuntimeContext.cs"/>
    <Compile Include="$(IdleTaskSource)" Link="IdleTaskApp.cs"/>
    <ProjectReference Include="..\..\src\OpenQuickHost\OpenQuickHost.csproj"/>
  </ItemGroup>
</Project>
